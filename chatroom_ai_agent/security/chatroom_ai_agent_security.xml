<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_chatroom_ai_agent" model="ir.module.category">
        <field name="name">Chatroom Agente IA</field>
        <field name="sequence">25</field>
    </record>
    <record id="privilege_chatroom_ai_agent" model="res.groups.privilege">
        <field name="name">Agente operativo IA</field>
        <field name="category_id" ref="module_category_chatroom_ai_agent"/>
    </record>
    <record id="group_chatroom_ai_agent_user" model="res.groups">
        <field name="name">Usuario del agente IA</field>
        <field name="privilege_id" ref="privilege_chatroom_ai_agent"/>
    </record>
    <record id="group_chatroom_ai_agent_manager" model="res.groups">
        <field name="name">Administrador del agente IA</field>
        <field name="privilege_id" ref="privilege_chatroom_ai_agent"/>
        <field name="implied_ids" eval="[(4, ref('group_chatroom_ai_agent_user'))]"/>
    </record>
    <!-- Los administradores técnicos deben poder usar el panel sin configuración manual. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_chatroom_ai_agent_manager'))]"/>
    </record>
    <record id="chatroom_ai_task_rule_user" model="ir.rule">
        <field name="name">Tareas IA del responsable</field>
        <field name="model_id" ref="model_chatroom_ai_task"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('channel_id.assigned_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_agent_user'))]"/>
    </record>
    <record id="chatroom_ai_task_rule_manager" model="ir.rule">
        <field name="name">Administrador: todas las tareas IA</field>
        <field name="model_id" ref="model_chatroom_ai_task"/>
        <field name="domain_force">[('id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_agent_manager'))]"/>
    </record>
    <record id="chatroom_ai_memory_rule_user" model="ir.rule">
        <field name="name">Memoria IA del agente</field>
        <field name="model_id" ref="model_chatroom_ai_memory"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('channel_id.assigned_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_agent_user'))]"/>
    </record>
    <record id="chatroom_ai_memory_rule_manager" model="ir.rule">
        <field name="name">Administrador: memoria IA</field>
        <field name="model_id" ref="model_chatroom_ai_memory"/>
        <field name="domain_force">[('id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_agent_manager'))]"/>
    </record>
</odoo>
