<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.chatroom.ai.agent</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Agente IA" string="Agente IA" name="chatroom_ai_agent">
                    <setting id="chatroom_ai_agent_open_control_setting"
                             help="Abre directamente el tablero de tareas, aprobaciones y fallos del agente.">
                        <button name="action_open_ai_agent_control" type="object" string="Abrir centro de control IA" class="btn-primary"/>
                    </setting>
                    <block title="Operación autónoma">
                        <setting id="chatroom_ai_agent_enabled_setting"
                                 help="Activa los ciclos automáticos definidos en el menú Agente IA &gt; Automatizaciones.">
                            <field name="chatroom_ai_agent_enabled"/>
                        </setting>
                        <setting id="chatroom_ai_agent_event_orchestration_setting"
                                 help="Prepara una tarea IA con cada mensaje entrante. La ejecución permanece sujeta a aprobación y auditoría.">
                            <field name="chatroom_ai_agent_event_orchestration"/>
                        </setting>
                        <setting id="chatroom_ai_agent_commercial_router_setting"
                                 help="Detecta si el cliente pide productos, cotización, reunión, pago o una consulta y prepara el flujo correspondiente.">
                            <field name="chatroom_ai_agent_commercial_router_enabled"/>
                        </setting>
                        <setting id="chatroom_ai_agent_ai_planning_setting"
                                 help="Desactivado usa planes locales y ahorra tokens. Actívalo solo si necesitas que el proveedor externo proponga planes nuevos.">
                            <field name="chatroom_ai_agent_ai_planning_enabled"/>
                        </setting>
                        <setting id="chatroom_ai_agent_approval_setting"
                                 help="Recomendado: la IA puede preparar planes, pero un usuario autoriza cambios, cobros y envíos.">
                            <field name="chatroom_ai_agent_require_approval"/>
                        </setting>
                        <setting id="chatroom_ai_agent_mode_setting"
                                 help="Supervisado mantiene control humano; automático ejecuta solo acciones autorizadas; simulación no modifica datos.">
                            <field name="chatroom_ai_agent_mode"/>
                        </setting>
                        <setting id="chatroom_ai_agent_max_tasks_setting"
                                 help="Límite de protección por cada ciclo del cron.">
                            <field name="chatroom_ai_agent_max_tasks"/>
                        </setting>
                        <setting id="chatroom_ai_agent_max_actions_setting">
                            <field name="chatroom_ai_agent_max_actions"/>
                        </setting>
                        <setting id="chatroom_ai_agent_max_payment_amount_setting"
                                 help="Protege cobros de alto valor. Usa 0 si todos deben requerir aprobación según las reglas normales.">
                            <field name="chatroom_ai_agent_max_payment_amount"/>
                        </setting>
                    </block>
                    <block title="Cotizaciones y reuniones desde conversaciones">
                        <setting id="chatroom_ai_agent_quote_product_setting"
                                 help="Producto fijo de Ventas que se añadirá cuando el agente prepare una cotización nativa.">
                            <field name="chatroom_ai_agent_quote_product_id"/>
                        </setting>
                        <setting id="chatroom_ai_agent_quote_quantity_setting"
                                 help="Cantidad inicial del producto en la cotización. El documento queda sujeto a aprobación humana.">
                            <field name="chatroom_ai_agent_quote_quantity"/>
                        </setting>
                    </block>
                    <block title="Respuestas automaticas seguras">
                        <setting id="chatroom_ai_safety_profile_setting"
                                 help="Elige un perfil y Odoo rellenará los límites recomendados; después puedes personalizar cada valor.">
                            <field name="chatroom_ai_safety_profile"/>
                        </setting>
                        <setting id="chatroom_ai_safe_auto_reply_setting"
                                 help="Conecta las respuestas automáticas con una guardia de consentimiento, horario, frecuencia y escalamiento.">
                            <field name="chatroom_ai_safe_auto_reply"/>
                        </setting>
                        <setting id="chatroom_ai_auto_reply_min_confidence_setting"
                                 help="La IA debe devolver una confianza igual o superior a este valor para responder sin intervención humana.">
                            <field name="chatroom_ai_auto_reply_min_confidence"/>
                        </setting>
                        <setting id="chatroom_ai_auto_reply_cooldown_setting"
                                 help="Tiempo mínimo entre respuestas generadas automáticamente en una misma conversación.">
                            <field name="chatroom_ai_auto_reply_cooldown_minutes"/>
                        </setting>
                        <setting id="chatroom_ai_auto_reply_daily_limit_setting"
                                 help="Límite diario por conversación para evitar bucles o consumo inesperado.">
                            <field name="chatroom_ai_auto_reply_daily_limit"/>
                        </setting>
                        <setting id="chatroom_ai_auto_reply_escalate_negative_setting"
                                 help="Las quejas, sentimientos negativos y urgencias quedan visibles para un agente.">
                            <field name="chatroom_ai_auto_reply_escalate_negative"/>
                        </setting>
                        <setting id="chatroom_ai_auto_reply_hours_setting"
                                 help="Si se desactiva, la IA respeta el horario configurado en Chatroom WhatsApp.">
                            <field name="chatroom_ai_auto_reply_allow_outside_hours"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
