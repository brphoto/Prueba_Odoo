<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.chatroom.ai.agent</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Agente IA" string="Agente IA" name="chatroom_ai_agent">
                    <setting id="chatroom_ai_agent_open_control_setting"
                             help="Abre directamente el tablero de tareas, aprobaciones y fallos del agente.">
                        <button name="action_open_ai_agent_control" type="object" string="Abrir centro de control IA" class="btn-primary"/>
                    </setting>
                    <block title="Operación autónoma">
                        <setting id="chatroom_ai_agent_enabled_setting"
                                 help="Activa los ciclos automáticos definidos en el menú Agente IA &gt; Automatizaciones.">
                            <field name="chatroom_ai_agent_enabled"/>
                        </setting>
                        <setting id="chatroom_ai_agent_event_orchestration_setting"
                                 help="Prepara una tarea IA con cada mensaje entrante. La ejecución permanece sujeta a aprobación y auditoría.">
                            <field name="chatroom_ai_agent_event_orchestration"/>
                        </setting>
                        <setting id="chatroom_ai_agent_approval_setting"
                                 help="Recomendado: la IA puede preparar planes, pero un usuario autoriza cambios, cobros y envíos.">
                            <field name="chatroom_ai_agent_require_approval"/>
                        </setting>
                        <setting id="chatroom_ai_agent_mode_setting"
                                 help="Supervisado mantiene control humano; automatico ejecuta solo acciones autorizadas; simulacion no modifica datos.">
                            <field name="chatroom_ai_agent_mode"/>
                        </setting>
                        <setting id="chatroom_ai_agent_max_tasks_setting"
                                 help="Límite de protección por cada ciclo del cron.">
                            <field name="chatroom_ai_agent_max_tasks"/>
                        </setting>
                        <setting id="chatroom_ai_agent_max_actions_setting">
                            <field name="chatroom_ai_agent_max_actions"/>
                        </setting>
                        <setting id="chatroom_ai_agent_max_payment_amount_setting"
                                 help="Protege cobros de alto valor. Usa 0 si todos deben requerir aprobación según las reglas normales.">
                            <field name="chatroom_ai_agent_max_payment_amount"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
