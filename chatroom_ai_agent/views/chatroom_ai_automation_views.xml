<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_ai_automation_list" model="ir.ui.view">
        <field name="name">chatroom.ai.automation.list</field>
        <field name="model">chatroom.ai.automation</field>
        <field name="arch" type="xml">
            <list string="Automatizaciones IA" decoration-muted="not active">
                <field name="sequence" string="Orden" widget="handle"/>
                <field name="name" string="Automatización"/>
                <field name="trigger" string="Activador"/>
                <field name="task_type" string="Tipo de tarea"/>
                <field name="task_count" string="Tareas generadas"/>
                <field name="description" string="Descripción" optional="hide"/>
                <field name="approval_required" string="Requiere aprobación"/>
                <field name="max_attempts" string="Intentos máximos"/>
                <field name="last_run" string="Última ejecución"/>
                <field name="last_run_count" string="Creadas última ejecución"/>
                <field name="last_error" string="Incidencias" optional="hide"/>
                <field name="active" string="Activa" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_chatroom_ai_automation_form" model="ir.ui.view">
        <field name="name">chatroom.ai.automation.form</field>
        <field name="model">chatroom.ai.automation</field>
        <field name="arch" type="xml">
            <form string="Automatización IA" class="o_chatroom_ai_automation_form">
                <header>
                    <button name="action_preview_scope" type="object" string="Previsualizar alcance" icon="fa-eye"/>
                    <button name="action_run_now" type="object" string="Ejecutar ahora" class="btn-primary"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="o_chatroom_ai_automation_intro">
                        <div class="o_chatroom_ai_automation_intro_icon"><i class="fa fa-magic" title="Automatización IA" aria-hidden="true"/></div>
                        <div>
                            <h1><field name="name" placeholder="Nombre de la automatización"/></h1>
                            <p>Define cuándo debe actuar el agente y qué nivel de aprobación necesita.</p>
                        </div>
                    </div>
                    <div name="button_box" class="oe_button_box o_chatroom_ai_automation_button_box">
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tareas generadas"/>
                        </button>
                    </div>
                    <notebook class="o_chatroom_ai_automation_notebook">
                        <page name="configuration" string="Configuración">
                            <group class="o_chatroom_ai_automation_grid">
                                <group string="Objetivo">
                                    <field name="trigger"/>
                                    <field name="task_type"/>
                                </group>
                                <group string="Seguridad y alcance">
                                    <field name="approval_required"/>
                                    <field name="max_tasks"/>
                                    <field name="max_attempts"/>
                                    <field name="sequence"/>
                                    <field name="company_id"/>
                                </group>
                            </group>
                            <div class="o_chatroom_ai_automation_textarea o_chatroom_ai_automation_full_block">
                                <label for="instruction" string="Instrucción para la IA"/>
                                <field name="instruction" class="o_chatroom_ai_automation_instruction" nolabel="1" widget="text"
                                       placeholder="Escribe aquí el contexto o la instrucción para la IA..."/>
                            </div>
                            <div class="o_chatroom_ai_automation_hint">
                                Las acciones sensibles conservarán su propia aprobación aunque esta automatización sea automática.
                            </div>
                            <div class="o_chatroom_ai_automation_textarea o_chatroom_ai_automation_full_block">
                                <label for="description" string="Cómo usarla"/>
                                <field name="description" nolabel="1" widget="text" placeholder="Explica en lenguaje sencillo cuándo usar esta automatización..."/>
                            </div>
                        </page>
                        <page name="filters" string="Filtros">
                            <div class="alert alert-info" role="status">
                                Las automatizaciones de ejemplo llegan desactivadas para evitar envíos inesperados. Puedes pulsar «Ejecutar ahora» para probarlas manualmente; las acciones sensibles seguirán solicitando aprobación.
                            </div>
                            <group string="Filtros opcionales" class="o_chatroom_ai_automation_filters">
                                <field name="only_unread"/>
                                <field name="only_unassigned"/>
                                <field name="min_rfm_score"/>
                            </group>
                        </page>
                        <page name="results" string="Resultados">
                            <div class="o_chatroom_ai_automation_result o_chatroom_ai_automation_result_summary">
                                <div class="o_chatroom_ai_automation_result_header">
                                    <div>
                                        <h3>Última ejecución</h3>
                                        <p>Consulta aquí el alcance, las tareas creadas y cualquier incidencia.</p>
                                    </div>
                                    <button name="action_view_tasks" type="object" string="Ver tareas generadas" icon="fa-external-link" class="btn-primary"/>
                                </div>
                                <group class="o_chatroom_ai_automation_result_grid">
                                    <field name="last_run" readonly="1"/>
                                    <field name="last_run_count" readonly="1"/>
                                    <field name="last_scanned_count" readonly="1"/>
                                    <field name="last_skipped_count" readonly="1"/>
                                </group>
                                <div class="o_chatroom_ai_automation_run_summary">
                                    <label for="last_run_summary" string="Resumen"/>
                                    <field name="last_run_summary" readonly="1" nolabel="1"/>
                                </div>
                                <div class="o_chatroom_ai_automation_run_error">
                                    <label for="last_error" string="Incidencias"/>
                                    <field name="last_error" readonly="1" nolabel="1" placeholder="Sin errores registrados."/>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_chatroom_ai_automation" model="ir.actions.act_window">
        <field name="name">Automatizaciones IA</field>
        <field name="res_model">chatroom.ai.automation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
