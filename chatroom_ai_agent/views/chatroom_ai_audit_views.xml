<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_ai_audit_list" model="ir.ui.view">
        <field name="name">chatroom.ai.audit.list</field><field name="model">chatroom.ai.audit</field>
        <field name="arch" type="xml"><list string="Auditoría IA"><field name="create_date"/><field name="name"/><field name="state" widget="badge"/><field name="task_id"/><field name="action_id"/><field name="user_id"/><field name="message"/></list></field>
    </record>
    <record id="view_chatroom_ai_audit_form" model="ir.ui.view">
        <field name="name">chatroom.ai.audit.form</field><field name="model">chatroom.ai.audit</field>
        <field name="arch" type="xml"><form string="Auditoría IA" create="false" edit="false"><sheet><group><field name="create_date"/><field name="name"/><field name="state"/><field name="task_id"/><field name="action_id"/><field name="tool_id"/><field name="user_id"/></group><field name="message"/><notebook><page string="Entrada"><field name="input_json" nolabel="1" widget="text"/></page><page string="Salida"><field name="output_json" nolabel="1" widget="text"/></page></notebook></sheet></form></field>
    </record>
    <record id="action_chatroom_ai_audit" model="ir.actions.act_window"><field name="name">Auditoría IA</field><field name="res_model">chatroom.ai.audit</field><field name="view_mode">list,form</field></record>
</odoo>
