<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_ai_task_list" model="ir.ui.view">
        <field name="name">chatroom.ai.task.list</field>
        <field name="model">chatroom.ai.task</field>
        <field name="arch" type="xml">
            <list string="Tareas IA" decoration-danger="state == 'failed'" decoration-success="state == 'done'">
                <header>
                    <button name="action_run_selected" type="object" string="Ejecutar seleccionadas" class="btn-primary"/>
                    <button name="action_retry_selected" type="object" string="Reintentar fallidas" class="btn-secondary"/>
                </header>
                <field name="priority" widget="priority"/>
                <field name="create_date"/>
                <field name="name"/>
                <field name="task_type"/>
                <field name="partner_id"/>
                <field name="channel_id" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="risk_level" widget="badge"/>
                <field name="approval_required"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_chatroom_ai_task_form" model="ir.ui.view">
        <field name="name">chatroom.ai.task.form</field>
        <field name="model">chatroom.ai.task</field>
        <field name="arch" type="xml">
            <form string="Tarea IA">
                <header>
                    <button name="action_plan" type="object" string="Generar plan" class="btn-secondary" invisible="state not in ('draft', 'failed')"/>
                    <button name="action_approve" type="object" string="Aprobar plan" class="btn-primary" invisible="state != 'awaiting_approval'"/>
                    <button name="action_run" type="object" string="Ejecutar" class="btn-primary" invisible="state not in ('planned', 'failed')"/>
                    <button name="action_retry" type="object" string="Reintentar" class="btn-secondary" invisible="state != 'failed'"/>
                    <button name="action_cancel" type="object" string="Cancelar" class="btn-secondary" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,awaiting_approval,planned,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="task_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="approval_required"/>
                            <field name="risk_level" widget="badge" readonly="1"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="channel_id"/>
                            <field name="partner_id"/>
                            <field name="automation_id"/>
                            <field name="playbook_id"/>
                            <field name="company_id"/>
                            <field name="next_run_at"/>
                        </group>
                    </group>
                    <group string="Estado operativo" class="o_chatroom_ai_task_status">
                        <field name="attempts" readonly="1"/>
                        <field name="max_attempts"/>
                        <field name="operational_status" readonly="1"/>
                        <field name="action_progress" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="status" invisible="state != 'done'">
                        <strong>La tarea terminó.</strong>
                        Las respuestas preparadas quedan como borrador para revisión; no se envían a WhatsApp automáticamente.
                        Para enviar, revisa el texto en «Resultado para el agente» y usa la acción de envío desde la conversación.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'awaiting_approval'">
                        <strong>Falta aprobación humana.</strong>
                        Aprueba el plan para permitir acciones protegidas como crear oportunidades, cotizaciones, actividades o enviar mensajes.
                    </div>
                    <group string="Solicitud">
                        <field name="prompt" nolabel="1" placeholder="Ejemplo: analiza la conversación, identifica lo que solicita el cliente y prepara una respuesta profesional con los datos reales de Odoo. No envíes nada."/>
                    </group>
                    <notebook>
                        <page string="Plan y ejecución">
                            <field name="action_ids" context="{'default_task_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="key"/>
                                    <field name="name"/>
                                    <field name="requires_approval"/>
                                    <field name="risk_level" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                    <field name="error_message" optional="hide"/>
                                </list>
                            </field>
                            <group string="Resultado visible para el usuario" class="o_chatroom_ai_task_result">
                                <field name="result_preview" readonly="1" placeholder="Aquí aparecerá qué hizo el agente y qué dejó preparado."/>
                                <field name="result_summary" readonly="1"/>
                                <field name="error_message" readonly="1"/>
                            </group>
                        </page>
                        <page string="Contexto técnico">
                            <field name="input_context" nolabel="1" readonly="1" widget="text"/>
                            <field name="plan_json" nolabel="1" readonly="1" widget="text"/>
                            <field name="output_json" nolabel="1" readonly="1" widget="text"/>
                        </page>
                        <page string="Auditoría">
                            <field name="audit_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                    <field name="user_id"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_chatroom_ai_task_search" model="ir.ui.view">
        <field name="name">chatroom.ai.task.search</field>
        <field name="model">chatroom.ai.task</field>
        <field name="arch" type="xml">
            <search string="Tareas IA">
                <field name="name"/><field name="partner_id"/><field name="channel_id"/><field name="user_id"/>
                <filter name="pending" string="Pendientes" domain="[('state', 'in', ('awaiting_approval', 'planned', 'running'))]"/>
                <filter name="awaiting_approval" string="Esperando aprobación" domain="[('state', '=', 'awaiting_approval')]"/>
                <filter name="failed" string="Fallidas" domain="[('state', '=', 'failed')]"/>
                <filter name="high_risk" string="Alto riesgo" domain="[('risk_level', '=', 'high')]"/>
                <filter name="done" string="Completadas" domain="[('state', '=', 'done')]"/>
                <group><filter name="group_state" string="Estado" context="{'group_by': 'state'}"/><filter name="group_type" string="Tipo" context="{'group_by': 'task_type'}"/></group>
            </search>
        </field>
    </record>
    <record id="view_chatroom_ai_task_kanban" model="ir.ui.view">
        <field name="name">chatroom.ai.task.kanban</field>
        <field name="model">chatroom.ai.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/><field name="task_type"/><field name="partner_id"/>
                <field name="state"/><field name="priority"/><field name="approval_required"/><field name="result_summary"/>
                <field name="error_message"/>
                <field name="risk_level"/>
                <templates><t t-name="card">
                    <div class="oe_kanban_global_click o_kanban_record">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong class="text-truncate" t-esc="record.name.value"/>
                            <span t-if="record.priority.raw_value == '2'" class="badge text-bg-danger">Urgente</span>
                        </div>
                        <div class="text-muted small mt-1" t-esc="record.task_type.value"/>
                        <div t-if="record.partner_id.value" class="mt-2"><i class="fa fa-user me-1" title="Contacto"/><span t-esc="record.partner_id.value"/></div>
                        <div t-if="record.approval_required.raw_value" class="small mt-2 text-warning"><i class="fa fa-shield me-1"/>Requiere aprobación</div>
                        <div t-if="record.result_summary.value" class="small text-muted mt-2 text-truncate" t-esc="record.result_summary.value"/>
                        <div t-if="record.error_message.value" class="small text-danger mt-2 text-truncate" t-esc="record.error_message.value"/>
                        <div class="mt-2 d-flex gap-1">
                            <button t-if="record.state.raw_value == 'awaiting_approval'" type="object" name="action_approve" class="btn btn-sm btn-primary">Aprobar</button>
                            <button t-if="record.state.raw_value == 'planned'" type="object" name="action_run" class="btn btn-sm btn-primary">Ejecutar</button>
                            <button t-if="record.state.raw_value == 'failed'" type="object" name="action_retry" class="btn btn-sm btn-secondary">Reintentar</button>
                        </div>
                    </div>
                </t></templates>
            </kanban>
        </field>
    </record>
    <record id="view_chatroom_ai_task_pivot" model="ir.ui.view">
        <field name="name">chatroom.ai.task.pivot</field><field name="model">chatroom.ai.task</field>
        <field name="arch" type="xml"><pivot string="Rendimiento del agente IA"><field name="task_type" type="row"/><field name="state" type="col"/><field name="id" type="measure"/></pivot></field>
    </record>
    <record id="view_chatroom_ai_task_graph" model="ir.ui.view">
        <field name="name">chatroom.ai.task.graph</field><field name="model">chatroom.ai.task</field>
        <field name="arch" type="xml"><graph string="Ejecuciones del agente IA" type="bar"><field name="task_type" type="row"/><field name="state" type="col"/><field name="id" type="measure"/></graph></field>
    </record>
    <record id="action_chatroom_ai_task" model="ir.actions.act_window">
        <field name="name">Tareas del agente IA</field><field name="res_model">chatroom.ai.task</field>
        <field name="view_mode">list,form</field><field name="search_view_id" ref="view_chatroom_ai_task_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
    <record id="action_chatroom_ai_control" model="ir.actions.act_window">
        <field name="name">Centro de control IA</field><field name="res_model">chatroom.ai.task</field>
        <field name="view_mode">kanban,list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_chatroom_ai_task_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
    <record id="action_chatroom_ai_approvals" model="ir.actions.act_window">
        <field name="name">Aprobaciones pendientes</field>
        <field name="res_model">chatroom.ai.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_chatroom_ai_task_search"/>
        <field name="context">{'search_default_awaiting_approval': 1}</field>
    </record>
    <record id="action_chatroom_ai_failed" model="ir.actions.act_window">
        <field name="name">Tareas fallidas</field>
        <field name="res_model">chatroom.ai.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_chatroom_ai_task_search"/>
        <field name="context">{'search_default_failed': 1}</field>
    </record>
</odoo>
