<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_ai_automation_run_list" model="ir.ui.view">
        <field name="name">chatroom.ai.automation.run.list</field>
        <field name="model">chatroom.ai.automation.run</field>
        <field name="arch" type="xml">
            <list string="Historial de ejecuciones" decoration-danger="state == 'failed'">
                <field name="execution_date" string="Ejecutada el"/>
                <field name="automation_id" string="Automatización"/>
                <field name="execution_type" string="Origen" widget="badge"/>
                <field name="state" string="Estado" widget="badge"/>
                <field name="channels_scanned" string="Canales revisados"/>
                <field name="tasks_created" string="Tareas creadas"/>
                <field name="channels_skipped" string="Omitidos"/>
                <field name="tasks_reused" string="Ya existentes"/>
                <field name="channels_failed" string="Con incidencia"/>
                <field name="summary" string="Resumen"/>
            </list>
        </field>
    </record>
    <record id="view_chatroom_ai_automation_run_form" model="ir.ui.view">
        <field name="name">chatroom.ai.automation.run.form</field>
        <field name="model">chatroom.ai.automation.run</field>
        <field name="arch" type="xml">
            <form string="Ejecución de automatización">
                <header>
                    <button name="action_view_tasks" type="object" string="Ver tareas generadas" icon="fa-tasks" class="btn-primary" invisible="not task_ids"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="summary" readonly="1"/></h1>
                    </div>
                    <group col="2">
                        <group string="Ejecución">
                            <field name="automation_id" readonly="1"/>
                            <field name="execution_date" readonly="1"/>
                            <field name="execution_type" widget="badge" readonly="1"/>
                            <field name="state" widget="badge" readonly="1"/>
                        </group>
                        <group string="Resultado">
                            <field name="channels_scanned" readonly="1"/>
                            <field name="tasks_created" readonly="1"/>
                            <field name="channels_skipped" readonly="1"/>
                            <field name="tasks_reused" readonly="1"/>
                            <field name="channels_failed" readonly="1"/>
                            <field name="task_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Detalle de omitidos" invisible="not skip_details"/>
                    <field name="skip_details" nolabel="1" readonly="1" widget="text" invisible="not skip_details"/>
                    <separator string="Incidencias" invisible="not error_details"/>
                    <field name="error_details" nolabel="1" readonly="1" widget="text" invisible="not error_details"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_chatroom_ai_automation_run" model="ir.actions.act_window">
        <field name="name">Historial de ejecuciones</field>
        <field name="res_model">chatroom.ai.automation.run</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_chatroom_ai_automation_run_form_visual" model="ir.ui.view">
        <field name="name">chatroom.ai.automation.run.form.visual</field>
        <field name="model">chatroom.ai.automation.run</field>
        <field name="inherit_id" ref="view_chatroom_ai_automation_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_chatroom_ai_automation_run_form" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
