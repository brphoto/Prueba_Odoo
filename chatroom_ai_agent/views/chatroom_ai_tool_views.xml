<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_ai_tool_list" model="ir.ui.view">
        <field name="name">chatroom.ai.tool.list</field><field name="model">chatroom.ai.tool</field>
        <field name="arch" type="xml"><list string="Herramientas IA"><field name="sequence" widget="handle"/><field name="name"/><field name="key"/><field name="model_name"/><field name="operation"/><field name="requires_approval"/><field name="active"/></list></field>
    </record>
    <record id="view_chatroom_ai_tool_form" model="ir.ui.view">
        <field name="name">chatroom.ai.tool.form</field><field name="model">chatroom.ai.tool</field>
        <field name="arch" type="xml"><form string="Herramienta IA" class="o_chatroom_ai_tool_form"><sheet>
            <div class="oe_title"><h1><field name="name" placeholder="Ej.: Crear actividad de seguimiento"/></h1></div>
            <group class="o_chatroom_ai_record_overview" col="2"><group string="Identificación"><field name="key"/><field name="sequence"/><field name="active"/></group><group string="Permiso técnico"><field name="model_name"/><field name="operation"/><field name="requires_approval"/><field name="group_id"/></group></group>
            <group string="Descripción y límites" class="o_chatroom_long_text"><field name="description" nolabel="1" widget="text" placeholder="Explica qué puede hacer la herramienta y qué validaciones debe respetar."/></group>
        </sheet><chatter/></form></field>
    </record>
    <record id="action_chatroom_ai_tool" model="ir.actions.act_window"><field name="name">Herramientas autorizadas</field><field name="res_model">chatroom.ai.tool</field><field name="view_mode">list,form</field></record>
</odoo>
