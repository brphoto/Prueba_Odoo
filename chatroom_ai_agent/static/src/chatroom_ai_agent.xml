<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="chatroom_whatsapp.ContactPanel" t-inherit-mode="extension">
        <!-- Usamos un ancla del template base: las clases t-attf no siempre
             existen todavía cuando Owl aplica las herencias de assets. -->
        <xpath expr="//div[hasclass('o_chatroom_contact_actions_block')]" position="before">
            <div t-attf-class="o_chatroom_contact_docs o_chatroom_ai_agent {{ aiAgent.open ? 'o_chatroom_ai_agent_open' : '' }}">
                <div class="o_chatroom_contact_section_header" role="button" tabindex="0"
                     t-att-aria-expanded="aiAgent.open ? 'true' : 'false'"
                     t-on-click.stop="toggleAiAgent"
                     t-on-keydown="onAiAgentHeaderKeydown">
                    <h6 class="mb-0"><i class="fa fa-cogs"/> Agente IA
                        <span class="o_chatroom_ai_agent_status" t-if="aiAgent.task">
                            · <t t-esc="aiAgent.task.state_label"/>
                        </span>
                    </h6>
                    <i t-attf-class="fa {{ aiAgent.open ? 'fa-chevron-down' : 'fa-chevron-right' }}"/>
                </div>
                    <div class="o_chatroom_ai_agent_body" t-if="aiAgent.open">
                    <div class="alert alert-warning py-2 px-2 mb-2" t-if="aiAgent.canUse === false">
                        Tu usuario no tiene el grupo de acceso al Agente IA. Solicita al administrador que active “Usuario del agente IA”.
                    </div>
                    <t t-if="aiAgent.canUse !== false">
                    <p class="mb-2">Crea un plan de trabajo con contexto comercial, acciones autorizadas y trazabilidad.</p>
                    <div class="o_chatroom_ai_agent_metrics mb-2">
                        <span><strong t-esc="aiAgent.metrics.pending_count"/> pendientes</span>
                        <span><strong t-esc="aiAgent.metrics.approval_count"/> por aprobar</span>
                        <span t-if="aiAgent.metrics.high_risk_count"><strong t-esc="aiAgent.metrics.high_risk_count"/> alto riesgo</span>
                    </div>
                    <div class="alert alert-info py-1 px-2 mb-2">Modo: <strong t-esc="aiAgent.metrics.mode"/>. Las acciones sensibles conservan aprobacion.</div>
                    <div class="alert alert-danger py-2 px-2 mb-2" t-if="aiAgent.error">
                        <t t-esc="aiAgent.error"/>
                    </div>
                    <div class="o_chatroom_ai_agent_task" t-if="aiAgent.task">
                        <strong t-esc="aiAgent.task.name"/>
                        <span><t t-esc="aiAgent.task.action_count"/> acción(es) · <t t-esc="aiAgent.task.state_label"/></span>
                        <small t-if="aiAgent.task.result_summary" t-esc="aiAgent.task.result_summary"/>
                        <div t-if="aiAgent.task.result_preview" class="o_chatroom_ai_agent_result mt-2">
                            <strong><i class="fa fa-check-circle me-1"/> Resultado</strong>
                            <div class="mt-1" t-esc="aiAgent.task.result_preview"/>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary w-100"
                            t-att-disabled="aiAgent.busy"
                            t-on-click="createAiAgentTask">
                        <i t-if="aiAgent.busy" class="fa fa-spinner fa-spin"/>
                        <i t-else="" class="fa fa-magic"/> Crear plan operativo
                    </button>
                    </t>
                </div>
            </div>
        </xpath>
    </t>
</templates>
