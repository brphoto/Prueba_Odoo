<odoo>
    <record id="view_co_payroll_adjustment_list" model="ir.ui.view"><field name="name">l10n.co.payroll.adjustment.list</field><field name="model">l10n.co.payroll.adjustment</field><field name="arch" type="xml"><list string="Ajustes de nómina" decoration-warning="state == 'draft'" decoration-success="state in ('approved', 'applied')" decoration-danger="state == 'rejected'"><field name="name"/><field name="employee_id"/><field name="period_id"/><field name="adjustment_type"/><field name="date"/><field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="installment_number"/><field name="installments"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_co_payroll_adjustment_form" model="ir.ui.view"><field name="name">l10n.co.payroll.adjustment.form</field><field name="model">l10n.co.payroll.adjustment</field><field name="arch" type="xml"><form string="Ajuste de nómina"><header><button name="action_approve" type="object" string="Aprobar" class="oe_highlight" invisible="state != 'draft'" groups="l10n_co_payroll.group_co_payroll_manager"/><button name="action_reject" type="object" string="Rechazar" invisible="state != 'draft'" groups="l10n_co_payroll.group_co_payroll_manager"/><button name="action_apply" type="object" string="Aplicar" invisible="state != 'approved'" groups="l10n_co_payroll.group_co_payroll_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,approved,applied,rejected"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="company_id"/><field name="employee_id"/><field name="period_id"/><field name="adjustment_type"/><field name="date"/></group><group><field name="currency_id" invisible="1"/><field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="installment_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="installment_number"/><field name="installments"/></group></group><field name="notes" placeholder="Soporte, orden o referencia..."/><group string="Auditoría"><field name="approved_by"/><field name="approved_at"/><field name="applied_at"/></group></sheet><chatter/></form></field></record>
    <record id="action_co_payroll_adjustment" model="ir.actions.act_window"><field name="name">Ajustes de nómina</field><field name="res_model">l10n.co.payroll.adjustment</field><field name="view_mode">list,form</field></record>
</odoo>
