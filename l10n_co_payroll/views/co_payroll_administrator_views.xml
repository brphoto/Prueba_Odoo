<odoo>
    <record id="view_co_payroll_administrator_list" model="ir.ui.view">
        <field name="name">l10n.co.payroll.administrator.list</field>
        <field name="model">l10n.co.payroll.administrator</field>
        <field name="arch" type="xml">
            <list string="Administradoras PILA">
                <field name="name"/>
                <field name="kind"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_co_payroll_administrator_form" model="ir.ui.view">
        <field name="name">l10n.co.payroll.administrator.form</field>
        <field name="model">l10n.co.payroll.administrator</field>
        <field name="arch" type="xml">
            <form string="Administradora PILA">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Ej. EPS Sura"/></h1></div>
                    <group>
                        <group><field name="company_id"/><field name="kind"/><field name="code"/></group>
                        <group><field name="partner_id"/><field name="active" widget="boolean_toggle"/></group>
                    </group>
                    <group string="Contabilidad opcional">
                        <field name="debit_account_id"/>
                        <field name="credit_account_id"/>
                    </group>
                    <field name="notes" placeholder="Observaciones o soporte..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_co_payroll_administrator_search" model="ir.ui.view">
        <field name="name">l10n.co.payroll.administrator.search</field>
        <field name="model">l10n.co.payroll.administrator</field>
        <field name="arch" type="xml">
            <search string="Buscar administradoras">
                <field name="name"/><field name="code"/><field name="kind"/>
                <filter name="active" string="Activas" domain="[('active', '=', True)]"/>
                <group><filter name="group_kind" string="Tipo" context="{'group_by': 'kind'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_co_payroll_administrator" model="ir.actions.act_window">
        <field name="name">Administradoras PILA</field>
        <field name="res_model">l10n.co.payroll.administrator</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_co_payroll_administrator_search"/>
    </record>
</odoo>
