<odoo>
    <record id="view_co_payroll_parameter_list" model="ir.ui.view">
        <field name="name">l10n.co.payroll.parameter.list</field><field name="model">l10n.co.payroll.parameter</field>
        <field name="arch" type="xml"><list string="Parámetros anuales"><field name="name"/><field name="company_id"/><field name="year"/><field name="minimum_wage" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="transport_allowance" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="uvt_value" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="approval_mode" widget="badge"/><field name="active"/></list></field>
    </record>
    <record id="view_co_payroll_parameter_form" model="ir.ui.view">
        <field name="name">l10n.co.payroll.parameter.form</field><field name="model">l10n.co.payroll.parameter</field>
        <field name="arch" type="xml"><form string="Parámetros legales"><header><button name="action_activate" type="object" string="Activar versión" class="oe_highlight" invisible="status == 'active'" groups="l10n_co_payroll.group_co_payroll_manager"/><button name="action_archive" type="object" string="Archivar" invisible="status == 'archived'" groups="l10n_co_payroll.group_co_payroll_manager"/><field name="status" widget="statusbar" statusbar_visible="draft,active,archived"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><div class="alert alert-info" role="alert">Mantén una versión por vigencia. El periodo selecciona automáticamente la versión activa que cubra sus fechas.</div><group><group><field name="company_id"/><field name="year"/><field name="version"/><field name="effective_from"/><field name="effective_to"/><field name="active"/><field name="source_reference"/></group><group><field name="currency_id" invisible="1"/><field name="minimum_wage" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="transport_allowance" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="uvt_value" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="reviewed_by"/><field name="reviewed_at"/></group></group><group string="Base legal"><field name="legal_basis" placeholder="Norma, resolución, circular y enlace de referencia..."/></group><group string="Aprobación y controles"><field name="approval_mode"/><field name="block_on_warnings"/><field name="require_novelty_approval"/><field name="legal_validation_required"/></group><group string="Seguridad social e IBC"><field name="health_employee_rate"/><field name="health_employer_rate"/><field name="pension_employee_rate"/><field name="pension_employer_rate"/><field name="minimum_ibc"/><field name="minimum_ibc_multiple"/><field name="maximum_ibc_multiple"/><field name="integral_salary_min_multiple"/><field name="integral_ibc_ratio"/><field name="transport_allowance_max_wage_multiple"/></group><group string="Solidaridad y parafiscales"><field name="solidarity_threshold_mw"/><field name="solidarity_rate_1"/><field name="solidarity_rate_2"/><field name="solidarity_rate_3"/><field name="solidarity_rate_4"/><field name="solidarity_rate_5"/><field name="solidarity_rate_6"/><field name="arl_rate"/><field name="ccf_rate"/><field name="sena_rate"/><field name="icbf_rate"/></group><group string="Recargos y provisiones"><field name="overtime_day_rate"/><field name="overtime_night_rate"/><field name="night_rate"/><field name="holiday_rate"/><field name="night_start_hour"/><field name="night_end_hour"/><field name="severance_rate"/><field name="severance_interest_rate"/><field name="vacation_rate"/><field name="bonus_rate"/><field name="severance_days_per_year"/><field name="vacation_days_per_year"/><field name="bonus_days_per_year"/></group><group string="Contabilidad"><field name="account_journal_id"/><field name="expense_account_id"/><field name="payroll_payable_account_id"/><field name="deductions_account_id"/><field name="employer_account_id"/><field name="analytic_account_id"/></group><field name="withholding_notes" placeholder="Notas tributarias y supuestos..."/></sheet></form></field>
    </record>
    <record id="action_co_payroll_parameter" model="ir.actions.act_window"><field name="name">Parámetros anuales</field><field name="res_model">l10n.co.payroll.parameter</field><field name="view_mode">list,form</field></record>
</odoo>
