<odoo>
    <record id="view_co_payroll_parameter_list" model="ir.ui.view">
        <field name="name">l10n.co.payroll.parameter.list</field>
        <field name="model">l10n.co.payroll.parameter</field>
        <field name="arch" type="xml">
            <list string="Parámetros anuales">
                <field name="name"/>
                <field name="company_id"/>
                <field name="year"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="minimum_wage" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="transport_allowance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="uvt_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_co_payroll_parameter_form" model="ir.ui.view">
        <field name="name">l10n.co.payroll.parameter.form</field>
        <field name="model">l10n.co.payroll.parameter</field>
        <field name="arch" type="xml">
            <form string="Parametrización legal colombiana">
                <header>
                    <button name="action_activate" type="object" string="Activar versión" class="oe_highlight" invisible="status == 'active'" groups="l10n_co_payroll.group_co_payroll_manager"/>
                    <button name="action_archive" type="object" string="Archivar" invisible="status == 'archived'" groups="l10n_co_payroll.group_co_payroll_manager"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-info" role="alert">El sistema crea los valores colombianos iniciales. Revisa únicamente la vigencia, los valores legales de tu empresa y las cuentas contables.</div>
                    <notebook>
                        <page string="Vigencia y valores base">
                            <group>
                                <group>
                                    <field name="company_id"/>
                                    <field name="year"/>
                                    <field name="version"/>
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                    <field name="active"/>
                                </group>
                                <group>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="minimum_wage" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="transport_allowance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="uvt_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="weekly_hours"/>
                                </group>
                            </group>
                            <group string="Fuente legal">
                                <field name="source_reference" placeholder="Norma o fuente de referencia"/>
                                <field name="legal_basis" placeholder="Notas y supuestos de la parametrización"/>
                            </group>
                        </page>
                        <page string="Seguridad social e IBC">
                            <group>
                                <group string="Aportes">
                                    <field name="health_employee_rate"/>
                                    <field name="health_employer_rate"/>
                                    <field name="pension_employee_rate"/>
                                    <field name="pension_employer_rate"/>
                                    <field name="arl_rate"/>
                                    <field name="ccf_rate"/>
                                    <field name="sena_rate"/>
                                    <field name="icbf_rate"/>
                                </group>
                                <group string="Bases y topes">
                                    <field name="minimum_ibc"/>
                                    <field name="minimum_ibc_multiple"/>
                                    <field name="maximum_ibc_multiple"/>
                                    <field name="integral_salary_min_multiple"/>
                                    <field name="integral_ibc_ratio"/>
                                    <field name="transport_allowance_max_wage_multiple"/>
                                    <field name="deduction_limit_ratio"/>
                                </group>
                            </group>
                            <group string="Exoneraciones y riesgo">
                                <field name="arl_rate_class_1"/><field name="arl_rate_class_2"/><field name="arl_rate_class_3"/><field name="arl_rate_class_4"/><field name="arl_rate_class_5"/>
                                <field name="employer_health_exempt"/><field name="employer_sena_exempt"/><field name="employer_icbf_exempt"/>
                            </group>
                            <group string="Fondo de solidaridad">
                                <field name="solidarity_threshold_mw"/><field name="solidarity_rate_1"/><field name="solidarity_rate_2"/><field name="solidarity_rate_3"/><field name="solidarity_rate_4"/><field name="solidarity_rate_5"/><field name="solidarity_rate_6"/>
                            </group>
                        </page>
                        <page string="Recargos y prestaciones">
                            <group>
                                <group string="Horas y jornada">
                                    <field name="overtime_day_rate"/><field name="overtime_night_rate"/><field name="night_rate"/><field name="holiday_rate"/>
                                    <field name="night_start_hour"/><field name="night_end_hour"/><field name="overtime_daily_limit_hours"/><field name="overtime_weekly_limit_hours"/>
                                </group>
                                <group string="Provisiones">
                                    <field name="severance_rate"/><field name="severance_interest_rate"/><field name="vacation_rate"/><field name="bonus_rate"/>
                                    <field name="severance_days_per_year"/><field name="vacation_days_per_year"/><field name="bonus_days_per_year"/><field name="variable_average_months"/><field name="variable_average_include_transport"/>
                                </group>
                            </group>
                        </page>
                        <page string="Retención y controles">
                            <group>
                                <group string="Retención">
                                    <field name="withholding_enabled"/><field name="withholding_procedure"/><field name="pension_regime_mode"/>
                                </group>
                                <group string="Aprobaciones">
                                    <field name="approval_mode"/><field name="block_on_warnings"/><field name="require_novelty_approval"/><field name="legal_validation_required"/><field name="social_profile_policy"/>
                                </group>
                            </group>
                            <field name="withholding_bracket_ids" context="{'default_company_id': company_id}" string="Tabla de retención">
                                <list editable="bottom"><field name="sequence"/><field name="name"/><field name="from_uvt"/><field name="to_uvt"/><field name="fixed_uvt"/><field name="marginal_rate"/><field name="active"/></list>
                            </field>
                            <field name="withholding_notes" placeholder="Notas tributarias y supuestos..."/>
                        </page>
                        <page string="Contabilidad">
                            <group>
                                <field name="account_journal_id"/>
                                <field name="expense_account_id"/>
                                <field name="payroll_payable_account_id"/>
                                <field name="deductions_account_id"/>
                                <field name="employer_account_id"/>
                                <field name="analytic_account_id"/>
                            </group>
                            <div class="alert alert-info" role="status">Estas cuentas son opcionales para calcular nómina, pero necesarias si se desea generar la contabilización automáticamente.</div>
                        </page>
                    </notebook>
                    <group string="Revisión" class="mt-3">
                        <field name="reviewed_by"/><field name="reviewed_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_co_payroll_parameter" model="ir.actions.act_window">
        <field name="name">Parametrización legal</field>
        <field name="res_model">l10n.co.payroll.parameter</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
