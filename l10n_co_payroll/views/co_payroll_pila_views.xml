<odoo>
    <record id="view_co_payroll_pila_config_list" model="ir.ui.view"><field name="name">l10n.co.payroll.pila.config.list</field><field name="model">l10n.co.payroll.pila.config</field><field name="arch" type="xml"><list string="Configuraciones PILA"><field name="name"/><field name="company_id"/><field name="operator"/><field name="file_format"/><field name="encoding"/><field name="active"/></list></field></record>
    <record id="view_co_payroll_pila_config_form" model="ir.ui.view"><field name="name">l10n.co.payroll.pila.config.form</field><field name="model">l10n.co.payroll.pila.config</field><field name="arch" type="xml"><form string="Configuración PILA"><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="company_id"/><field name="operator"/><field name="file_format"/><field name="active"/></group><group><field name="delimiter"/><field name="encoding"/><field name="include_header"/><field name="filename_prefix"/></group></group><field name="legal_reference" placeholder="Versión de estructura y referencia técnica..."/></sheet></form></field></record>
    <record id="view_co_payroll_pila_file_list" model="ir.ui.view"><field name="name">l10n.co.payroll.pila.file.list</field><field name="model">l10n.co.payroll.pila.file</field><field name="arch" type="xml"><list string="Archivos PILA" decoration-warning="state == 'draft'" decoration-success="state in ('generated', 'exported')"><field name="name"/><field name="period_id"/><field name="config_id"/><field name="record_count"/><field name="generated_at"/><field name="checksum" optional="hide"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_co_payroll_pila_file_form" model="ir.ui.view"><field name="name">l10n.co.payroll.pila.file.form</field><field name="model">l10n.co.payroll.pila.file</field><field name="arch" type="xml"><form string="Archivo PILA"><header><button name="action_validate" type="object" string="Validar" class="oe_highlight" invisible="state in ('generated', 'exported', 'cancelled')" groups="l10n_co_payroll.group_co_payroll_user"/><button name="action_generate" type="object" string="Generar archivo" class="oe_highlight" invisible="state != 'validated'" groups="l10n_co_payroll.group_co_payroll_user"/><button name="action_download" type="object" string="Descargar" invisible="not attachment_id" groups="l10n_co_payroll.group_co_payroll_user"/><field name="state" widget="statusbar" statusbar_visible="draft,validated,generated,exported,cancelled"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="company_id"/><field name="period_id"/><field name="config_id"/></group><group><field name="record_count"/><field name="generated_by"/><field name="generated_at"/><field name="checksum"/></group></group><div class="alert alert-warning" role="alert" invisible="not validation_message"><field name="validation_message" nolabel="1"/></div><field name="attachment_id"/></sheet><chatter/></form></field></record>
    <record id="action_co_payroll_pila_config" model="ir.actions.act_window"><field name="name">Configuración PILA</field><field name="res_model">l10n.co.payroll.pila.config</field><field name="view_mode">list,form</field></record>
    <record id="action_co_payroll_pila_file" model="ir.actions.act_window"><field name="name">Archivos PILA</field><field name="res_model">l10n.co.payroll.pila.file</field><field name="view_mode">list,form</field></record>
</odoo>
