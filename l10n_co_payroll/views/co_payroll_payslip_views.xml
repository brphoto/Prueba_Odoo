<odoo>
    <record id="view_hr_payslip_co_payroll" model="ir.ui.view">
        <field name="name">hr.payslip.l10n.co.payroll</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='salary_computation']/field[@name='line_ids']" position="attributes">
                <attribute name="name">visible_line_ids</attribute>
                <attribute name="domain">[]</attribute>
            </xpath>
            <xpath expr="//page[@name='salary_computation']" position="after">
                <page name="co_payroll_rules" string="Nómina Colombia">
                    <div class="alert alert-info" role="alert" invisible="co_formula_applied or co_formula_error">Pulsa «Calcular hoja» para calcular automáticamente las reglas colombianas y ver los conceptos y resultados parametrizados.</div>
                    <group><field name="co_formula_parameter_id"/><field name="co_formula_error" invisible="not co_formula_error"/></group>
                    <group string="Totales resultantes"><field name="co_formula_gross_wage" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="co_formula_deduction_total" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="co_formula_net_wage" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="co_formula_employer_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="co_formula_ibc_base" widget="monetary" options="{'currency_field': 'currency_id'}"/></group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
