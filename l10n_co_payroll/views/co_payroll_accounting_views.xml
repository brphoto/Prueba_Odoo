<odoo>
    <record id="view_co_payroll_period_form_accounting_control" model="ir.ui.view">
        <field name="name">l10n.co.payroll.period.form.accounting.control</field><field name="model">l10n.co.payroll.period</field>
        <field name="inherit_id" ref="l10n_co_payroll.view_co_payroll_period_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='accounting_state']" position="after"><field name="accounting_balanced" widget="boolean_toggle"/><field name="accounting_difference" widget="monetary" options="{'currency_field': 'currency_id'}"/></xpath>
        </field>
    </record>
</odoo>
