<odoo>
    <record id="view_co_payroll_novelty_list" model="ir.ui.view">
        <field name="name">l10n.co.payroll.novelty.list</field><field name="model">l10n.co.payroll.novelty</field>
        <field name="arch" type="xml"><list string="Novedades laborales" decoration-danger="state == 'rejected'" decoration-warning="state == 'draft'" decoration-success="state in ('approved', 'applied')"><field name="name"/><field name="period_id"/><field name="employee_id"/><field name="novelty_type"/><field name="date_from"/><field name="date_to"/><field name="days"/><field name="affects_ibc"/><field name="state" widget="badge"/><field name="approved_by"/></list></field>
    </record>
    <record id="view_co_payroll_novelty_search" model="ir.ui.view">
        <field name="name">l10n.co.payroll.novelty.search</field><field name="model">l10n.co.payroll.novelty</field>
        <field name="arch" type="xml"><search string="Buscar novedades"><field name="employee_id"/><field name="period_id"/><field name="novelty_type"/><field name="state"/><separator/><filter name="pending" string="Pendientes" domain="[('state', '=', 'draft')]"/><filter name="approved" string="Aprobadas" domain="[('state', 'in', ['approved', 'applied'])]"/><group><filter name="group_type" string="Tipo" domain="[]" context="{'group_by': 'novelty_type'}"/><filter name="group_state" string="Estado" domain="[]" context="{'group_by': 'state'}"/></group></search></field>
    </record>
    <record id="view_co_payroll_novelty_form" model="ir.ui.view">
        <field name="name">l10n.co.payroll.novelty.form</field><field name="model">l10n.co.payroll.novelty</field>
        <field name="arch" type="xml"><form string="Novedad laboral"><header><button name="action_approve" type="object" string="Aprobar" class="oe_highlight" invisible="state != 'draft'" groups="l10n_co_payroll.group_co_payroll_manager"/><button name="action_reject" type="object" string="Rechazar" invisible="state != 'draft'" groups="l10n_co_payroll.group_co_payroll_manager"/><button name="action_reset" type="object" string="Volver a pendiente" invisible="state not in ('approved', 'applied', 'rejected')" groups="l10n_co_payroll.group_co_payroll_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,approved,applied,rejected"/></header><sheet><div class="oe_title"><label for="name" class="oe_edit_only" string="Referencia"/><h1><field name="name"/></h1></div><group><group><field name="period_id" options="{'no_create': True}" readonly="state != 'draft'"/><field name="employee_id" options="{'no_create': True}" readonly="state != 'draft'"/><field name="novelty_type" readonly="state != 'draft'"/></group><group><field name="date_from" readonly="state != 'draft'"/><field name="date_to" readonly="state != 'draft'"/><field name="days" readonly="state != 'draft'"/><field name="affects_ibc" readonly="state != 'draft'"/><field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'"/></group></group><field name="notes" placeholder="Soporte, observaciones y referencia..." readonly="state != 'draft'"/><group string="Auditoría"><field name="company_id"/><field name="approved_by"/><field name="approved_at"/></group></sheet><chatter/></form></field>
    </record>
    <record id="action_co_payroll_novelty" model="ir.actions.act_window"><field name="name">Novedades laborales</field><field name="res_model">l10n.co.payroll.novelty</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_co_payroll_novelty_search"/></record>
</odoo>
