<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_co_payroll_period_form_enterprise" model="ir.ui.view"><field name="name">l10n.co.payroll.period.form.enterprise</field><field name="model">l10n.co.payroll.period</field><field name="inherit_id" ref="l10n_co_payroll.view_co_payroll_period_form"/><field name="arch" type="xml"><xpath expr="//header/field[@name='state']" position="before"><button name="action_create_sandbox" type="object" string="Crear sandbox" invisible="is_sandbox" groups="l10n_co_payroll.group_co_payroll_user"/><button name="action_generate_checklist" type="object" string="Generar checklist" invisible="not require_checklist" groups="l10n_co_payroll.group_co_payroll_user"/><button name="action_create_snapshot" type="object" string="Crear copia" invisible="state == 'draft'" groups="l10n_co_payroll.group_co_payroll_user"/><field name="is_sandbox" widget="boolean_toggle" readonly="1"/></xpath><xpath expr="//button[@name='action_open_issues']" position="after"><button name="action_generate_tasks" type="object" class="oe_stat_button" icon="fa-tasks"><field name="open_task_count" widget="statinfo" string="Tareas"/></button></xpath><xpath expr="//field[@name='net_total']" position="after"><field name="payable_net_total" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="additional_deduction_total" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="absence_days_total"/><field name="require_checklist"/></xpath><xpath expr="//page[@name='audit']" position="before"><page string="Tareas" name="enterprise_tasks"><field name="task_ids"><list><field name="name"/><field name="employee_id"/><field name="task_type"/><field name="priority" widget="priority"/><field name="assigned_user_id"/><field name="deadline"/><field name="state" widget="badge"/></list></field></page><page string="Checklist" name="enterprise_checklist"><field name="checklist_ids"><list><field name="sequence"/><field name="name"/><field name="required"/><field name="state" widget="badge"/><field name="checked_by"/></list></field><field name="checklist_progress" widget="progressbar"/></page><page string="Copias funcionales" name="enterprise_snapshots"><field name="snapshot_ids"><list><field name="name"/><field name="snapshot_date"/><field name="created_by"/><field name="record_count"/><field name="checksum" optional="hide"/></list></field></page></xpath></field></record>
    <record id="view_co_payroll_period_line_list_enterprise" model="ir.ui.view"><field name="name">l10n.co.payroll.period.line.list.enterprise</field><field name="model">l10n.co.payroll.period.line</field><field name="inherit_id" ref="l10n_co_payroll.view_co_payroll_period_line_list"/><field name="arch" type="xml"><xpath expr="//field[@name='net_wage']" position="after"><field name="loan_deduction" optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="embargo_deduction" optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="net_after_deductions" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total real"/><field name="absence_days" optional="hide"/></xpath></field></record>
</odoo>
