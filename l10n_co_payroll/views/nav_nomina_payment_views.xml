<odoo>
    <record id="view_nav_nomina_payment_batch_list" model="ir.ui.view"><field name="name">nav.nomina.payment.batch.list</field><field name="model">nav.nomina.payment.batch</field><field name="arch" type="xml"><list string="Pagos de nómina" decoration-warning="state == 'draft'" decoration-success="state in ('exported', 'paid')"><field name="name"/><field name="period_id"/><field name="payment_date"/><field name="payment_count"/><field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_nav_nomina_payment_batch_form" model="ir.ui.view"><field name="name">nav.nomina.payment.batch.form</field><field name="model">nav.nomina.payment.batch</field><field name="arch" type="xml"><form string="Lote de pagos"><header><button name="action_prepare" type="object" string="Preparar pagos" class="oe_highlight" invisible="state not in ('draft', 'ready')" groups="l10n_co_payroll.group_nav_nomina_user"/><button name="action_export_csv" type="object" string="Exportar banco" invisible="state not in ('ready', 'exported')" groups="l10n_co_payroll.group_nav_nomina_user"/><button name="action_mark_paid" type="object" string="Marcar pagado" invisible="state not in ('ready', 'exported')" groups="l10n_co_payroll.group_nav_nomina_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,ready,exported,paid,cancelled"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="company_id"/><field name="period_id"/><field name="payment_date"/><field name="journal_id"/></group><group><field name="payment_count"/><field name="currency_id" invisible="1"/><field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/></group></group><field name="line_ids" readonly="1"><list create="false" delete="false"><field name="employee_id"/><field name="bank_account_id"/><field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="state" widget="badge"/><field name="error_message"/></list></field></sheet><chatter/></form></field></record>
    <record id="action_nav_nomina_payment_batch" model="ir.actions.act_window"><field name="name">Pagos de nómina</field><field name="res_model">nav.nomina.payment.batch</field><field name="view_mode">list,form</field></record>
</odoo>
