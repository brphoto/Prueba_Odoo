<odoo>
    <record id="view_co_payroll_period_line_pivot" model="ir.ui.view">
        <field name="name">l10n.co.payroll.period.line.pivot</field>
        <field name="model">l10n.co.payroll.period.line</field>
        <field name="arch" type="xml">
            <pivot string="Analítica de costo laboral">
                <field name="period_id" type="row"/>
                <field name="department_id" type="row"/>
                <field name="employee_id" type="col"/>
                <field name="gross_wage" type="measure"/>
                <field name="deduction_total" type="measure"/>
                <field name="net_wage" type="measure"/>
                <field name="employer_cost" type="measure"/>
                <field name="worked_days" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_co_payroll_period_line_graph" model="ir.ui.view">
        <field name="name">l10n.co.payroll.period.line.graph</field>
        <field name="model">l10n.co.payroll.period.line</field>
        <field name="arch" type="xml">
            <graph string="Costo laboral" type="bar">
                <field name="period_id"/>
                <field name="employer_cost" type="measure"/>
                <field name="net_wage" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_co_payroll_period_line_search" model="ir.ui.view">
        <field name="name">l10n.co.payroll.period.line.search</field>
        <field name="model">l10n.co.payroll.period.line</field>
        <field name="arch" type="xml">
            <search string="Buscar consolidado">
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="pila_status"/>
                <filter name="changed" string="Cambios frente al periodo anterior" domain="[('comparison_state', '=', 'changed')]"/>
                <filter name="pila_pending" string="PILA pendiente" domain="[('pila_status', '=', 'pending')]"/>
                <group>
                    <filter name="group_period" string="Periodo" context="{'group_by': 'period_id'}"/>
                    <filter name="group_department" string="Departamento" context="{'group_by': 'department_id'}"/>
                    <filter name="group_employee" string="Empleado" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_co_payroll_analytics" model="ir.actions.act_window">
        <field name="name">Consolidado de nómina</field>
        <field name="res_model">l10n.co.payroll.period.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_co_payroll_period_line_search"/>
        <field name="context">{'search_default_group_period_id': 1}</field>
    </record>
    <menuitem id="menu_co_payroll_analytics" name="Analítica de costos" parent="hr_payroll.menu_hr_payroll_report" action="action_co_payroll_analytics" sequence="30" groups="l10n_co_payroll.group_co_payroll_user,l10n_co_payroll.group_co_payroll_auditor"/>
</odoo>
