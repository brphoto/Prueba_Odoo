<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_co_payroll_checklist_list" model="ir.ui.view"><field name="name">l10n.co.payroll.checklist.list</field><field name="model">l10n.co.payroll.checklist</field><field name="arch" type="xml"><list string="Checklist de cierre" decoration-success="state in ('done', 'skipped')"><field name="sequence"/><field name="name"/><field name="period_id"/><field name="required"/><field name="state" widget="badge"/><field name="checked_by"/><field name="checked_at"/></list></field></record>
    <record id="view_co_payroll_checklist_form" model="ir.ui.view"><field name="name">l10n.co.payroll.checklist.form</field><field name="model">l10n.co.payroll.checklist</field><field name="arch" type="xml"><form string="Checklist de cierre"><header><button name="action_done" type="object" string="Marcar completado" class="oe_highlight" invisible="state != 'pending'"/><button name="action_skip" type="object" string="Omitir" invisible="state != 'pending'"/><field name="state" widget="statusbar" statusbar_visible="pending,done,skipped"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="period_id"/><field name="sequence"/><field name="required"/></group><field name="notes"/><group><field name="checked_by"/><field name="checked_at"/></group></sheet></form></field></record>
    <record id="view_co_payroll_snapshot_list" model="ir.ui.view"><field name="name">l10n.co.payroll.snapshot.list</field><field name="model">l10n.co.payroll.snapshot</field><field name="arch" type="xml"><list string="Copias funcionales"><field name="name"/><field name="period_id"/><field name="snapshot_date"/><field name="created_by"/><field name="record_count"/><field name="checksum" optional="hide"/></list></field></record>
    <record id="view_co_payroll_snapshot_form" model="ir.ui.view"><field name="name">l10n.co.payroll.snapshot.form</field><field name="model">l10n.co.payroll.snapshot</field><field name="arch" type="xml"><form string="Copia funcional"><header><button name="action_download" type="object" string="Descargar" class="oe_highlight"/><field name="snapshot_date"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="period_id"/><field name="created_by"/><field name="record_count"/><field name="checksum"/><field name="attachment_id"/></group><field name="notes"/></sheet></form></field></record>
    <record id="action_co_payroll_checklist" model="ir.actions.act_window"><field name="name">Checklist de cierre</field><field name="res_model">l10n.co.payroll.checklist</field><field name="view_mode">list,form</field></record>
    <record id="action_co_payroll_snapshot" model="ir.actions.act_window"><field name="name">Copias funcionales</field><field name="res_model">l10n.co.payroll.snapshot</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_co_payroll_checklist" name="Checklist de cierre" parent="hr_payroll.menu_hr_payroll_report" action="action_co_payroll_checklist" sequence="40" groups="l10n_co_payroll.group_co_payroll_user,l10n_co_payroll.group_co_payroll_auditor"/>
    <menuitem id="menu_co_payroll_snapshot" name="Copias funcionales" parent="hr_payroll.menu_hr_payroll_report" action="action_co_payroll_snapshot" sequence="50" groups="l10n_co_payroll.group_co_payroll_user,l10n_co_payroll.group_co_payroll_auditor"/>
</odoo>
