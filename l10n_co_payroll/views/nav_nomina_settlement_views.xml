<odoo>
    <record id="view_nav_nomina_settlement_list" model="ir.ui.view"><field name="name">nav.nomina.settlement.list</field><field name="model">nav.nomina.settlement</field><field name="arch" type="xml"><list string="Liquidaciones" decoration-warning="state in ('draft', 'calculated')" decoration-success="state in ('approved', 'paid')" decoration-muted="state == 'cancelled'"><field name="name"/><field name="employee_id"/><field name="termination_date"/><field name="reason"/><field name="base_salary" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="total" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_nav_nomina_settlement_form" model="ir.ui.view"><field name="name">nav.nomina.settlement.form</field><field name="model">nav.nomina.settlement</field><field name="arch" type="xml"><form string="Liquidación definitiva"><header><button name="action_calculate" type="object" string="Calcular" class="oe_highlight" invisible="state not in ('draft', 'calculated')" groups="l10n_co_payroll.group_nav_nomina_user"/><button name="action_approve" type="object" string="Aprobar" class="oe_highlight" invisible="state != 'calculated'" groups="l10n_co_payroll.group_nav_nomina_manager"/><button name="action_mark_paid" type="object" string="Marcar pagada" invisible="state != 'approved'" groups="l10n_co_payroll.group_nav_nomina_manager"/><button name="action_cancel" type="object" string="Cancelar" invisible="state in ('paid', 'cancelled')" groups="l10n_co_payroll.group_nav_nomina_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,calculated,approved,paid,cancelled"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="company_id"/><field name="employee_id"/><field name="period_id"/><field name="termination_date"/><field name="reason"/></group><group><field name="currency_id" invisible="1"/><field name="base_salary" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="service_days"/><field name="total" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold"/></group></group><group string="Conceptos"><field name="pending_wages" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="severance" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="severance_interest" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="vacation" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="bonus" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="deductions" widget="monetary" options="{'currency_field': 'currency_id'}"/></group><field name="notes" placeholder="Soporte y observaciones..."/><group string="Auditoría"><field name="calculated_by"/><field name="calculated_at"/><field name="approved_by"/><field name="approved_at"/></group></sheet><chatter/></form></field></record>
    <record id="action_nav_nomina_settlement" model="ir.actions.act_window"><field name="name">Liquidaciones</field><field name="res_model">nav.nomina.settlement</field><field name="view_mode">list,form</field></record>
</odoo>
