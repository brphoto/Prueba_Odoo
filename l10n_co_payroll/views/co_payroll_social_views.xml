<odoo>
    <record id="view_co_payroll_social_list" model="ir.ui.view">
        <field name="name">l10n.co.payroll.social.list</field><field name="model">l10n.co.payroll.social</field>
        <field name="arch" type="xml"><list string="Perfiles PILA" decoration-warning="state == 'draft'" decoration-muted="state == 'archived'"><field name="name"/><field name="employee_id"/><field name="effective_from"/><field name="effective_to"/><field name="coverage_mode" widget="badge"/><field name="contributor_type"/><field name="eps_code"/><field name="pension_code"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_co_payroll_social_form" model="ir.ui.view">
        <field name="name">l10n.co.payroll.social.form</field><field name="model">l10n.co.payroll.social</field>
        <field name="arch" type="xml"><form string="Perfil de seguridad social"><header><button name="action_activate" type="object" string="Activar" class="oe_highlight" invisible="state == 'active'" groups="l10n_co_payroll.group_co_payroll_manager"/><button name="action_archive" type="object" string="Archivar" invisible="state == 'archived'" groups="l10n_co_payroll.group_co_payroll_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><div class="alert alert-info" role="alert" invisible="coverage_mode == 'full'">Este perfil no se incluirá en el archivo PILA del sistema. Conserva la referencia externa o el motivo.</div><group><group><field name="employee_id"/><field name="company_id"/><field name="effective_from"/><field name="effective_to"/><field name="salary_mode"/><field name="coverage_mode"/><field name="manual_reference" invisible="coverage_mode == 'full'"/></group><group><field name="identification_type"/><field name="contributor_type"/><field name="contributor_subtype"/><field name="risk_class"/></group></group><group string="Administradoras" invisible="coverage_mode != 'full'"><field name="eps_id"/><field name="pension_id"/><field name="arl_id"/><field name="ccf_id"/><field name="require_eps"/><field name="require_pension"/><field name="require_arl"/><field name="require_ccf"/></group><group string="Códigos manuales (solo si no existe en el catálogo)" invisible="coverage_mode != 'full'"><field name="eps_code" invisible="eps_id"/><field name="pension_code" invisible="pension_id"/><field name="arl_code" invisible="arl_id"/><field name="ccf_code" invisible="ccf_id"/></group><field name="notes" placeholder="Soporte y observaciones..."/></sheet></form></field>
    </record>
    <record id="view_co_payroll_social_search" model="ir.ui.view"><field name="name">l10n.co.payroll.social.search</field><field name="model">l10n.co.payroll.social</field><field name="arch" type="xml"><search string="Buscar perfiles PILA"><field name="employee_id"/><field name="state"/><field name="eps_code"/><field name="pension_code"/><filter name="active" string="Activos" domain="[('state', '=', 'active')]"/></search></field></record>
    <record id="action_co_payroll_social" model="ir.actions.act_window"><field name="name">Perfiles PILA</field><field name="res_model">l10n.co.payroll.social</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_co_payroll_social_search"/></record>
</odoo>
