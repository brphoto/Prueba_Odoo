<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_co_payroll_parameter_form_legal_fields" model="ir.ui.view">
        <field name="name">l10n.co.payroll.parameter.form.legal.fields</field>
        <field name="model">l10n.co.payroll.parameter</field>
        <field name="inherit_id" ref="view_co_payroll_parameter_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='arl_rate']" position="after">
                <field name="arl_rate_class_1"/><field name="arl_rate_class_2"/><field name="arl_rate_class_3"/><field name="arl_rate_class_4"/><field name="arl_rate_class_5"/>
                <field name="employer_health_exempt"/><field name="employer_sena_exempt"/><field name="employer_icbf_exempt"/>
            </xpath>
            <xpath expr="//field[@name='withholding_notes']" position="before">
                <field name="withholding_enabled"/><field name="withholding_procedure"/><field name="pension_regime_mode"/>
                <field name="withholding_bracket_ids" context="{'default_company_id': company_id}">
                    <list editable="bottom"><field name="sequence"/><field name="name"/><field name="from_uvt"/><field name="to_uvt"/><field name="fixed_uvt"/><field name="marginal_rate"/><field name="active"/></list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
