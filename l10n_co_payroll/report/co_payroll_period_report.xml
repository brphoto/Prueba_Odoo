<odoo>
    <record id="action_report_co_payroll_period" model="ir.actions.report">
        <field name="name">Resumen de nómina</field>
        <field name="model">l10n.co.payroll.period</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_co_payroll.report_co_payroll_period</field>
        <field name="report_file">l10n_co_payroll.report_co_payroll_period</field>
        <field name="print_report_name">'Consolidado_Nomina_%s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_l10n_co_payroll_period"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_co_payroll_period">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="period">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .nav-title { color: #17324d; font-size: 24px; font-weight: 700; margin-bottom: 4px; }
                            .nav-subtitle { color: #607080; font-size: 12px; }
                            .nav-kpi { background: #f3f6f8; border: 1px solid #d9e2e8; padding: 10px; }
                            .nav-kpi-label { color: #607080; font-size: 10px; text-transform: uppercase; }
                            .nav-kpi-value { color: #17324d; font-size: 16px; font-weight: 700; }
                            .nav-table thead { background: #17324d; color: white; }
                            .nav-table th, .nav-table td { padding: 5px 6px; font-size: 10px; }
                            .nav-table tbody tr:nth-child(even) { background: #f7f9fa; }
                        </style>
                        <div class="row mb-3">
                            <div class="col-8">
                                <div class="nav-title">Resumen de nómina</div>
                                <div class="nav-subtitle"><span t-field="period.company_id"/> · <span t-field="period.period_type"/></div>
                            </div>
                            <div class="col-4 text-end"><strong>Referencia</strong><br/><span t-field="period.name"/><br/><span t-field="period.state"/></div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-4"><div class="nav-kpi"><div class="nav-kpi-label">Periodo</div><div><span t-field="period.date_from"/> — <span t-field="period.date_to"/></div></div></div>
                            <div class="col-4"><div class="nav-kpi"><div class="nav-kpi-label">Empleados</div><div class="nav-kpi-value"><span t-esc="period.employee_count"/></div></div></div>
                            <div class="col-4"><div class="nav-kpi"><div class="nav-kpi-label">Neto a pagar</div><div class="nav-kpi-value"><span t-field="period.net_total" t-options="{'widget': 'monetary', 'display_currency': period.currency_id}"/></div></div></div>
                        </div>
                        <p class="mb-3"><strong>Fecha de pago:</strong> <span t-field="period.payment_date"/> <span class="ms-3"><strong>Recibos:</strong> <span t-esc="period.payslip_count"/></span> <span class="ms-3"><strong>Hallazgos:</strong> <span t-esc="period.issue_count"/></span></p>
                        <table class="table table-sm nav-table">
                            <thead><tr><th>Empleado</th><th>Estado</th><th class="text-end">Devengado</th><th class="text-end">Deducciones</th><th class="text-end">Neto</th><th class="text-end">Variación</th></tr></thead>
                            <tbody>
                                <tr t-foreach="period.line_ids" t-as="line">
                                    <td><span t-field="line.employee_id"/></td><td><span t-field="line.comparison_state"/></td>
                                    <td class="text-end"><span t-field="line.gross_wage" t-options="{'widget': 'monetary', 'display_currency': period.currency_id}"/></td>
                                    <td class="text-end"><span t-field="line.deduction_total" t-options="{'widget': 'monetary', 'display_currency': period.currency_id}"/></td>
                                    <td class="text-end"><span t-field="line.net_wage" t-options="{'widget': 'monetary', 'display_currency': period.currency_id}"/></td>
                                    <td class="text-end"><span t-field="line.net_variation" t-options="{'widget': 'monetary', 'display_currency': period.currency_id}"/></td>
                                </tr>
                            </tbody>
                            <tfoot><tr><th colspan="2">Totales</th><th class="text-end"><span t-field="period.gross_total" t-options="{'widget': 'monetary', 'display_currency': period.currency_id}"/></th><th class="text-end"><span t-field="period.deduction_total" t-options="{'widget': 'monetary', 'display_currency': period.currency_id}"/></th><th class="text-end"><span t-field="period.net_total" t-options="{'widget': 'monetary', 'display_currency': period.currency_id}"/></th><th class="text-end"><span t-esc="sum(period.line_ids.mapped('net_variation'))" t-options="{'widget': 'monetary', 'display_currency': period.currency_id}"/></th></tr></tfoot>
                        </table>
                        <div t-if="period.blocking_issue_count" class="alert alert-danger"><strong>Validaciones bloqueantes:</strong> <span t-esc="period.blocking_issue_count"/></div>
                        <p t-if="period.note"><strong>Notas:</strong> <span t-field="period.note"/></p>
                        <p class="text-muted mt-4" style="font-size: 9px;">Documento operativo generado por Nómina Colombia. Los parámetros anuales son configurables y deben mantenerse actualizados por el responsable laboral/contable.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
