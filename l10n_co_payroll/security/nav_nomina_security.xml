<odoo>
    <record id="group_nav_nomina_user" model="res.groups">
        <field name="name">Nómina Colombia / Usuario</field>
        <field name="implied_ids" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <record id="group_nav_nomina_manager" model="res.groups">
        <field name="name">Nómina Colombia / Supervisor</field>
        <field name="implied_ids" eval="[(4, ref('l10n_co_payroll.group_nav_nomina_user'))]"/>
    </record>
    <record id="group_nav_nomina_auditor" model="res.groups">
        <field name="name">Nómina Colombia / Auditor</field>
    </record>

    <record id="rule_nav_nomina_period_company" model="ir.rule">
        <field name="name">Nómina Colombia por compañía</field><field name="model_id" ref="model_nav_nomina_period"/><field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('l10n_co_payroll.group_nav_nomina_user')), (4, ref('l10n_co_payroll.group_nav_nomina_manager')), (4, ref('l10n_co_payroll.group_nav_nomina_auditor'))]"/>
    </record>
    <record id="rule_nav_nomina_period_line_company" model="ir.rule">
        <field name="name">Resumen por compañía</field><field name="model_id" ref="model_nav_nomina_period_line"/><field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('l10n_co_payroll.group_nav_nomina_user')), (4, ref('l10n_co_payroll.group_nav_nomina_manager')), (4, ref('l10n_co_payroll.group_nav_nomina_auditor'))]"/>
    </record>
    <record id="rule_nav_nomina_period_issue_company" model="ir.rule">
