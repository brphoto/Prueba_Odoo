    <record id="rule_nav_nomina_payment_line_company" model="ir.rule"><field name="name">Líneas de pago por compañía</field><field name="model_id" ref="model_nav_nomina_payment_line"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('l10n_co_payroll.group_nav_nomina_user')), (4, ref('l10n_co_payroll.group_nav_nomina_manager')), (4, ref('l10n_co_payroll.group_nav_nomina_auditor'))]"/></record>
