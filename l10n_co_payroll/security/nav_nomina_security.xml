        <field name="groups" eval="[(4, ref('l10n_co_payroll.group_nav_nomina_manager'))]"/>
    </record>
    <record id="rule_nav_nomina_novelty_company" model="ir.rule">
        <field name="name">Novedades por compañía</field><field name="model_id" ref="model_nav_nomina_novelty"/><field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('l10n_co_payroll.group_nav_nomina_user')), (4, ref('l10n_co_payroll.group_nav_nomina_manager')), (4, ref('l10n_co_payroll.group_nav_nomina_auditor'))]"/>
    </record>
