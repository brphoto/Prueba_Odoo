<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="chatroom_whatsapp.ContactPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_chatroom_contact_actions')]" position="inside">
            <button class="btn btn-sm btn-light" t-on-click="scheduleMeeting">
                <i class="fa fa-calendar"/> Reunión
            </button>
            <button class="btn btn-sm btn-light" title="Ver reuniones agendadas"
                    t-on-click="viewMeetings">
                <i class="fa fa-calendar-check-o"/>
            </button>
        </xpath>
    </t>

</templates>
