<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_crm_stagnation" model="ir.module.category">
        <field name="name">CRM Estancamiento</field>
        <field name="sequence">25</field>
    </record>
    <record id="privilege_crm_stagnation" model="res.groups.privilege">
        <field name="name">CRM Estancamiento</field>
        <field name="category_id" ref="crm_stagnation_management.module_category_crm_stagnation"/>
    </record>
    <record id="group_crm_stagnation_user" model="res.groups">
        <field name="name">Usuario de estancamiento CRM</field>
        <field name="privilege_id" ref="crm_stagnation_management.privilege_crm_stagnation"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_crm_stagnation_manager" model="res.groups">
        <field name="name">Administrador de estancamiento CRM</field>
        <field name="privilege_id" ref="crm_stagnation_management.privilege_crm_stagnation"/>
        <field name="implied_ids" eval="[(4, ref('crm_stagnation_management.group_crm_stagnation_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
