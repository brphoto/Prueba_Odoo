<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_purge_wizard_form" model="ir.ui.view">
        <field name="name">crm.lead.purge.wizard.form</field>
        <field name="model">crm.lead.purge.wizard</field>
        <field name="arch" type="xml">
            <form string="Depuración de oportunidades">
                <header>
                    <button name="action_preview" type="object" string="Actualizar vista previa" class="btn-secondary"/>
                    <button name="action_execute_purge" type="object" string="Ejecutar depuración" class="btn-primary"
                            confirm="Esta acción cambiará las oportunidades seleccionadas. ¿Desea continuar?"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        La IA puede sugerir y ordenar, pero esta acción siempre requiere una decisión humana y deja actividad en el historial.
                    </div>
                    <group>
                        <group string="Filtro">
                            <field name="stagnation_filter"/>
                            <field name="score_threshold" invisible="stagnation_filter != 'below_score'" required="stagnation_filter == 'below_score'"/>
                            <field name="selected_lead_ids" widget="many2many_tags" invisible="stagnation_filter != 'manual'"/>
                        </group>
                        <group string="Acción">
                            <field name="action"/>
                            <field name="loss_reason" invisible="action != 'lose'" required="action == 'lose'"/>
                            <field name="reviewer_id" invisible="action != 'assign_review'" required="action == 'assign_review'"/>
                        </group>
                    </group>
                    <group>
                        <field name="create_activities"/>
                        <field name="notify_owners"/>
                    </group>
                    <group string="Resumen">
                        <field name="company_id" invisible="1"/>
                        <field name="company_currency" invisible="1"/>
                        <field name="total_opportunities" readonly="1"/>
                        <field name="total_capital_released" readonly="1" widget="monetary"/>
                        <field name="avg_real_score" readonly="1" widget="percentage"/>
                    </group>
                    <group string="Detalle seleccionado" invisible="stagnation_filter != 'manual'">
                        <field name="selected_lead_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="stagnation_score" widget="badge"/>
                                <field name="days_in_stage"/>
                                <field name="estimated_capital_trapped" widget="monetary"/>
                                <field name="real_vs_fake_score"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_lead_purge_wizard" model="ir.actions.act_window">
        <field name="name">Depurar oportunidades</field>
        <field name="res_model">crm.lead.purge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
