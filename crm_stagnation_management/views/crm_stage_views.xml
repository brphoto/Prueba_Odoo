<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_stage_stagnation_form" model="ir.ui.view">
        <field name="name">crm.stage.form.stagnation</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <field name="rotting_threshold_days" position="after">
                <field name="stagnation_max_days"/>
                <field name="stagnation_required_activities"/>
            </field>
        </field>
    </record>
    <record id="view_crm_stage_stagnation_list" model="ir.ui.view">
        <field name="name">crm.stage.list.stagnation</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_tree"/>
        <field name="arch" type="xml">
            <field name="rotting_threshold_days" position="after">
                <field name="stagnation_max_days" optional="show"/>
                <field name="stagnation_required_activities" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
