<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_chatroom_ai_autonomy" model="ir.module.category">
        <field name="name">Chatroom Conocimiento y Autonomía</field>
        <field name="description">Controla el conocimiento y las acciones del agente IA.</field>
        <field name="sequence">48</field>
    </record>
    <record id="privilege_chatroom_ai_autonomy" model="res.groups.privilege">
        <field name="name">Conocimiento y autonomía IA</field>
        <field name="category_id" ref="module_category_chatroom_ai_autonomy"/>
    </record>
    <record id="group_chatroom_ai_autonomy_user" model="res.groups">
        <field name="name">Usuario de conocimiento y autonomía</field>
        <field name="privilege_id" ref="privilege_chatroom_ai_autonomy"/>
        <field name="implied_ids" eval="[(4, ref('chatroom_ai_agent.group_chatroom_ai_agent_user'))]"/>
    </record>
    <record id="group_chatroom_ai_autonomy_manager" model="res.groups">
        <field name="name">Administrador de conocimiento y autonomía</field>
        <field name="privilege_id" ref="privilege_chatroom_ai_autonomy"/>
        <field name="implied_ids" eval="[(4, ref('chatroom_ai_autonomy.group_chatroom_ai_autonomy_user')), (4, ref('chatroom_ai_agent.group_chatroom_ai_agent_manager'))]"/>
    </record>
</odoo>
