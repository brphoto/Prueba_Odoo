<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_marketing_social_connectors" model="ir.module.category">
        <field name="name">Conectores sociales</field>
        <field name="description">Permisos para conectar redes sociales al Centro de mando.</field>
        <field name="sequence">37</field>
    </record>
    <record id="privilege_network_connector" model="res.groups.privilege">
        <field name="name">Conectores sociales</field>
        <field name="category_id" ref="module_category_marketing_social_connectors"/>
    </record>
    <record id="group_network_user" model="res.groups">
        <field name="name">Usuario de conectores sociales</field>
        <field name="privilege_id" ref="privilege_network_connector"/>
        <field name="implied_ids" eval="[(4, ref('marketing_command_center.group_marketing_user'))]"/>
    </record>
    <record id="group_network_manager" model="res.groups">
        <field name="name">Administrador de conectores sociales</field>
        <field name="privilege_id" ref="privilege_network_connector"/>
        <field name="implied_ids" eval="[(4, ref('group_network_user'))]"/>
    </record>
</odoo>
