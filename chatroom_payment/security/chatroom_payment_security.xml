<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_chatroom_payment" model="ir.module.category">
        <field name="name">Chatroom Pagos</field>
        <field name="sequence">21</field>
    </record>

    <record id="privilege_chatroom_payment" model="res.groups.privilege">
        <field name="name">Chatroom Pagos</field>
        <field name="category_id" ref="module_category_chatroom_payment"/>
    </record>

    <record id="group_chatroom_payment_agent" model="res.groups">
        <field name="name">Agente de pagos</field>
        <field name="privilege_id" ref="privilege_chatroom_payment"/>
    </record>

    <record id="group_chatroom_payment_manager" model="res.groups">
        <field name="name">Administrador de pagos</field>
        <field name="privilege_id" ref="privilege_chatroom_payment"/>
        <field name="implied_ids" eval="[(4, ref('group_chatroom_payment_agent')), (4, ref('chatroom_whatsapp.group_chatroom_manager'))]"/>
    </record>

    <record id="chatroom_whatsapp.group_chatroom_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_chatroom_payment_agent'))]"/>
    </record>

    <record id="chatroom_payment_link_rule_agent" model="ir.rule">
        <field name="name">Pagos de Chatroom: enlaces de sus conversaciones</field>
        <field name="model_id" ref="model_chatroom_payment_link"/>
        <field name="domain_force">['|', ('channel_id.assigned_user_id', '=', user.id), ('channel_id.whatsapp_number_id.member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('chatroom_whatsapp.group_chatroom_user')), (4, ref('group_chatroom_payment_agent'))]"/>
    </record>

    <record id="chatroom_payment_link_rule_manager" model="ir.rule">
        <field name="name">Pagos de Chatroom: administrador ve todos los enlaces</field>
        <field name="model_id" ref="model_chatroom_payment_link"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('chatroom_whatsapp.group_chatroom_manager')), (4, ref('group_chatroom_payment_manager'))]"/>
    </record>
</odoo>
