<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_payment_link_wizard_form" model="ir.ui.view">
        <field name="name">chatroom.payment.link.wizard.form</field>
        <field name="model">chatroom.payment.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar Link de Pago">
                <group>
                    <field name="channel_id" invisible="1"/>
                    <field name="channel_partner_id" invisible="1"/>
                    <field name="sale_order_id"/>
                </group>
                <separator string="O crear presupuesto con un producto"/>
                <group>
                    <field name="product_id" invisible="sale_order_id"/>
                    <field name="product_qty" invisible="sale_order_id or not product_id"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Generar y enviar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
