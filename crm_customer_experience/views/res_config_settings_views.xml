<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.customer.experience</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm_customer_intelligence.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='crm_customer_intelligence']" position="inside">
                <block title="Experiencia del cliente">
                    <setting id="experience_lifetime_setting" help="Define los años usados para proyectar el LTV; el valor por defecto es 3 años.">
                        <field name="experience_expected_lifetime_years"/>
                    </setting>
                    <setting id="experience_nps_invitation_setting" help="Crea una cola de invitaciones NPS después de detectar facturas pagadas.">
                        <field name="experience_auto_nps_invitation"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
