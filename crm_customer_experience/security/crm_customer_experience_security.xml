<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Aislamiento por empresa.

         Son reglas GLOBALES (sin `groups`) a proposito: Odoo une con OR
         las reglas de los grupos del usuario y aplica las globales con
         AND sobre el resultado. Puesta en un grupo, una regla por empresa
         se uniria con OR a las que ya existen -alguna con dominio
         `[('id', '!=', False)]`- y no aislaria nada.

         `company_id = False` significa "de todas las empresas" y por eso
         se deja pasar. -->
    <record id="crm_experience_snapshot_rule_company" model="ir.rule">
        <field name="name">Resumenes de experiencia: solo las de la empresa activa</field>
        <field name="model_id" ref="model_crm_experience_snapshot"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="crm_nps_invitation_rule_company" model="ir.rule">
        <field name="name">Invitaciones NPS: solo las de la empresa activa</field>
        <field name="model_id" ref="model_crm_nps_invitation"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="crm_nps_response_rule_company" model="ir.rule">
        <field name="name">Respuestas NPS: solo las de la empresa activa</field>
        <field name="model_id" ref="model_crm_nps_response"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
