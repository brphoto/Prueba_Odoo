<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="chatroom_whatsapp.ChatroomApp" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o_chatroom_app_list_name')]" position="after">
            <span t-if="channel.rfm_category and channel.rfm_category !== 'none'"
                  t-attf-class="badge o_chatroom_rfm_badge o_chatroom_rfm_badge_{{ channel.rfm_category }}"
                  t-esc="channel.rfm_category_label || channel.rfm_category.toUpperCase()"
                  title="Categoría RFM"/>
            <i t-if="channel.management_alert_state === 'red'"
               class="fa fa-circle o_chatroom_alert_dot o_chatroom_alert_dot_red"
               title="Oportunidad estancada"/>
            <i t-elif="channel.management_alert_state === 'yellow'"
               class="fa fa-clock-o o_chatroom_alert_dot o_chatroom_alert_dot_yellow"
               title="Sin gestión reciente"/>
        </xpath>
    </t>

    <t t-inherit="chatroom_whatsapp.ContactPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_chatroom_contact_name')]" position="after">
            <span t-if="state.data.rfm_category and state.data.rfm_category !== 'none'"
                  t-attf-class="badge o_chatroom_rfm_badge o_chatroom_rfm_badge_{{ state.data.rfm_category }}"
                  t-att-title="'Segmento RFM: ' + (state.data.rfm_category_label || state.data.rfm_category)"
                  t-esc="state.data.rfm_category_label || state.data.rfm_category.toUpperCase()"/>
        </xpath>
        <xpath expr="//div[hasclass('o_chatroom_contact_stats')]" position="after">
            <div class="o_chatroom_contact_commercial_snapshot"
                 t-if="state.data.rfm_category or state.data.commercial_total_sales or state.data.commercial_last_sale_date">
                <span t-if="state.data.rfm_category">
                    <i class="fa fa-diamond"/> RFM: <strong t-esc="state.data.rfm_category_label || state.data.rfm_category.toUpperCase()"/>
                </span>
                <span t-if="state.data.commercial_total_sales">
                    <i class="fa fa-line-chart"/> Compras: <strong t-esc="formatMoney(state.data.commercial_total_sales, state.data.currency_symbol)"/>
                </span>
                <span t-if="state.data.commercial_last_sale_date">
                    Última: <strong t-esc="formatCommercialDate(state.data.commercial_last_sale_date)"/>
                </span>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_chatroom_contact_actions')]" position="after">
            <div t-attf-class="o_chatroom_contact_docs o_chatroom_contact_intelligence {{ intel.panelOpen ? 'o_chatroom_contact_intelligence_open' : '' }}">
                <div class="o_chatroom_contact_section_header" role="button" tabindex="0"
                     t-att-aria-expanded="intel.panelOpen ? 'true' : 'false'"
                     t-on-click.stop="toggleIntelligencePanel"
                     t-on-keydown="(ev) => this.onIntelligenceHeaderKeydown(ev)">
                    <h6 class="mb-0"><i class="fa fa-line-chart"/> Inteligencia Comercial</h6>
                    <i t-attf-class="fa {{ intel.panelOpen ? 'fa-chevron-down' : 'fa-chevron-right' }}"/>
                </div>
                <ChatroomIntelligencePanel
                    t-if="intel.panelOpen"
                    open="intel.panelOpen"
                    embedded="true"
                    loading="intel.loading"
                    generating="intel.generating"
                    data="intel.data"
                    assignmentHistory="intel.assignmentHistory"
                    onClose="() => this.closeIntelligencePanel()"
                    onGenerateFollowup="() => this.generateCommercialFollowup()"/>
            </div>
        </xpath>
    </t>

</templates>
