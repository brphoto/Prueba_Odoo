<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="chatroom_whatsapp.ContactPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_chatroom_contact_stats')]" position="after">
            <div class="o_chatroom_contact_docs o_chatroom_active_opportunities"
                 t-if="state.data.crm_installed and state.data.active_opportunities.length">
                <div class="o_chatroom_contact_section_header" role="button" tabindex="0"
                     t-att-aria-expanded="state.collapsed.opportunities ? 'false' : 'true'"
                     t-on-click="() => this.toggleSection('opportunities')"
                     t-on-keydown="(ev) => this.onSectionHeaderKeydown(ev, 'opportunities')">
                    <h6 class="mb-0">
                        <i class="fa fa-line-chart"/> Oportunidades activas
                        <span class="o_chatroom_contact_section_count">
                            <t t-esc="state.data.active_opportunities.length"/>
                        </span>
                    </h6>
                    <i t-attf-class="fa {{ state.collapsed.opportunities ? 'fa-chevron-right' : 'fa-chevron-down' }}"/>
                </div>
                <t t-if="!state.collapsed.opportunities">
                    <t t-foreach="state.data.active_opportunities" t-as="lead" t-key="lead.id">
                        <div class="o_chatroom_contact_doc_row">
                            <span class="o_chatroom_contact_doc_name text-truncate o_chatroom_contact_doc_link"
                                  t-on-click="() => this.openRecord('crm.lead', lead.id)"
                                  title="Abrir oportunidad" t-esc="lead.name"/>
                            <span class="badge"
                                  t-attf-style="background-color: var(--o-color-{{ lead.stage_color || 0 }})"
                                  t-esc="lead.stage_name"/>
                            <small class="text-muted"><t t-esc="lead.probability"/>%</small>
                        </div>
                    </t>
                </t>
            </div>
        </xpath>
    </t>
</templates>
