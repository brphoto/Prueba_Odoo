<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-inherit="chatroom_whatsapp.ContactPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_chatroom_contact_stats')]" position="after">
            <div class="o_chatroom_contact_docs o_chatroom_active_opportunities"
                 t-if="state.data.crm_installed and state.data.active_opportunities.length">
                <div class="o_chatroom_contact_section_header">
                    <h6 class="mb-0"><i class="fa fa-line-chart"/> Oportunidades activas</h6>
                    <span class="o_chatroom_contact_section_count"
                          t-esc="state.data.active_opportunities.length"/>
                </div>
                <t t-foreach="state.data.active_opportunities" t-as="lead" t-key="lead.id">
                    <div class="o_chatroom_contact_doc_row">
                        <span class="o_chatroom_contact_doc_name text-truncate"
                              t-on-click="() => this.openRecord('crm.lead', lead.id)"
                              title="Abrir oportunidad" t-esc="lead.name"/>
                        <span class="badge" t-attf-style="background-color: var(--o-color-{{ lead.stage_color || 0 }})"
                              t-esc="lead.stage_name"/>
                        <small class="text-muted"><t t-esc="lead.probability"/>%</small>
                    </div>
                </t>
            </div>
        </xpath>
    </t>
</templates>
