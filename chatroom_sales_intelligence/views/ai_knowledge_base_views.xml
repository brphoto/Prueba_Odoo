<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_knowledge_base_list" model="ir.ui.view">
        <field name="name">ai.knowledge.base.list</field>
        <field name="model">ai.knowledge.base</field>
        <field name="arch" type="xml"><list>
            <field name="name"/><field name="pdf_filename"/><field name="chunk_count"/>
            <field name="state"/><field name="active" widget="boolean_toggle"/>
        </list></field>
    </record>
    <record id="view_ai_knowledge_base_form" model="ir.ui.view">
        <field name="name">ai.knowledge.base.form</field>
        <field name="model">ai.knowledge.base</field>
        <field name="arch" type="xml"><form string="Base de conocimiento IA">
            <header><button name="action_index" type="object" string="Indexar manual" class="btn-primary"/>
                <field name="state" widget="statusbar"/></header>
            <sheet><group><field name="name"/><field name="active"/>
                <field name="pdf_file" filename="pdf_filename"/><field name="pdf_filename" invisible="1"/>
                <field name="chunk_count" readonly="1"/><field name="processing_error" readonly="1"/></group>
                <field name="content_text" readonly="1" nolabel="1"/></sheet>
        </form></field>
    </record>
    <record id="action_ai_knowledge_base" model="ir.actions.act_window">
        <field name="name">Manuales de venta IA</field><field name="res_model">ai.knowledge.base</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_ai_knowledge_base" name="Manuales para IA"
              parent="menu_chatroom_commercial" action="action_ai_knowledge_base" sequence="30"/>
</odoo>
