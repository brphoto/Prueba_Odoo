<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chatroom_campaign_list" model="ir.ui.view">
        <field name="name">chatroom.campaign.list</field>
        <field name="model">chatroom.campaign</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="template_id"/>
                <field name="recipient_count"/>
                <field name="sent_count"/>
                <field name="pending_count"/>
                <field name="failed_count"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state == 'sending'"
                       decoration-success="state == 'sent'"/>
                <field name="sent_date"/>
            </list>
        </field>
    </record>

    <record id="view_chatroom_campaign_form" model="ir.ui.view">
        <field name="name">chatroom.campaign.form</field>
        <field name="model">chatroom.campaign</field>
        <field name="arch" type="xml">
            <form string="Campaña de WhatsApp">
                <header>
                    <button name="action_send" type="object" string="Encolar campaña"
                            class="btn-primary" invisible="state != 'draft'"
                            confirm="Se va a encolar la plantilla para todos los contactos que cumplan la segmentación elegida y se mandará en lotes. ¿Continuar?"/>
                    <button name="action_preview_audience" type="object" string="Previsualizar audiencia"
                            class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_retry_failed" type="object" string="Reintentar fallidos"
                            class="btn-secondary" invisible="failed_count == 0"
                            confirm="Se volverán a encolar únicamente los destinatarios fallidos. ¿Continuar?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej: Reactivación clientes categoría C"
                                   readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group string="Plantilla">
                            <field name="template_id" readonly="state != 'draft'"/>
                            <field name="batch_size" readonly="state != 'draft'"/>
                        </group>
                        <group string="Segmentación RFM">
                            <field name="target_category_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                            <field name="target_rfm_a" readonly="state != 'draft'"/>
                            <field name="target_rfm_b" readonly="state != 'draft'"/>
                            <field name="target_rfm_c" readonly="state != 'draft'"/>
                            <field name="recipient_count"/>
                        </group>
                    </group>
                    <group string="Resultado" invisible="state == 'draft'">
                <field name="queued_date"/>
                <field name="sent_date"/>
                <field name="queued_by"/>
                <field name="last_retry_at" invisible="not last_retry_at"/>
                <field name="last_retry_by" invisible="not last_retry_by"/>
                        <field name="sent_count"/>
                        <field name="pending_count"/>
                        <field name="failed_count"/>
                    </group>
                    <notebook invisible="state == 'draft'">
                        <page string="Destinatarios">
                            <field name="recipient_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="state" widget="badge"
                                           decoration-muted="state == 'pending'"
                                           decoration-success="state == 'sent'"
                                           decoration-danger="state == 'failed'"/>
                                    <field name="error_message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_chatroom_campaign" model="ir.actions.act_window">
        <field name="name">Campañas RFM</field>
        <field name="res_model">chatroom.campaign</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_chatroom_campaign" name="Campañas RFM"
              parent="menu_chatroom_commercial"
              action="action_chatroom_campaign"
              groups="chatroom_whatsapp.group_chatroom_manager"
              sequence="27"/>

</odoo>
