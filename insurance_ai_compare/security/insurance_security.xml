<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_insurance_compare" model="res.groups.privilege">
        <field name="name">Comparativo de seguros</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_insurance_compare_user" model="res.groups">
        <field name="name">Asesor</field>
        <field name="privilege_id" ref="privilege_insurance_compare"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_insurance_compare_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="privilege_insurance_compare"/>
        <field name="implied_ids" eval="[(4, ref('group_insurance_compare_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Aislamiento por empresa: reglas globales (se aplican a todos con AND). -->
    <record id="insurance_compare_rule_company" model="ir.rule">
        <field name="name">Comparativos: empresa activa</field>
        <field name="model_id" ref="model_insurance_compare"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="insurance_compare_offer_rule_company" model="ir.rule">
        <field name="name">Cotizaciones del comparativo: empresa activa</field>
        <field name="model_id" ref="model_insurance_compare_offer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="insurance_client_profile_rule_company" model="ir.rule">
        <field name="name">Perfiles de riesgo: empresa activa</field>
        <field name="model_id" ref="model_insurance_client_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="insurance_compare_template_rule_company" model="ir.rule">
        <field name="name">Plantillas de comparativo: empresa activa o compartidas</field>
        <field name="model_id" ref="model_insurance_compare_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
