<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_polizas_aseguradoras_list_ai" model="ir.ui.view">
        <field name="name">polizas.aseguradoras.list.ai</field>
        <field name="model">polizas.aseguradoras</field>
        <field name="arch" type="xml">
            <list>
                <field name="image_128" widget="image" options="{'size': [32, 32]}" string="Logo"/>
                <field name="name"/>
                <field name="service_score" string="Servicio (0-5)"/>
                <field name="compare_offer_count" string="Cotizaciones"/>
            </list>
        </field>
    </record>

    <record id="view_polizas_aseguradoras_form_ai" model="ir.ui.view">
        <field name="name">polizas.aseguradoras.form.ai</field>
        <field name="model">polizas.aseguradoras</field>
        <field name="arch" type="xml">
            <form string="Aseguradora">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_compare_offers" type="object" class="oe_stat_button" icon="fa-table">
                            <field name="compare_offer_count" widget="statinfo" string="Cotizaciones"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la aseguradora"/></h1>
                    </div>
                    <group>
                        <field name="service_score"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <group string="Cómo leer sus cotizaciones">
                        <field name="ai_extraction_hint" nolabel="1" colspan="2"
                               placeholder="Ej.: la prima total aparece como «Total a pagar»; el deducible está en la tabla de condiciones particulares."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
