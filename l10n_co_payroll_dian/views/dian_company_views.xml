<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_dian_payroll" model="ir.ui.view">
        <field name="name">res.company.form.dian.payroll</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="co_dian_payroll" string="Nómina electrónica DIAN">
                    <div class="o_dian_company_header">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <h2 class="mb-1">Nómina electrónica DIAN</h2>
                                <p class="text-muted mb-0">Configura una vez y opera desde el panel. Usa el asistente para cambiar cualquier parámetro.</p>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <button name="action_open_co_dian_setup" type="object" string="Configurar nómina DIAN" class="btn-primary"/>
                                <button name="action_open_co_dian_dashboard" type="object" string="Abrir panel DIAN" class="btn-secondary" invisible="not co_dian_payroll_enabled"/>
                            </div>
                        </div>
                        <group class="o_dian_activation_bar mt-3">
                            <field name="co_dian_payroll_enabled" string="Activar nómina electrónica" widget="boolean_toggle"/>
                        </group>
                        <div class="alert alert-warning mt-3 mb-0" role="alert" invisible="co_dian_payroll_enabled">Activa la nómina electrónica y completa el asistente para comenzar.</div>
                    </div>
                    <group class="o_dian_company_overview mt-3" invisible="not co_dian_payroll_enabled">
                        <group string="Estado actual">
                            <field name="co_dian_environment" string="Ambiente DIAN"/>
                            <field name="co_dian_habilitation_ready" string="Listo para producción" widget="badge"/>
                            <field name="co_dian_certificate_status" string="Certificado" widget="badge"/>
                            <field name="co_dian_certificate_expiration" string="Vencimiento"/>
                        </group>
                        <group string="Resumen operativo">
                            <field name="co_dian_document_count" string="Documentos"/>
                            <field name="co_dian_accepted_count" string="Aceptados"/>
                            <field name="co_dian_pending_count" string="Pendientes"/>
                            <field name="co_dian_error_count" string="Con error"/>
                        </group>
                    </group>
                    <div class="alert alert-info mt-3" role="status" invisible="not co_dian_payroll_enabled"><strong>¿Qué sigue?</strong> Crea un periodo, calcula y valida la nómina. El sistema generará el documento DIAN según la configuración guardada.</div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
