<odoo>
    <record id="view_co_payroll_dian_dashboard_form" model="ir.ui.view">
        <field name="name">l10n.co.payroll.dian.dashboard.form</field>
        <field name="model">l10n.co.payroll.dian.dashboard</field>
        <field name="arch" type="xml">
            <form string="Panel operativo DIAN" create="false" delete="false">
                <header>
                    <button name="action_refresh" type="object" string="Actualizar" class="oe_highlight"/>
                    <button name="action_open_documents" type="object" string="Ver documentos"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1>Panel de nómina electrónica DIAN</h1></div>
                    <group><field name="company_id"/><field name="environment"/><field name="date_from"/><field name="date_to"/></group>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_documents" type="object" class="oe_stat_button" icon="fa-files-o"><field name="total_count" widget="statinfo" string="Total"/></button>
                        <button name="action_open_accepted" type="object" class="oe_stat_button" icon="fa-check-circle"><field name="accepted_count" widget="statinfo" string="Aceptados"/></button>
                        <button name="action_open_pending" type="object" class="oe_stat_button" icon="fa-clock-o"><field name="pending_count" widget="statinfo" string="Pendientes"/></button>
                        <button name="action_open_errors" type="object" class="oe_stat_button" icon="fa-exclamation-triangle"><field name="error_count" widget="statinfo" string="Errores"/></button>
                    </div>
                    <group string="Estado DIAN">
                        <field name="accepted_count"/><field name="pending_count"/><field name="rejected_count"/><field name="error_count"/><field name="last_sync"/>
                    </group>
                    <group string="Habilitación">
                        <field name="habilitation_payroll_count"/><field name="habilitation_adjustment_count"/><field name="habilitation_ready" widget="badge"/>
                    </group>
                    <group string="Certificado">
                        <field name="certificate_status" widget="badge"/><field name="certificate_expiration"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_co_payroll_dian_setup_wizard_form" model="ir.ui.view">
        <field name="name">l10n.co.payroll.dian.setup.wizard.form</field>
        <field name="model">l10n.co.payroll.dian.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Asistente de configuración DIAN">
                <sheet>
                    <div class="oe_title"><h1>Configuración DIAN</h1></div>
                    <group string="Empresa"><field name="company_id" readonly="1"/><field name="enabled"/><field name="environment"/><field name="software_id"/><field name="software_pin" password="True"/><field name="test_set_id" invisible="environment != '2'"/></group>
                    <group string="Certificado"><field name="certificate" filename="certificate_filename"/><field name="certificate_filename" invisible="1"/><field name="certificate_password" password="True"/><field name="native_certificate_id"/></group>
                    <group string="Operación"><field name="auto_check"/><field name="require_habilitation"/><field name="require_explicit_mapping"/><field name="approval_mode"/></group>
                </sheet>
                <footer><button name="action_apply_and_validate" type="object" string="Guardar y validar" class="oe_highlight"/><button name="action_apply" type="object" string="Guardar"/><button special="cancel" string="Cancelar"/></footer>
            </form>
        </field>
    </record>
</odoo>
