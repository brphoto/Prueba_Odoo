<odoo>
    <record id="view_co_payroll_period_form_dian" model="ir.ui.view">
        <field name="name">l10n.co.payroll.period.form.dian</field>
        <field name="model">l10n.co.payroll.period</field>
        <field name="inherit_id" ref="l10n_co_payroll.view_co_payroll_period_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_generate_dian_documents" type="object" string="Generar nómina DIAN" invisible="state not in ('ready', 'closed')" groups="l10n_co_payroll.group_co_payroll_user"/>
                <button name="action_prevalidate_dian_documents" type="object" string="Prevalidar DIAN" invisible="dian_document_count == 0 or state not in ('ready', 'closed')" groups="l10n_co_payroll.group_co_payroll_user"/>
                <button name="action_send_dian_documents" type="object" string="Enviar nómina DIAN" class="oe_highlight" invisible="dian_state not in ('generated', 'draft')" groups="l10n_co_payroll.group_co_payroll_user"/>
                <button name="action_approve_dian_documents" type="object" string="Aprobar envíos" invisible="dian_document_count == 0" groups="l10n_co_payroll.group_co_payroll_manager"/>
                <button name="action_check_dian_status" type="object" string="Consultar DIAN" invisible="dian_pending_count == 0" groups="l10n_co_payroll.group_co_payroll_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_dian_documents" type="object" class="oe_stat_button" icon="fa-cloud-upload"><field name="dian_document_count" widget="statinfo" string="DIAN"/></button>
                <button name="action_export_dian_csv" type="object" class="oe_stat_button" icon="fa-download"><div class="o_stat_info"><span class="o_stat_text">Exportar</span><span class="o_stat_text">DIAN</span></div></button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="dian_electronic_payroll" string="Nómina electrónica DIAN">
                    <group><field name="dian_state" widget="badge"/><field name="dian_document_count"/><field name="dian_pending_count"/><field name="dian_rejected_count"/><field name="dian_attention_count"/><field name="dian_due_date"/><field name="dian_days_remaining"/><field name="dian_deadline_state" widget="badge"/></group>
                    <div class="o_dian_alert o_dian_alert_warning" invisible="dian_attention_count == 0"><span class="fa fa-exclamation-triangle" title="Requiere atención"/><span>Hay documentos DIAN que requieren atención antes de continuar.</span></div>
                    <field name="dian_document_ids" readonly="1"><list create="false" delete="false" decoration-danger="attention_level == 'danger'" decoration-warning="attention_level == 'warning'"><field name="name"/><field name="employee_id"/><field name="is_adjustment"/><field name="submission_environment" optional="hide"/><field name="attention_level" widget="badge"/><field name="attention_message" optional="hide"/><field name="preflight_state" widget="badge" optional="hide"/><field name="cune" optional="hide"/><field name="state" widget="badge"/><field name="status_code"/><field name="zip_key" optional="hide"/></list></field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_co_payroll_period_line_form_dian" model="ir.ui.view">
        <field name="name">l10n.co.payroll.period.line.form.dian</field>
        <field name="model">l10n.co.payroll.period.line</field>
        <field name="inherit_id" ref="l10n_co_payroll.view_co_payroll_period_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_dian_document" type="object" class="oe_stat_button" icon="fa-cloud-upload" invisible="dian_document_count == 0">
                    <field name="dian_document_count" widget="statinfo" string="DIAN"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='pila_status']" position="after">
                <field name="dian_document_id" readonly="1" invisible="dian_document_count == 0"/>
            </xpath>
        </field>
    </record>

    <record id="view_co_payroll_period_line_list_dian" model="ir.ui.view">
        <field name="name">l10n.co.payroll.period.line.list.dian</field>
        <field name="model">l10n.co.payroll.period.line</field>
        <field name="inherit_id" ref="l10n_co_payroll.view_co_payroll_period_line_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pila_status']" position="after">
                <field name="dian_document_count" optional="hide" string="Docs. DIAN"/>
            </xpath>
        </field>
    </record>
</odoo>
