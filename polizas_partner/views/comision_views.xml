<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===================== COMISIONES CXC ===================== -->

  <record id="view_comision_cxc_tree" model="ir.ui.view">
    <field name="name">comision.cxc.tree</field>
    <field name="model">comision.cxc</field>
    <field name="arch" type="xml">
      <list string="Liquidación CXC">
        <field name="name"/>
           <field name='aseguradora_id'/>
        <field name="fecha"/>
        <field name="total"/>
      </list>
    </field>
  </record>

  <record id="view_comision_cxc_form" model="ir.ui.view">
    <field name="name">comision.cxc.form</field>
    <field name="model">comision.cxc</field>
    <field name="arch" type="xml">
      <form string="Liquidación Comisiones por Cobrar (CXC)">
        <header>
          <button name="action_generar_orden_venta" string="Generar Orden de Venta"
                  type="object" class="btn-primary"
                  invisible="sale_order_id"/>
          <field name="sale_order_id" invisible="1"/>
          <button name="action_ver_orden_venta" string="Ver Orden de Venta"
                  type="object" class="btn-secondary"
                  invisible="not sale_order_id"/>
        </header>
        <sheet>
          <group>
            <field name="name" readonly="1"/>
            <field name='aseguradora_id' options="{'no_create': True}"/>
            <field name="fecha"/>
          </group>

          <group string="Detalle de Pólizas">
            <field name="poliza_ids" widget="many2many_tags" options="{'no_create': True}" domain="[('aseguradora_id', '=', aseguradora_id),('comision_cxc_id','=',False)]"/>
            <field name="total" readonly="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_comision_cxc" model="ir.actions.act_window">
    <field name="name">Liquidación Comisiones CXC</field>
    <field name="res_model">comision.cxc</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p>Desde aquí puedes registrar las comisiones por cobrar (CXC) derivadas de pólizas.</p>
    </field>
  </record>

  <menuitem id="menu_comision_cxc"
            name="Comisiones CXC"
            parent="menu_polizas"
            action="action_comision_cxc"/>

  <!-- ===================== COMISIONES CXP ===================== -->

  <record id="view_comision_cxp_tree" model="ir.ui.view">
    <field name="name">comision.cxp.tree</field>
    <field name="model">comision.cxp</field>
    <field name="arch" type="xml">
      <list string="Liquidación CXP">
        <field name="name"/>
        <field name="executive_id"/>
        <field name="fecha_pago"/>
        <field name="valor_total"/>
      </list>
    </field>
  </record>

  <record id="view_comision_cxp_form" model="ir.ui.view">
    <field name="name">comision.cxp.form</field>
    <field name="model">comision.cxp</field>
    <field name="arch" type="xml">
      <form string="Liquidación Comisiones por Pagar (CXP)">
        <header>
          <button name="action_generar_orden_compra" string="Generar Orden de Compra"
                  type="object" class="btn-primary"
                  invisible="purchase_order_id"/>
          <field name="purchase_order_id" invisible="1"/>
          <button name="action_ver_orden_compra" string="Ver Orden de Compra"
                  type="object" class="btn-secondary"
                  invisible="not purchase_order_id"/>
        </header>
        <sheet>
          <group>
            <field name="name" readonly="1"/>
           <!--  <field name="ejecutivo_id"/> -->
            <field name="executive_id" options="{'no_create': False}"/>
            <field name="fecha_pago"/>
          </group>

          <group string="Detalle de Pólizas">
            <field name="poliza_ids" widget="many2many_tags" domain="[('ramo_id', '=', executive_id),('comision_cxp_id','=',False)]" options="{'no_create': True}"/>
            <field name="valor_total" readonly="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_comision_cxp" model="ir.actions.act_window">
    <field name="name">Liquidación Ejecutivos CXP</field>
    <field name="res_model">comision.cxp</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p>Desde aquí puedes registrar las comisiones por pagar (CXP) a ejecutivos de pólizas.</p>
    </field>
  </record>

  <menuitem id="menu_comision_cxp"
            name="Comisiones CXP"
            parent="menu_polizas"
            action="action_comision_cxp"/>

</odoo>
