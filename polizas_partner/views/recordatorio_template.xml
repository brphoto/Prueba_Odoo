<odoo>
    <record id="view_polizas_recordatorio_template_form" model="ir.ui.view">
        <field name="name">polizas.recordatorio.template.form</field>
        <field name="model">polizas.recordatorio.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="forma_pago"/>
                        <field name="is_welcome"/>
                        <field name="is_birthday"/>
                        <field name="is_close"/>
                        <field name="is_monthly"/>
                        <field name='is_installment'/>
                        <field name="is_renewal"/>
                       <!--  <field name="stage_id"/> -->
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_polizas_recordatorio_template_tree" model="ir.ui.view">
        <field name="name">polizas.recordatorio.template.tree</field>
        <field name="model">polizas.recordatorio.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                 <field name="is_welcome"/>
                 <field name="is_birthday"/>
                 <field name="is_close"/>
                 <field name="is_monthly"/>
                <field name="forma_pago"/>
                <field name="message"/>
              <!--   <field name="stage_id"/> -->
            </list>
        </field>
    </record>

    


    <record id="action_polizas_recordatorio_template" model="ir.actions.act_window">
        <field name="name">Plantillas Recordatorio</field>
        <field name="res_model">polizas.recordatorio.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
