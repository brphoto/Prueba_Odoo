<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <!-- Secuencia para Comisiones por Cobrar -->
        <record id="seq_comision_cxc" model="ir.sequence">
            <field name="name">Comisión CxC</field>
            <field name="code">comision.cxc</field>
            <field name="prefix">LQ-CXC/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <!-- Secuencia para Comisiones por Pagar -->
        <record id="seq_comision_cxp" model="ir.sequence">
            <field name="name">Comisión CxP</field>
            <field name="code">comision.cxp</field>
            <field name="prefix">LQ-CXP/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

    </data>

</odoo>
