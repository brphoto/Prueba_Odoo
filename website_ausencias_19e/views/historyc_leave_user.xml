<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sub-item del menú "Mi portal", ver nota en website_form.xml -->
    <record id="menu_leave_user" model="website.menu">
        <field name="name">Mis Ausencias</field>
        <field name="url">/leave/user</field>
        <field name="parent_id" ref="website_ausencias_19e.menu_portal_home" />
        <field name="sequence" type="int">26</field>
    </record>

    <!-- Faltaba: /calendar/leave la renderizaba pero nunca se había definido
         (la ruta además estaba rota por un método Python duplicado, ver
         controllers.py). Sin esta plantilla, "Calendario del equipo" daba
         error 500 en cuanto se corrigiera la ruta. -->
    <template id="leave_list_all" name="Calendario del equipo">
        <t t-call="website.layout">
            <div class="ea-page">
                <div class="container">
                    <t t-call="website_ausencias_19e.portal_topbar">
                        <t t-set="active" t-value="'equipo'"/>
                    </t>

                    <div class="ea-card">
                        <h2>Calendario del equipo</h2>
                        <div class="ea-subtitle">Últimas ausencias aprobadas de tus compañeros</div>

                        <t t-if="not values">
                            <div class="ea-empty">
                                <i class="fa fa-users"/>
                                No hay ausencias aprobadas registradas por el momento.
                            </div>
                        </t>

                        <t t-if="values">
                            <div class="table-responsive">
                                <table class="table ea-table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Empleado</th>
                                            <th>Área</th>
                                            <th>Tipo</th>
                                            <th>Periodo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="values" t-as="order">
                                            <tr>
                                                <td><t t-esc="order.employee_id.name"/></td>
                                                <td><t t-esc="order.department_id.name"/></td>
                                                <td><t t-esc="order.holiday_status_id.name"/></td>
                                                <td>
                                                    <span t-field="order.request_date_from" t-options="{'widget': 'date'}"/> -
                                                    <span t-field="order.request_date_to" t-options="{'widget': 'date'}"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="leave_list" name="Ausencias por Empleado">
        <t t-call="website.layout">
            <div class="ea-page">
                <div class="container">
                    <t t-call="website_ausencias_19e.portal_topbar">
                        <t t-set="active" t-value="'ausencias'"/>
                    </t>

                    <div class="row mb-1">
                        <div class="col-md-4" t-foreach="historic" t-as="bal">
                            <div class="ea-card">
                                <h2 t-esc="bal['name']"/>
                                <div class="ea-stat-value" t-esc="bal['res']"/>
                                <div class="ea-stat-label">días disponibles de <t t-esc="bal['total']"/></div>
                                <div class="ea-progress">
                                    <t t-set="pct" t-value="bal['total'] and min(100, round((bal['value'] / bal['total']) * 100)) or 0"/>
                                    <div t-attf-style="width: #{pct}%;"/>
                                </div>
                                <div class="text-muted small mt-2">
                                    <t t-esc="bal['value']"/> día(s) ya utilizados
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="ea-card">
                        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                            <div>
                                <h2 class="mb-0">Mis solicitudes de ausencia</h2>
                                <div class="ea-subtitle mb-0">Incluye pendientes, aprobadas y rechazadas</div>
                            </div>
                            <a href="/customer/form" class="btn btn-primary btn-sm"><i class="fa fa-plus me-1"/> Nueva solicitud</a>
                        </div>

                        <form action="/leave/user" method="get" class="row g-2 align-items-end mb-3">
                            <div class="col-auto">
                                <label class="form-label small text-muted mb-1">Año</label>
                                <select name="anio" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="">Todos</option>
                                    <t t-foreach="anios_disponibles" t-as="y">
                                        <option t-att-value="y" t-att-selected="str(y) == anio"><t t-esc="y"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-auto">
                                <label class="form-label small text-muted mb-1">Estado</label>
                                <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="">Todos</option>
                                    <option value="confirm" t-att-selected="estado == 'confirm'">Pendiente</option>
                                    <option value="validate1" t-att-selected="estado == 'validate1'">En 2da aprobación</option>
                                    <option value="validate" t-att-selected="estado == 'validate'">Aprobado</option>
                                    <option value="refuse" t-att-selected="estado == 'refuse'">Rechazado</option>
                                </select>
                            </div>
                            <div class="col-auto" t-if="anio or estado">
                                <a href="/leave/user" class="btn btn-sm btn-outline-secondary">Quitar filtros</a>
                            </div>
                        </form>

                        <t t-if="not values">
                            <div class="ea-empty">
                                <i class="fa fa-calendar-o"/>
                                Todavía no has registrado ninguna ausencia.
                            </div>
                        </t>

                        <t t-if="values">
                            <div class="table-responsive">
                                <table class="table ea-table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Tipo</th>
                                            <th>Periodo</th>
                                            <th class="text-center">Días</th>
                                            <th class="text-center">Estado</th>
                                            <th class="text-end">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="values" t-as="order">
                                            <tr>
                                                <td><t t-esc="order.holiday_status_id.name"/></td>
                                                <td>
                                                    <span t-field="order.request_date_from" t-options="{'widget': 'date'}"/> -
                                                    <span t-field="order.request_date_to" t-options="{'widget': 'date'}"/>
                                                </td>
                                                <td class="text-center"><t t-esc="order.number_of_days"/></td>
                                                <td class="text-center">
                                                    <t t-call="website_ausencias_19e.leave_status_badge">
                                                        <t t-set="lv" t-value="order"/>
                                                    </t>
                                                </td>
                                                <td class="text-end">
                                                    <form t-if="order.state in ('confirm',)" t-attf-action="/leave/cancel/#{order.id}" method="post" class="d-inline">
                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                        <button type="submit" class="btn btn-sm ea-btn-cancel" onclick="return confirm('¿Cancelar esta solicitud?');">
                                                            <i class="fa fa-times"/> Cancelar
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>

                        <t t-if="pager">
                            <div class="mt-3">
                                <t t-call="website.pager"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
