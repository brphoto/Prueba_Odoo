<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sub-item del menú "Mi portal", ver nota en website_form.xml -->
    <record id="menu_loan_request" model="website.menu">
        <field name="name">Anticipos y Préstamos</field>
        <field name="url">/loan/user</field>
        <field name="parent_id" ref="website_ausencias_19e.menu_portal_home"/>
        <field name="sequence" type="int">27</field>
    </record>

    <template id="loan_request_template" name="Solicitar anticipo o préstamo">
        <t t-call="website.layout">
            <div class="ea-page">
                <div class="container">
                    <t t-call="website_ausencias_19e.portal_topbar">
                        <t t-set="active" t-value="'prestamos'"/>
                    </t>

                    <div class="ea-card ea-form">
                        <h2><i class="fa fa-money me-1"/> Solicitar anticipo o préstamo</h2>
                        <div class="ea-subtitle">Tu solicitud se enviará a RRHH para revisión y aprobación.</div>

                        <t t-if="error">
                            <div class="alert alert-danger d-flex align-items-center gap-2">
                                <i class="fa fa-exclamation-triangle"/>
                                <strong t-esc="error"/>
                            </div>
                        </t>

                        <form action="/loan/request/submit" method="post" class="oe_import">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Motivo</label>
                                    <input type="text" class="form-control" name="motivo" required="required"
                                           placeholder="Describe brevemente para qué necesitas el anticipo/préstamo"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Monto solicitado (USD)</label>
                                    <input type="number" step="0.01" min="0.01" class="form-control" name="amount" required="required"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Número de cuotas</label>
                                    <input type="number" step="1" min="1" class="form-control" name="dues" value="1" required="required"/>
                                    <div class="form-text">El monto se descontará en partes iguales en tus próximos roles de pago.</div>
                                </div>
                            </div>
                            <div class="mt-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary"><i class="fa fa-paper-plane me-1"/> Enviar solicitud</button>
                                <a href="/loan/user" class="btn btn-outline-secondary">Ver mis solicitudes</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="loan_request_success_template" name="Solicitud de anticipo enviada">
        <t t-call="website.layout">
            <div class="ea-page">
                <div class="container" style="max-width: 560px;">
                    <div class="ea-card text-center py-5">
                        <div style="font-size: 48px; color: #1a7f3c;"><i class="fa fa-check-circle"/></div>
                        <h2 class="mt-3">¡Solicitud enviada!</h2>
                        <p class="text-muted">RRHH revisará tu solicitud de anticipo/préstamo a la brevedad.</p>
                        <div class="mt-4 d-flex gap-2 justify-content-center">
                            <a href="/loan/user" class="btn btn-primary">Ver mis solicitudes</a>
                            <a href="/portal/inicio" class="btn btn-outline-secondary">Volver al inicio</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="loan_user_template" name="Mis anticipos y préstamos">
        <t t-call="website.layout">
            <div class="ea-page">
                <div class="container">
                    <t t-call="website_ausencias_19e.portal_topbar">
                        <t t-set="active" t-value="'prestamos'"/>
                    </t>

                    <div class="ea-card">
                        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                            <div>
                                <h2 class="mb-0">Mis anticipos y préstamos</h2>
                                <div class="ea-subtitle mb-0">Historial y estado de tus solicitudes</div>
                            </div>
                            <a href="/loan/request" class="btn btn-primary btn-sm"><i class="fa fa-plus me-1"/> Nueva solicitud</a>
                        </div>

                        <t t-if="not values">
                            <div class="ea-empty">
                                <i class="fa fa-money"/>
                                Todavía no has solicitado ningún anticipo o préstamo.
                            </div>
                        </t>

                        <t t-if="values">
                            <div class="table-responsive">
                                <table class="table ea-table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Motivo</th>
                                            <th class="text-end">Monto</th>
                                            <th class="text-center">Cuotas</th>
                                            <th class="text-center">Estado</th>
                                            <th>Fecha</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="values" t-as="loan">
                                            <tr>
                                                <td><t t-esc="loan.name"/></td>
                                                <td class="text-end"><span t-field="loan.amount" t-options="{'widget': 'monetary', 'display_currency': loan.employee_id.company_id.currency_id}"/></td>
                                                <td class="text-center"><t t-esc="loan.dues"/></td>
                                                <td class="text-center">
                                                    <span t-if="loan.state == 'draft'" class="ea-badge ea-badge-warning"><i class="fa fa-clock-o"/> Pendiente</span>
                                                    <span t-elif="loan.state == 'approved'" class="ea-badge ea-badge-info"><i class="fa fa-check"/> Aprobado</span>
                                                    <span t-elif="loan.state == 'paid'" class="ea-badge ea-badge-success"><i class="fa fa-check-circle"/> Pagado</span>
                                                    <span t-else="" class="ea-badge ea-badge-secondary" t-esc="loan.state"/>
                                                </td>
                                                <td><span t-field="loan.application_date" t-options="{'widget': 'date'}"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>

                        <t t-if="pager">
                            <div class="mt-3">
                                <t t-call="website.pager"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
