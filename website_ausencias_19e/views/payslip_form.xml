<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sub-item del menú "Mi portal", ver nota en website_form.xml -->
    <record id="menu_payslip_form" model="website.menu">
        <field name="name">Roles de Pago</field>
        <field name="url">/payslip/form</field>
        <field name="parent_id" ref="website_ausencias_19e.menu_portal_home"/>
        <field name="sequence" type="int">23</field>
    </record>

    <template id="payslips_reports" name="Nóminas de empleados Empleados">
        <t t-call="website.layout">
            <div class="ea-page">
                <div class="container">
                    <t t-call="website_ausencias_19e.portal_topbar">
                        <t t-set="active" t-value="'roles'"/>
                    </t>

                    <div class="ea-card">
                        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                            <div>
                                <h2 class="mb-0">Mis roles de pago</h2>
                                <div class="ea-subtitle mb-0">Descarga el PDF de cualquiera de tus recibos confirmados</div>
                            </div>
                            <a href="/employee/certificate" target="_blank" class="btn btn-outline-primary btn-sm">
                                <i class="fa fa-certificate me-1"/> Certificado laboral
                            </a>
                        </div>

                        <form action="/payslip/form" method="get" class="row g-2 align-items-end mb-3" t-if="anios_disponibles">
                            <div class="col-auto">
                                <label class="form-label small text-muted mb-1">Año</label>
                                <select name="anio" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="">Todos</option>
                                    <t t-foreach="anios_disponibles" t-as="y">
                                        <option t-att-value="y" t-att-selected="str(y) == anio"><t t-esc="y"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-auto" t-if="anio">
                                <a href="/payslip/form" class="btn btn-sm btn-outline-secondary">Quitar filtro</a>
                            </div>
                        </form>

                        <t t-if="not values">
                            <div class="ea-empty">
                                <i class="fa fa-file-o"/>
                                Todavía no tienes roles de pago disponibles.
                            </div>
                        </t>

                        <t t-if="values">
                            <div class="table-responsive">
                                <table class="table ea-table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>
                                                <span class='d-none d-md-inline'>Nómina #</span>
                                                <span class='d-block d-md-none'>Ref.</span>
                                            </th>
                                            <th>Periodo</th>
                                            <th class="text-center">Estado</th>
                                            <th class="text-end">Descargar</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="values" t-as="order">
                                            <tr>
                                                <td><t t-esc="order.name"/></td>
                                                <td>
                                                    <span t-field="order.date_from" t-options="{'widget': 'date'}"/> -
                                                    <span t-field="order.date_to" t-options="{'widget': 'date'}"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-if="order.state in ('validated', 'paid')" class="ea-badge ea-badge-success">
                                                        <i class="fa fa-check"/> Confirmado
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <a t-attf-href="/report/#{order.id}" target="_blank" class="btn btn-primary btn-sm">
                                                        <i class="fa fa-download"/> Ver PDF
                                                    </a>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>

                        <t t-if="pager">
                            <div class="mt-3">
                                <t t-call="website.pager"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
