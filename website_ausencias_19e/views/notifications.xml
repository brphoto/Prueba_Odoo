<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="notifications_template" name="Notificaciones">
        <t t-call="website.layout">
            <div class="ea-page">
                <div class="container">
                    <t t-call="website_ausencias_19e.portal_topbar">
                        <t t-set="active" t-value="'notificaciones'"/>
                    </t>

                    <div class="ea-card">
                        <h2><i class="fa fa-bell me-1"/> Notificaciones</h2>
                        <div class="ea-subtitle">Actualizaciones de tus solicitudes de los últimos 30 días</div>

                        <t t-if="not items">
                            <div class="ea-empty">
                                <i class="fa fa-bell-o"/>
                                No tienes notificaciones recientes.
                            </div>
                        </t>

                        <t t-if="items">
                            <div class="list-group list-group-flush">
                                <t t-foreach="items" t-as="item">
                                    <a t-att-href="item['url']" class="list-group-item list-group-item-action d-flex align-items-start gap-3 px-0 py-3">
                                        <i t-attf-class="fa #{item['icon']} mt-1" style="font-size: 18px; width: 20px;"/>
                                        <div class="flex-grow-1">
                                            <div style="font-weight: 600;" t-esc="item['title']"/>
                                            <div class="text-muted small" t-esc="item['description']"/>
                                        </div>
                                        <div class="text-muted small text-nowrap" t-esc="item['date'].strftime('%d/%m/%Y')"/>
                                    </a>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
