<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_chatroom_ai" model="ir.module.category">
        <field name="name">Chatroom IA</field><field name="sequence">24</field>
    </record>
    <record id="privilege_chatroom_ai" model="res.groups.privilege">
        <field name="name">Chatroom IA</field><field name="category_id" ref="module_category_chatroom_ai"/>
    </record>
    <record id="group_chatroom_ai_user" model="res.groups">
        <field name="name">Agente IA</field><field name="privilege_id" ref="privilege_chatroom_ai"/>
    </record>
    <record id="group_chatroom_ai_manager" model="res.groups">
        <field name="name">Administrador IA</field><field name="privilege_id" ref="privilege_chatroom_ai"/>
        <field name="implied_ids" eval="[(4, ref('group_chatroom_ai_user'))]"/>
    </record>
    <record id="chatroom_ai_suggestion_rule_user" model="ir.rule">
        <field name="name">Sugerencias IA asignadas al agente</field>
        <field name="model_id" ref="model_chatroom_ai_suggestion"/>
        <field name="domain_force">['|', ('channel_id.assigned_user_id', '=', user.id), ('channel_id.assigned_user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_user'))]"/>
    </record>
    <record id="chatroom_ai_suggestion_rule_chatroom_user" model="ir.rule">
        <field name="name">Sugerencias IA del agente de Chatroom</field>
        <field name="model_id" ref="model_chatroom_ai_suggestion"/>
        <field name="domain_force">['|', ('channel_id.assigned_user_id', '=', user.id), ('channel_id.assigned_user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('chatroom_whatsapp.group_chatroom_user'))]"/>
    </record>
    <record id="chatroom_ai_suggestion_rule_manager" model="ir.rule">
        <field name="name">Administrador IA: todas las sugerencias</field>
        <field name="model_id" ref="model_chatroom_ai_suggestion"/>
        <field name="domain_force">[('id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_manager'))]"/>
    </record>
</odoo>
