<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_chatroom_ai" model="ir.module.category">
        <field name="name">Chatroom IA</field><field name="sequence">24</field>
    </record>
    <record id="privilege_chatroom_ai" model="res.groups.privilege">
        <field name="name">Chatroom IA</field><field name="category_id" ref="module_category_chatroom_ai"/>
    </record>
    <record id="group_chatroom_ai_user" model="res.groups">
        <field name="name">Agente IA</field><field name="privilege_id" ref="privilege_chatroom_ai"/>
    </record>
    <record id="group_chatroom_ai_manager" model="res.groups">
        <field name="name">Administrador IA</field><field name="privilege_id" ref="privilege_chatroom_ai"/>
        <field name="implied_ids" eval="[(4, ref('group_chatroom_ai_user'))]"/>
    </record>
    <!-- El administrador tecnico debe poder usar y probar las sugerencias IA
         sin tener que asignarse manualmente el grupo funcional. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_chatroom_ai_manager'))]"/>
    </record>
    <record id="chatroom_ai_suggestion_rule_user" model="ir.rule">
        <field name="name">Sugerencias IA asignadas al agente</field>
        <field name="model_id" ref="model_chatroom_ai_suggestion"/>
        <field name="domain_force">['&amp;', ('channel_id.company_id', 'in', company_ids), '|', ('channel_id.assigned_user_id', '=', user.id), ('channel_id.whatsapp_number_id.member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_user'))]"/>
    </record>
    <record id="chatroom_ai_suggestion_rule_chatroom_user" model="ir.rule">
        <field name="name">Sugerencias IA del agente de Chatroom</field>
        <field name="model_id" ref="model_chatroom_ai_suggestion"/>
        <field name="domain_force">['&amp;', ('channel_id.company_id', 'in', company_ids), '|', ('channel_id.assigned_user_id', '=', user.id), ('channel_id.whatsapp_number_id.member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('chatroom_whatsapp.group_chatroom_user'))]"/>
    </record>
    <!-- Las sugerencias siguen la visibilidad de su conversación: el agente
         ve las de las conversaciones asignadas a él o de sus líneas, sin
         cruzarse con otros números. Supervisores, todas las de su compañía. -->
    <record id="chatroom_ai_suggestion_rule_supervisor" model="ir.rule">
        <field name="name">Supervisor de Chatroom: sugerencias IA de su compañía</field>
        <field name="model_id" ref="model_chatroom_ai_suggestion"/>
        <field name="domain_force">[('channel_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('chatroom_whatsapp.group_chatroom_supervisor'))]"/>
    </record>
    <record id="chatroom_ai_suggestion_rule_manager" model="ir.rule">
        <field name="name">Administrador IA: todas las sugerencias</field>
        <field name="model_id" ref="model_chatroom_ai_suggestion"/>
        <field name="domain_force">[('id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_manager'))]"/>
    </record>
    <!-- Acciones de IA: cada empresa ve las suyas y las compartidas (sin empresa). -->
    <record id="chatroom_ai_quick_action_rule_company" model="ir.rule">
        <field name="name">Acciones de IA: empresa activa o compartidas</field>
        <field name="model_id" ref="model_chatroom_ai_quick_action"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
