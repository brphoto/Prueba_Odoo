<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_ai_suggestion_list" model="ir.ui.view">
        <field name="name">chatroom.ai.suggestion.list</field><field name="model">chatroom.ai.suggestion</field>
        <field name="arch" type="xml"><list string="Sugerencias de IA">
            <field name="create_date"/><field name="channel_id"/><field name="partner_id"/>
            <field name="intent" widget="badge"/><field name="confidence"/><field name="edited_by_human" optional="hide"/>
            <field name="state" widget="badge"/><field name="approved_by"/><field name="sent_at"/>
        </list></field>
    </record>
    <record id="view_chatroom_ai_suggestion_form" model="ir.ui.view">
        <field name="name">chatroom.ai.suggestion.form</field><field name="model">chatroom.ai.suggestion</field>
        <field name="arch" type="xml"><form string="Sugerencia de IA">
            <header>
                <button name="action_generate" type="object" string="Regenerar" class="btn-secondary" invisible="state == 'sent'"/>
                <button name="action_approve" type="object" string="Aprobar" class="btn-primary" invisible="state != 'draft'"/>
                <button name="action_send" type="object" string="Enviar al cliente" class="btn-primary" invisible="state != 'approved'"/>
                <button name="action_reject" type="object" string="Descartar" class="btn-secondary" invisible="state in ('sent', 'rejected')"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,approved,sent"/>
            </header><sheet>
                <div class="oe_title"><h1><field name="name"/></h1></div>
                <group><group><field name="channel_id"/><field name="partner_id"/><field name="source"/><field name="source_detail"/></group>
                    <group><field name="intent"/><field name="confidence"/><field name="edited_by_human"/><field name="edit_count"/><field name="last_reviewed_at"/><field name="approved_by"/><field name="sent_by"/></group></group>
                <group string="Respuesta editable"><field name="suggested_text" nolabel="1"/></group>
                <group string="Contexto y trazabilidad"><field name="message_context" readonly="1"/><field name="rejection_reason"/><field name="error_message" readonly="1"/></group>
            </sheet>
        </form></field>
    </record>
    <record id="action_chatroom_ai_suggestion" model="ir.actions.act_window">
        <field name="name">Sugerencias de IA</field><field name="res_model">chatroom.ai.suggestion</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_chatroom_ai_suggestion" name="Sugerencias de IA" parent="chatroom_whatsapp.menu_chatroom_communication" action="action_chatroom_ai_suggestion" sequence="35" groups="chatroom_ai.group_chatroom_ai_user"/>
    <record id="view_chatroom_channel_form_ai" model="ir.ui.view">
        <field name="name">chatroom.channel.form.ai.controlled</field><field name="model">chatroom.channel</field>
        <field name="inherit_id" ref="chatroom_whatsapp.view_chatroom_channel_form"/>
        <field name="arch" type="xml"><xpath expr="//header/button[@name='action_ai_suggest_reply']" position="before">
            <button name="action_create_ai_suggestion" type="object" string="Crear borrador IA" class="btn-secondary" invisible="not id" groups="chatroom_ai.group_chatroom_ai_user"/>
        </xpath></field>
    </record>
</odoo>
