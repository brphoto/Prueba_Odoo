<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="chatroom_whatsapp.ChatroomThreadCore" t-inherit-mode="extension">
        <!-- Menú de acciones de IA: se abre con ✨ o escribiendo "/".
             Ancla con clase fija: la barra del compositor usa t-attf-class y
             la herencia de plantillas no la encuentra por clase. -->
        <xpath expr="//div[hasclass('o_chatroom_mentions_menu')]" position="after">
            <div class="o_chatroom_ai_quick_menu" role="listbox"
                 aria-label="Acciones de IA"
                 t-if="(aiQuick.menuOpen or aiQuick.slashOpen) and state.aiAvailable and !state.noteMode">
                <div class="o_chatroom_ai_quick_menu_title">
                    <span><i class="fa fa-magic me-1"/>Acciones de IA</span>
                    <small class="text-muted">↑↓ para elegir · Enter para usar · Esc para cerrar</small>
                </div>
                <t t-set="aiVisibleActions" t-value="aiQuickVisibleActions()"/>
                <div class="o_chatroom_ai_quick_empty text-muted" t-if="!aiVisibleActions.length">
                    <t t-if="aiQuick.actions.length">Ninguna acción coincide con «/<t t-esc="aiQuick.filter"/>».</t>
                    <t t-else="">No hay acciones de IA disponibles en esta línea.</t>
                </div>
                <button type="button" role="option"
                        t-foreach="aiVisibleActions" t-as="aiAction" t-key="aiAction.id"
                        t-att-aria-selected="aiAction_index === aiQuick.index ? 'true' : 'false'"
                        t-attf-class="o_chatroom_ai_quick_item {{ aiAction_index === aiQuick.index ? 'o_active' : '' }}"
                        t-on-mouseenter="() => aiQuick.index = aiAction_index"
                        t-on-mousedown.prevent=""
                        t-on-click="() => this.chooseAiQuickAction(aiAction)">
                    <i t-attf-class="fa {{ aiAction.icon }} o_chatroom_ai_quick_icon"/>
                    <span class="o_chatroom_ai_quick_text">
                        <span class="o_chatroom_ai_quick_name">
                            <t t-esc="aiAction.name"/>
                            <span class="o_chatroom_ai_quick_shortcut" t-if="aiAction.shortcut">/<t t-esc="aiAction.shortcut"/></span>
                        </span>
                        <small class="o_chatroom_ai_quick_desc" t-if="aiAction.description" t-esc="aiAction.description"/>
                    </span>
                    <span class="o_chatroom_ai_quick_mode" t-esc="aiQuickModeLabel(aiAction)"/>
                </button>
            </div>
        </xpath>
        <xpath expr="//textarea[hasclass('o_chatroom_composer_textarea')]" position="before">
            <button t-if="state.aiAvailable and !state.noteMode"
                    type="button"
                    t-attf-class="btn btn-link o_chatroom_attach_btn o_chatroom_ai_quick_btn {{ aiQuick.menuOpen ? 'text-primary' : '' }}"
                    title="Acciones de IA (también puedes escribir / en el mensaje)"
                    aria-label="Acciones de IA"
                    t-att-aria-expanded="aiQuick.menuOpen ? 'true' : 'false'"
                    t-att-disabled="aiQuick.busy"
                    t-on-click="toggleAiQuickMenu">
                <i t-if="aiQuick.busy" class="fa fa-spinner fa-spin"/>
                <i t-else="" class="fa fa-magic"/>
            </button>
        </xpath>
    </t>
</templates>
