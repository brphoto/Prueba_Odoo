<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="chatroom_whatsapp.ContactPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_chatroom_contact_actions_block')]" position="before">
            <div t-attf-class="o_chatroom_contact_docs o_chatroom_ai_assistant {{ aiAssistant.open ? 'o_chatroom_ai_assistant_open' : '' }}">
                <div class="o_chatroom_contact_section_header" role="button" tabindex="0"
                     t-att-aria-expanded="aiAssistant.open ? 'true' : 'false'"
                     t-on-click.stop="toggleAiAssistant"
                     t-on-keydown="onAiAssistantHeaderKeydown">
                    <h6 class="mb-0"><i class="fa fa-magic"/> Asistente IA
                        <span class="o_chatroom_ai_assistant_status" t-if="aiAssistant.suggestion">
                            · <t t-esc="suggestionStateLabel()"/>
                        </span>
                    </h6>
                    <i t-attf-class="fa {{ aiAssistant.open ? 'fa-chevron-down' : 'fa-chevron-right' }}"/>
                </div>
                <div class="o_chatroom_ai_assistant_body" t-if="aiAssistant.open">
                    <div class="alert alert-danger py-1 px-2 mb-2" t-if="aiAssistant.aiPaused">
                        <i class="fa fa-pause"/> IA pausada por seguridad o por atencion humana. Reactivala desde el control de la conversacion despues de revisar el caso.
                    </div>
                    <div class="alert alert-warning py-2 px-2 mb-2" t-if="!aiAssistant.providerReady and !aiAssistant.loading">
                        Configura el proveedor en Ajustes de Chatroom WhatsApp para consultar IA.
                    </div>
                    <div class="alert alert-danger py-2 px-2 mb-2" t-if="aiAssistant.error">
                        <t t-esc="aiAssistant.error"/>
                    </div>
                    <div class="o_chatroom_ai_assistant_compact_bar">
                        <select class="form-select form-select-sm" aria-label="Acción de IA"
                                t-att-value="aiAssistant.mode"
                                t-att-disabled="aiAssistant.busy || !aiAssistant.providerReady"
                                t-on-change="onAiModeChange">
                            <option value="suggestion">Respuesta sugerida</option>
                            <option value="summary">Resumen de conversación</option>
                            <option value="intent">Clasificar intención</option>
                        </select>
                        <select class="form-select form-select-sm o_chatroom_ai_model_select"
                                aria-label="Modelo de IA"
                                t-if="aiAssistant.modelOptions.length"
                                t-att-value="aiAssistant.modelId || ''"
                                t-att-disabled="aiAssistant.busy || !aiAssistant.providerReady"
                                t-on-change="onAiModelChange">
                            <option value="">Modelo configurado</option>
                            <option t-foreach="aiAssistant.modelOptions" t-as="model" t-key="model.id"
                                    t-att-value="model.id">
                                <t t-esc="model.name"/><t t-if="model.recommended"> · recomendado</t>
                            </option>
                        </select>
                        <button type="button" class="btn btn-sm btn-primary"
                                t-att-disabled="aiAssistant.busy || !aiAssistant.providerReady"
                                t-on-click="runAiAction">
                            <i t-if="aiAssistant.busy" class="fa fa-spinner fa-spin"/>
                            <i t-else="" class="fa fa-play"/> Ejecutar
                        </button>
                    </div>
                    <div class="o_chatroom_ai_assistant_result" t-if="aiAssistant.suggestion">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong>Respuesta preparada</strong>
                            <span class="badge" t-esc="suggestionStateLabel()"/>
                        </div>
                        <div class="alert alert-warning py-1 px-2 mb-2" t-if="aiAssistant.suggestion.safety_reason">
                            <i class="fa fa-shield"/> <t t-esc="aiAssistant.suggestion.safety_reason"/>
                        </div>
                        <div class="o_chatroom_ai_assistant_trace" role="status">
                            <span><i class="fa fa-check-circle"/> Confianza <strong t-esc="suggestionConfidenceLabel()"/></span>
                            <span><i class="fa fa-database"/> Fuente <strong t-esc="suggestionSourceLabel()"/></span>
                            <span t-if="aiAssistant.suggestion.estimated_context_tokens"><i class="fa fa-calculator"/> Contexto <strong><t t-esc="aiAssistant.suggestion.estimated_context_tokens"/> tokens</strong></span>
                            <span t-if="aiAssistant.suggestion.knowledge_sources"><i class="fa fa-book"/> Conocimiento interno utilizado</span>
                        </div>
                        <textarea class="form-control form-control-sm o_chatroom_ai_assistant_text"
                                  t-if="aiAssistant.suggestion.state == 'draft'"
                                  t-model="aiAssistant.suggestion.text" rows="4"/>
                        <div class="o_chatroom_ai_assistant_text" t-else="" t-esc="aiAssistant.suggestion.text"/>
                        <div class="o_chatroom_ai_assistant_actions mt-2">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    t-att-disabled="aiAssistant.busy" t-on-click="useAiSuggestion">
                                Usar en mensaje
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    t-if="aiAssistant.suggestion.state == 'draft'"
                                    t-att-disabled="aiAssistant.busy" t-on-click="saveAiSuggestion">
                                Guardar cambios
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    t-if="aiAssistant.suggestion.state == 'draft'"
                                    t-att-disabled="aiAssistant.busy" t-on-click="approveAiSuggestion">
                                Aprobar
                            </button>
                            <button type="button" class="btn btn-sm btn-success"
                                    t-if="aiAssistant.suggestion.state == 'approved'"
                                    t-att-disabled="aiAssistant.busy" t-on-click="sendAiSuggestion">
                                Aprobar y enviar
                            </button>
                            <button type="button" class="btn btn-sm btn-link text-danger"
                                    t-if="aiAssistant.suggestion.state == 'draft'"
                                    t-att-disabled="aiAssistant.busy" t-on-click="discardAiSuggestion">
                                Descartar
                            </button>
                        </div>
                        <div class="o_chatroom_ai_assistant_feedback mt-2"
                             t-if="(aiAssistant.suggestion.state == 'approved' || aiAssistant.suggestion.state == 'sent') &amp;&amp; aiAssistant.suggestion.feedback_state == 'pending'">
                            <small class="d-block mb-1">¿Cómo fue esta respuesta?</small>
                            <button type="button" class="btn btn-sm btn-outline-success"
                                    t-att-disabled="aiAssistant.busy" t-on-click="rateAiHelpful">
                                <i class="fa fa-thumbs-up"/> Útil
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning"
                                    t-att-disabled="aiAssistant.busy" t-on-click="rateAiEdited">
                                <i class="fa fa-pencil"/> Requirió edición
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    t-att-disabled="aiAssistant.busy" t-on-click="rateAiUnsafe">
                                <i class="fa fa-ban"/> No usar
                            </button>
                        </div>
                    </div>
                    <div class="o_chatroom_ai_assistant_result" t-if="aiAssistant.summary">
                        <strong>Resumen</strong><div t-esc="aiAssistant.summary"/>
                    </div>
                    <div class="o_chatroom_ai_assistant_meta">
                        <span t-if="aiAssistant.safetyPolicy"><i class="fa fa-lock"/> Guardia: <strong><t t-esc="aiAssistant.safetyPolicy.enabled ? 'activa' : 'desactivada'"/></strong></span>
                        <span t-if="aiAssistant.safetyPolicy &amp;&amp; aiAssistant.safetyPolicy.enabled"><i class="fa fa-check-circle"/> Confianza minima: <strong t-esc="safetyConfidenceLabel()"/></span>
                        <span t-if="aiAssistant.safetyPolicy &amp;&amp; aiAssistant.safetyPolicy.enabled"><i class="fa fa-clock-o"/> Limite: <strong><t t-esc="aiAssistant.safetyPolicy.daily_limit"/> / dia</strong></span>
                        <span t-if="aiAssistant.budget"><i class="fa fa-credit-card"/> Saldo: <strong t-esc="budgetLabel()"/></span>
                        <span t-if="aiAssistant.intent"><i class="fa fa-tag"/> Intención: <strong t-esc="aiAssistant.intent"/></span>
                        <span><i class="fa fa-shield"/> Aprobación humana: <strong><t t-esc="aiAssistant.approvalRequired ? 'activa' : 'desactivada'"/></strong></span>
                        <span t-if="aiAssistant.knowledgeCount"><i class="fa fa-book"/> <t t-esc="aiAssistant.knowledgeCount"/> manuales</span>
                        <span t-if="aiAssistant.usage &amp;&amp; aiAssistant.usage.requests"><i class="fa fa-bar-chart"/> <t t-esc="aiAssistant.usage.requests"/> solicitudes · <t t-esc="aiAssistant.usage.tokens"/> tokens</span>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
