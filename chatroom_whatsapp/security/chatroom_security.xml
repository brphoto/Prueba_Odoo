<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_chatroom" model="ir.module.category">
        <field name="name">Chatroom WhatsApp</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_chatroom" model="res.groups.privilege">
        <field name="name">Chatroom WhatsApp</field>
        <field name="category_id" ref="module_category_chatroom"/>
    </record>

    <record id="group_chatroom_user" model="res.groups">
        <field name="name">Agente</field>
        <field name="privilege_id" ref="privilege_chatroom"/>
    </record>

    <record id="group_chatroom_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="privilege_id" ref="privilege_chatroom"/>
        <field name="implied_ids" eval="[(4, ref('group_chatroom_user'))]"/>
    </record>

    <record id="group_chatroom_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="privilege_chatroom"/>
        <field name="implied_ids" eval="[(4, ref('group_chatroom_supervisor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="chatroom_channel_rule_agent" model="ir.rule">
        <field name="name">Chatroom: agente ve sus conversaciones y sus lineas</field>
        <field name="model_id" ref="model_chatroom_channel"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('assigned_user_id', '=', user.id), ('whatsapp_number_id.member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_user'))]"/>
    </record>

    <record id="chatroom_channel_rule_manager" model="ir.rule">
        <field name="name">Chatroom: administrador ve las conversaciones de sus compañías</field>
        <field name="model_id" ref="model_chatroom_channel"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_manager'))]"/>
    </record>

    <record id="chatroom_channel_rule_supervisor" model="ir.rule">
        <field name="name">Chatroom: supervisor ve las conversaciones de su compañía</field>
        <field name="model_id" ref="model_chatroom_channel"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_supervisor'))]"/>
    </record>

    <record id="chatroom_whatsapp_number_rule_user" model="ir.rule">
        <field name="name">Chatroom: líneas de WhatsApp por compañía</field>
        <field name="model_id" ref="model_chatroom_whatsapp_number"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_user'))]"/>
    </record>


    <!-- Aislamiento por línea de los registros que cuelgan de una conversación.
         La conversación ya estaba aislada (reglas de arriba), pero sus mensajes
         y demás registros no tenían regla: un agente podía leer los mensajes de
         otra línea buscándolos directamente. Cada registro hereda ahora la
         visibilidad de su conversación: el agente ve lo de las conversaciones
         asignadas a él o de las líneas donde es miembro; supervisor y
         administrador, todo lo de sus compañías. -->
    <record id="chatroom_message_rule_agent" model="ir.rule">
        <field name="name">Chatroom: agente ve mensajes de sus conversaciones y sus líneas</field>
        <field name="model_id" ref="model_chatroom_message"/>
        <field name="domain_force">['&amp;', ('channel_id.company_id', 'in', company_ids), '|', ('channel_id.assigned_user_id', '=', user.id), ('channel_id.whatsapp_number_id.member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_user'))]"/>
    </record>
    <record id="chatroom_message_rule_supervisor" model="ir.rule">
        <field name="name">Chatroom: supervisor ve mensajes de su compañía</field>
        <field name="model_id" ref="model_chatroom_message"/>
        <field name="domain_force">[('channel_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_supervisor'))]"/>
    </record>
    <record id="chatroom_scheduled_message_rule_agent" model="ir.rule">
        <field name="name">Chatroom: agente ve mensajes programados de sus conversaciones y sus líneas</field>
        <field name="model_id" ref="model_chatroom_scheduled_message"/>
        <field name="domain_force">['&amp;', ('channel_id.company_id', 'in', company_ids), '|', ('channel_id.assigned_user_id', '=', user.id), ('channel_id.whatsapp_number_id.member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_user'))]"/>
    </record>
    <record id="chatroom_scheduled_message_rule_supervisor" model="ir.rule">
        <field name="name">Chatroom: supervisor ve mensajes programados de su compañía</field>
        <field name="model_id" ref="model_chatroom_scheduled_message"/>
        <field name="domain_force">[('channel_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_supervisor'))]"/>
    </record>
    <record id="chatroom_assignment_log_rule_agent" model="ir.rule">
        <field name="name">Chatroom: agente ve historial de asignaciones de sus conversaciones y sus líneas</field>
        <field name="model_id" ref="model_chatroom_assignment_log"/>
        <field name="domain_force">['&amp;', ('channel_id.company_id', 'in', company_ids), '|', ('channel_id.assigned_user_id', '=', user.id), ('channel_id.whatsapp_number_id.member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_user'))]"/>
    </record>
    <record id="chatroom_assignment_log_rule_supervisor" model="ir.rule">
        <field name="name">Chatroom: supervisor ve historial de asignaciones de su compañía</field>
        <field name="model_id" ref="model_chatroom_assignment_log"/>
        <field name="domain_force">[('channel_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_supervisor'))]"/>
    </record>
    <record id="chatroom_audit_log_rule_agent" model="ir.rule">
        <field name="name">Chatroom: agente ve auditoría de sus conversaciones y sus líneas</field>
        <field name="model_id" ref="model_chatroom_audit_log"/>
        <field name="domain_force">['&amp;', ('channel_id.company_id', 'in', company_ids), '|', ('channel_id.assigned_user_id', '=', user.id), ('channel_id.whatsapp_number_id.member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_user'))]"/>
    </record>
    <record id="chatroom_audit_log_rule_supervisor" model="ir.rule">
        <field name="name">Chatroom: supervisor ve auditoría de su compañía</field>
        <field name="model_id" ref="model_chatroom_audit_log"/>
        <field name="domain_force">[('channel_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_supervisor'))]"/>
    </record>
    <record id="chatroom_cart_line_rule_agent" model="ir.rule">
        <field name="name">Chatroom: agente ve carrito de sus conversaciones y sus líneas</field>
        <field name="model_id" ref="model_chatroom_cart_line"/>
        <field name="domain_force">['&amp;', ('channel_id.company_id', 'in', company_ids), '|', ('channel_id.assigned_user_id', '=', user.id), ('channel_id.whatsapp_number_id.member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_user'))]"/>
    </record>
    <record id="chatroom_cart_line_rule_supervisor" model="ir.rule">
        <field name="name">Chatroom: supervisor ve carrito de su compañía</field>
        <field name="model_id" ref="model_chatroom_cart_line"/>
        <field name="domain_force">[('channel_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_supervisor'))]"/>
    </record>
    <!-- Aislamiento por empresa.

         Son reglas GLOBALES (sin `groups`) a proposito: Odoo une con OR
         las reglas de los grupos del usuario y aplica las globales con
         AND sobre el resultado. Puesta en un grupo, una regla por empresa
         se uniria con OR a las que ya existen -alguna con dominio
         `[('id', '!=', False)]`- y no aislaria nada.

         `company_id = False` significa "de todas las empresas" y por eso
         se deja pasar. -->
    <record id="chatroom_kpi_snapshot_rule_company" model="ir.rule">
        <field name="name">Indicadores de Chatroom: solo las de la empresa activa</field>
        <field name="model_id" ref="model_chatroom_kpi_snapshot"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="chatroom_whatsapp_webhook_event_rule_company" model="ir.rule">
        <field name="name">Eventos de webhook: solo las de la empresa activa</field>
        <field name="model_id" ref="model_chatroom_whatsapp_webhook_event"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
