<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="chatroom_whatsapp.ChatroomThread">
        <div class="o_chatroom_thread"
             t-on-dragover="onDragOver"
             t-on-dragleave="onDragLeave"
             t-on-drop="onDrop">

            <div class="o_chatroom_thread_header" t-on-click="openPartner">
                <div class="o_chatroom_avatar">
                    <t t-esc="state.channelName ? state.channelName.charAt(0).toUpperCase() : '?'"/>
                </div>
                <div class="o_chatroom_header_info">
                    <div class="o_chatroom_header_name" t-esc="state.channelName"/>
                    <div class="o_chatroom_header_channel" t-esc="state.channelType"/>
                </div>
            </div>

            <div class="o_chatroom_thread_messages" t-ref="messages">
                <t t-if="state.loading">
                    <div class="o_chatroom_loading">
                        <i class="fa fa-spin fa-circle-o-notch"/>
                    </div>
                </t>
                <t t-elif="!state.messages.length">
                    <div class="o_chatroom_empty text-muted">
                        Aún no hay mensajes en esta conversación.
                    </div>
                </t>
                <t t-else="">
                    <t t-foreach="state.messages" t-as="message" t-key="message.id">
                        <div t-attf-class="o_chatroom_bubble o_chatroom_bubble_{{ message.direction === 'outbound' ? 'out' : 'in' }}">
                            <t t-if="message.attachments.length">
                                <t t-foreach="message.attachments" t-as="attachment" t-key="attachment.id">
                                    <t t-if="isImage(attachment)">
                                        <a t-att-href="attachmentDownloadUrl(attachment)" target="_blank">
                                            <img class="o_chatroom_bubble_image"
                                                 t-att-src="attachmentImageUrl(attachment)"
                                                 t-att-alt="attachment.name"/>
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <a class="o_chatroom_bubble_file"
                                           t-att-href="attachmentDownloadUrl(attachment)"
                                           target="_blank">
                                            <i class="fa fa-file-o"/>
                                            <span t-esc="attachment.name"/>
                                        </a>
                                    </t>
                                </t>
                            </t>
                            <div class="o_chatroom_bubble_body" t-if="message.body" t-esc="message.body"/>
                            <div class="o_chatroom_bubble_meta">
                                <span class="o_chatroom_bubble_time" t-esc="formatTime(message.dateObj)"/>
                                <i t-if="message.direction === 'outbound'"
                                   t-attf-class="fa {{ statusIcon(message) }} o_chatroom_bubble_status"/>
                            </div>
                        </div>
                    </t>
                </t>
            </div>

            <div class="o_chatroom_dropzone" t-if="state.dragOver">
                <div class="o_chatroom_dropzone_label">
                    <i class="fa fa-cloud-upload"/> Suelta el archivo para adjuntarlo
                </div>
            </div>

            <div class="o_chatroom_composer">
                <div class="o_chatroom_composer_attachments" t-if="state.pendingAttachments.length">
                    <t t-foreach="state.pendingAttachments" t-as="att" t-key="att_index">
                        <div class="o_chatroom_pending_attachment">
                            <img t-if="att.previewUrl" t-att-src="att.previewUrl"/>
                            <i t-else="" class="fa fa-file-o"/>
                            <span t-esc="att.name"/>
                            <i class="fa fa-times o_chatroom_remove_attachment"
                               t-on-click="() => this.removePendingAttachment(att_index)"/>
                        </div>
                    </t>
                </div>
                <div class="o_chatroom_composer_input">
                    <input type="file" t-ref="fileInput" class="d-none" multiple="multiple"
                           t-on-change="onFileChange"/>
                    <button class="btn btn-link o_chatroom_attach_btn" title="Adjuntar archivo"
                            t-on-click="triggerFilePicker">
                        <i class="fa fa-paperclip"/>
                    </button>
                    <textarea
                        class="o_chatroom_composer_textarea"
                        placeholder="Escribe un mensaje..."
                        t-model="state.composerText"
                        t-on-keydown="onComposerKeydown"
                        t-att-disabled="state.sending"/>
                    <button class="btn btn-primary o_chatroom_send_btn"
                            t-att-disabled="state.sending"
                            t-on-click="send">
                        <i class="fa fa-paper-plane"/>
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
