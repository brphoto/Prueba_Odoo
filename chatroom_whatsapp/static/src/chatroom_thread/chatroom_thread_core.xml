<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="chatroom_whatsapp.ChatroomThreadCore">
        <div class="o_chatroom_thread o_chatroom_thread_unsaved" t-if="!channelId">
            <div class="o_chatroom_empty text-muted">
                <i class="fa fa-comments-o"/> <t t-esc="props.emptyMessage"/>
            </div>
        </div>
        <div t-else="" class="o_chatroom_thread"
             t-on-dragover="onDragOver"
             t-on-dragleave="onDragLeave"
             t-on-drop="onDrop">

            <div class="o_chatroom_thread_header" t-on-click="openPartner">
                <div class="o_chatroom_avatar">
                    <img t-if="state.partnerId"
                         t-att-src="partnerAvatarUrl()"
                         alt=""/>
                    <t t-else="">
                        <t t-esc="state.channelName ? state.channelName.charAt(0).toUpperCase() : '?'"/>
                    </t>
                </div>
                <div class="o_chatroom_header_info">
                    <div class="o_chatroom_header_name" t-esc="state.channelName"/>
                    <div class="o_chatroom_header_channel" t-esc="state.channelType"/>
                    <button t-attf-class="o_chatroom_activity_pill {{ state.activity and state.activity.overdue ? 'o_overdue' : '' }}"
                            title="Abrir planificador de actividades"
                            t-on-click.stop="toggleActivityMenu">
                        <i t-attf-class="fa {{ state.activity and state.activity.overdue ? 'fa-exclamation-triangle' : 'fa-calendar' }}"/>
                        <span t-esc="activityLabel()"/>
                    </button>
                    <div class="o_chatroom_activity_popover" t-if="state.activityMenuOpen"
                         t-on-click.stop="">
                        <button t-if="state.activity" t-on-click="markActivityDone">
                            <i class="fa fa-check"/> Marcar como hecha
                        </button>
                        <button t-if="state.activity" t-on-click="rescheduleActivityTomorrow">
                            <i class="fa fa-calendar"/> Reprogramar para ma&#241;ana
                        </button>
                        <button t-on-click="createFollowupActivity">
                            <i class="fa fa-plus"/> Programar actividad
                        </button>
                        <button t-if="state.calendarInstalled" t-on-click="openCalendarMeeting">
                            <i class="fa fa-video-camera"/> Reunión / videollamada
                        </button>
                    </div>
                </div>
                <div class="o_chatroom_assignee_widget" t-if="state.agents.length">
                    <span class="o_chatroom_assignee_badge"
                          t-attf-style="--assignee-color: {{ state.assignedUserColor }}">
                        <span class="o_chatroom_assignee_initials">
                            <t t-esc="state.assignedUserInitials || 'NA'"/>
                        </span>
                        <span class="o_chatroom_assignee_name" t-esc="state.assignedUserName"/>
                    </span>
                    <button class="o_chatroom_assignee_switch" title="Reasignar conversación"
                            t-on-click.stop="toggleReassignMenu">
                        <i class="fa fa-exchange"/>
                    </button>
                    <div class="o_chatroom_assignee_popover" t-if="state.reassignOpen"
                         t-on-click.stop="">
                        <div class="o_chatroom_assignee_popover_title">Reasignar a</div>
                        <t t-foreach="state.agents" t-as="agent" t-key="agent.id">
                            <button class="o_chatroom_assignee_option"
                                    t-if="agent.id !== state.assignedUserId"
                                    t-on-click="() => this.quickReassign(agent)">
                                <span class="o_chatroom_assignee_initials"
                                      t-attf-style="--assignee-color: {{ agent.color }}">
                                    <t t-esc="agent.initials"/>
                                </span>
                                <span t-esc="agent.name"/>
                            </button>
                        </t>
                    </div>
                </div>
                <button t-attf-class="o_chatroom_activity_pill {{ state.activity and state.activity.overdue ? 'o_overdue' : '' }}"
                        title="Abrir acciones de actividad"
                        t-on-click.stop="toggleActivityMenu">
                    <i t-attf-class="fa {{ state.activity and state.activity.overdue ? 'fa-exclamation-triangle' : 'fa-clock-o' }}"/>
                    <span t-esc="activityLabel()"/>
                </button>
                <div class="o_chatroom_activity_popover" t-if="state.activityMenuOpen"
                     t-on-click.stop="">
                    <button t-if="state.activity" t-on-click="markActivityDone">
                        <i class="fa fa-check"/> Marcar como hecha
                    </button>
                    <button t-if="state.activity" t-on-click="rescheduleActivityTomorrow">
                        <i class="fa fa-calendar"/> Reprogramar para mañana
                    </button>
                    <button t-on-click="createFollowupActivity">
                        <i class="fa fa-plus"/> Crear nueva actividad
                    </button>
                </div>
                <button t-if="props.onOpenMobileSidebar"
                        class="o_chatroom_thread_mobile_menu_btn"
                        title="Mostrar conversaciones y opciones"
                        t-on-click.stop="() => props.onOpenMobileSidebar()">
                    <i class="fa fa-bars"/>
                </button>
            </div>

            <div class="o_chatroom_thread_subheader" t-if="!state.loading" t-on-click.stop="">
                <div class="o_chatroom_tags_row">
                    <TagsList tags="channelTagsForList()"/>
                    <span class="o_chatroom_tag_add" title="Agregar etiqueta" t-on-click="toggleTagPicker">
                        <i class="fa fa-plus"/>
                    </span>
                    <div class="o_chatroom_tag_picker" t-if="state.tagPickerOpen">
                        <t t-if="availableTags().length">
                            <t t-foreach="availableTags()" t-as="tag" t-key="tag.id">
                                <div class="o_chatroom_tag_picker_item" t-on-click="() => this.addTag(tag.id)">
                                    <span t-attf-class="o_tag_color_{{tag.color}} o_chatroom_tag_swatch"/>
                                    <span t-esc="tag.name"/>
                                </div>
                            </t>
                        </t>
                        <div class="o_chatroom_tag_picker_empty text-muted" t-else="">
                            No hay más etiquetas para agregar.
                        </div>
                    </div>
                </div>
                <div class="o_chatroom_subheader_right">
                    <button type="button"
                            t-attf-class="o_chatroom_urgent_toggle {{ state.manualUrgent ? 'o_active' : '' }}"
                            t-att-title="state.manualUrgent ? 'Quitar urgencia manual' : 'Marcar conversación como urgente'"
                            t-on-click.stop="toggleManualUrgent">
                        <i class="fa fa-flag"/>
                        <span>Urgente</span>
                    </button>
                    <span t-attf-class="o_chatroom_ai_toggle {{ state.aiPaused ? 'o_chatroom_ai_toggle_paused' : 'o_chatroom_ai_toggle_active' }}"
                          t-on-click="toggleAiPaused"
                          t-att-title="state.aiPaused ? 'IA pausada: la está atendiendo un agente. Tocá para reactivarla.' : 'IA activa: puede responder sola. Tocá para pausarla y atender vos.'">
                        <i class="fa fa-android"/>
                        <t t-esc="state.aiPaused ? 'IA pausada' : 'IA activa'"/>
                    </span>
                    <select t-if="state.numbers.length" class="o_chatroom_line_select"
                            t-on-change="transferLine" title="Transferir a otra línea">
                        <option value="">Sin línea</option>
                        <t t-foreach="state.numbers" t-as="number" t-key="number.id">
                            <option t-att-value="number.id" t-att-selected="number.id === state.whatsappNumberId">
                                <t t-esc="number.name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>

            <div class="o_chatroom_opt_out_banner" t-if="!state.loading and state.partnerOptedOut">
                <i class="fa fa-ban"/>
                <span>Este contacto se dio de baja de los mensajes. No se le puede escribir.</span>
            </div>
            <div class="o_chatroom_session_banner"
                 t-elif="!state.loading and !state.isSessionOpen">
                <i class="fa fa-info-circle"/>
                <span>La ventana de 24h para responder libremente expiró.</span>
                <button class="btn btn-sm btn-light" t-on-click="openSendTemplate">Enviar plantilla</button>
            </div>

            <div class="o_chatroom_thread_messages" t-ref="messages">
                <t t-if="state.loading">
                    <div class="o_chatroom_loading">
                        <i class="fa fa-spin fa-circle-o-notch"/>
                    </div>
                </t>
                <t t-elif="!state.messages.length">
                    <div class="o_chatroom_empty text-muted">
                        Aún no hay mensajes en esta conversación.
                    </div>
                </t>
                <t t-else="">
                    <t t-foreach="state.messages" t-as="message" t-key="message.id">
                        <div class="o_chatroom_date_separator" t-if="isNewDay(message_index)">
                            <span t-esc="dateSeparatorLabel(message.dateObj)"/>
                        </div>
                        <div class="o_chatroom_note_bubble" t-if="message.isNote">
                            <i class="fa fa-sticky-note-o"/>
                            <div class="o_chatroom_note_body" t-esc="message.body"/>
                            <div class="o_chatroom_note_meta">
                                <span t-esc="message.author_name"/> · <span t-esc="formatTime(message.dateObj)"/>
                            </div>
                        </div>
                        <div t-else=""
                             t-attf-class="o_chatroom_bubble o_chatroom_bubble_{{ message.direction === 'outbound' ? 'out' : 'in' }}">
                            <div class="o_chatroom_bubble_quote" t-if="replyPreview(message)">
                                <span t-esc="(replyPreview(message).body || '').slice(0, 120)"/>
                            </div>
                            <div class="o_chatroom_advisor_tag"
                                 t-if="message.direction === 'outbound' and message.sender_user_id"
                                 t-attf-style="--advisor-color: {{ senderColor(message) }}">
                                <span class="o_chatroom_advisor_dot"/>
                                <span t-esc="senderInitials(message)"/>
                                <span t-esc="senderName(message)"/>
                            </div>
                            <t t-if="message.attachments.length">
                                <t t-foreach="message.attachments" t-as="attachment" t-key="attachment.id">
                                    <t t-if="isImage(attachment)">
                                        <img class="o_chatroom_bubble_image"
                                             t-att-src="attachmentImageUrl(attachment)"
                                             t-att-alt="attachment.name"
                                             t-on-click="() => this.openLightbox(attachmentImageUrl(attachment))"/>
                                    </t>
                                    <t t-elif="isAudio(attachment)">
                                        <audio class="o_chatroom_bubble_audio" controls="controls"
                                               t-att-src="attachmentDownloadUrl(attachment)"/>
                                    </t>
                                    <t t-else="">
                                        <a class="o_chatroom_bubble_file"
                                           t-att-href="attachmentDownloadUrl(attachment)"
                                           target="_blank">
                                            <i class="fa fa-file-o"/>
                                            <span t-esc="attachment.name"/>
                                        </a>
                                    </t>
                                </t>
                            </t>
                            <div class="o_chatroom_bubble_body" t-if="message.body" t-esc="message.body"/>
                            <div class="o_chatroom_bubble_translation" t-if="message.translatedBody">
                                <i class="fa fa-language"/>
                                <span t-esc="message.translatedBody"/>
                            </div>
                            <div class="o_chatroom_bubble_meta">
                                <i t-if="canReply(message)"
                                   class="fa fa-smile-o o_chatroom_bubble_reply"
                                   title="Reaccionar"
                                   t-on-click="() => this.toggleReactionPicker(message)"/>
                                <i t-if="canReply(message)"
                                   class="fa fa-reply o_chatroom_bubble_reply"
                                   title="Responder citando"
                                   t-on-click="() => this.startReply(message)"/>
                                <i t-if="message.body and message.direction === 'inbound'"
                                   class="fa fa-language o_chatroom_bubble_translate"
                                   title="Traducir mensaje"
                                   t-on-click="() => this.translateMessage(message)"/>
                                <i t-if="message.translating" class="fa fa-spin fa-circle-o-notch"/>
                                <span class="o_chatroom_bubble_sender" t-if="senderName(message)"
                                      t-esc="senderName(message)"/>
                                <span class="o_chatroom_bubble_time" t-esc="formatTime(message.dateObj)"/>
                                <a t-if="message.state === 'failed'" class="o_chatroom_bubble_retry"
                                   title="Reintentar envío" t-on-click="() => this.retryMessage(message)">
                                    <i t-if="message.retrying" class="fa fa-spin fa-circle-o-notch"/>
                                    <t t-else="">
                                        <i class="fa fa-refresh"/> Reintentar
                                    </t>
                                </a>
                                <i t-if="message.direction === 'outbound'"
                                   t-attf-class="fa {{ statusIcon(message) }} o_chatroom_bubble_status"/>
                            </div>
                            <div class="o_chatroom_reaction_picker" t-if="state.reactingToId === message.id">
                                <t t-foreach="REACTION_EMOJIS" t-as="emoji" t-key="emoji">
                                    <span class="o_chatroom_reaction_option"
                                          t-on-click="() => this.sendReaction(message, emoji)"
                                          t-esc="emoji"/>
                                </t>
                            </div>
                            <div class="o_chatroom_bubble_reactions"
                                 t-if="message.own_reaction or message.partner_reaction">
                                <span t-if="message.partner_reaction" t-esc="message.partner_reaction"/>
                                <span t-if="message.own_reaction" t-esc="message.own_reaction"/>
                            </div>
                        </div>
                    </t>
                </t>
            </div>

            <div class="o_chatroom_dropzone" t-if="state.dragOver">
                <div class="o_chatroom_dropzone_label">
                    <i class="fa fa-cloud-upload"/> Suelta el archivo para adjuntarlo
                </div>
            </div>

            <div class="o_chatroom_composer">
                <div class="o_chatroom_composer_attachments" t-if="state.pendingAttachments.length">
                    <t t-foreach="state.pendingAttachments" t-as="att" t-key="att_index">
                        <div class="o_chatroom_pending_attachment">
                            <img t-if="att.previewUrl" t-att-src="att.previewUrl"/>
                            <i t-elif="att.isVoiceNote" class="fa fa-microphone"/>
                            <i t-else="" class="fa fa-file-o"/>
                            <span t-esc="att.isVoiceNote ? 'Nota de voz' : att.name"/>
                            <i class="fa fa-times o_chatroom_remove_attachment"
                               t-on-click="() => this.removePendingAttachment(att_index)"/>
                        </div>
                    </t>
                </div>

                <div class="o_chatroom_recording_bar" t-if="state.recording">
                    <i class="fa fa-microphone o_chatroom_recording_icon"/>
                    <span class="o_chatroom_recording_time" t-esc="formatDuration(state.recordSeconds)"/>
                    <span class="text-muted">Grabando...</span>
                    <div class="flex-grow-1"/>
                    <button class="btn btn-link text-danger" title="Cancelar" t-on-click="cancelRecording">
                        <i class="fa fa-trash"/>
                    </button>
                    <button class="btn btn-primary o_chatroom_send_btn" title="Detener y adjuntar"
                            t-on-click="toggleRecording">
                        <i class="fa fa-check"/>
                    </button>
                </div>
                <div t-else="">
                    <div class="o_chatroom_scheduled_list" t-if="state.scheduledMessages.length">
                        <t t-foreach="state.scheduledMessages" t-as="sched" t-key="sched.id">
                            <div class="o_chatroom_scheduled_item">
                                <i class="fa fa-clock-o"/>
                                <span class="o_chatroom_scheduled_item_date"
                                      t-esc="formatScheduledDate(sched.dateObj)"/>
                                <span class="o_chatroom_scheduled_item_body" t-esc="(sched.body || '').slice(0, 60)"/>
                                <i class="fa fa-times o_chatroom_scheduled_item_cancel" title="Cancelar"
                                   t-on-click="() => this.cancelScheduled(sched.id)"/>
                            </div>
                        </t>
                    </div>
                    <div class="o_chatroom_schedule_panel" t-if="state.scheduleOpen">
                        <input type="datetime-local" class="o_chatroom_schedule_input" t-model="state.scheduleDate"/>
                        <button class="btn btn-sm btn-primary" t-on-click="confirmSchedule">Programar</button>
                        <button class="btn btn-sm btn-link" t-on-click="toggleSchedule">Cancelar</button>
                    </div>
                    <div class="o_chatroom_reply_preview" t-if="state.replyingTo">
                        <div class="o_chatroom_reply_preview_bar"/>
                        <div class="o_chatroom_reply_preview_body">
                            <div class="o_chatroom_reply_preview_label">
                                Respondiendo a <t t-esc="replyingToLabel()"/>
                            </div>
                            <div class="o_chatroom_reply_preview_text"
                                 t-esc="(state.replyingTo.body || '').slice(0, 120)"/>
                        </div>
                        <i class="fa fa-times o_chatroom_reply_preview_close" title="Cancelar"
                           t-on-click="cancelReply"/>
                    </div>
                    <div class="o_chatroom_quick_buttons_panel" t-if="state.quickButtonsOpen">
                        <div class="o_chatroom_quick_buttons_hint text-muted">
                            Hasta 3 botones de respuesta rápida:
                        </div>
                        <t t-foreach="state.quickButtons" t-as="qb" t-key="qb_index">
                            <input type="text" class="o_chatroom_quick_button_input" maxlength="20"
                                   t-att-placeholder="'Botón ' + (qb_index + 1)"
                                   t-att-value="qb"
                                   t-on-input="(ev) => this.setQuickButton(qb_index, ev.target.value)"/>
                        </t>
                    </div>
                    <div class="o_chatroom_canned_panel" t-if="state.cannedOpen">
                        <div class="o_chatroom_canned_hint text-muted" t-if="!state.cannedResponses.length">
                            No hay respuestas rápidas guardadas todavía.
                        </div>
                        <t t-foreach="state.cannedResponses" t-as="canned" t-key="canned.id">
                            <div class="o_chatroom_canned_item"
                                 t-on-click="() => this.insertCannedResponse(canned.message)">
                                <strong t-esc="canned.name"/>
                                <div class="o_chatroom_canned_preview" t-esc="canned.message"/>
                            </div>
                        </t>
                    </div>
                    <div class="o_chatroom_mentions_menu"
                         t-if="state.noteMode and state.mentionOpen and mentionAgents().length">
                        <div class="o_chatroom_mentions_title">Mencionar asesor</div>
                        <button t-foreach="mentionAgents()" t-as="agent" t-key="agent.id"
                                t-on-click="() => this.insertMention(agent)">
                            <span class="o_chatroom_assignee_initials"
                                  t-attf-style="--assignee-color: {{ agent.color }}">
                                <t t-esc="agent.initials"/>
                            </span>
                            <t t-esc="agent.name"/>
                        </button>
                    </div>
                    <div t-attf-class="o_chatroom_composer_input {{ state.noteMode ? 'o_chatroom_composer_note_mode' : '' }}">
                        <input type="file" t-ref="fileInput" class="d-none" multiple="multiple"
                               t-on-change="onFileChange"/>
                        <button t-if="!state.noteMode" class="btn btn-link o_chatroom_attach_btn" title="Adjuntar archivo"
                                t-on-click="triggerFilePicker">
                            <i class="fa fa-paperclip"/>
                        </button>
                        <button t-if="!state.noteMode"
                                t-attf-class="btn btn-link o_chatroom_attach_btn {{ state.cannedOpen ? 'text-primary' : '' }}"
                                title="Respuestas rápidas" t-on-click="toggleCannedResponses">
                            <i class="fa fa-bolt"/>
                        </button>
                        <button t-if="!state.noteMode"
                                t-attf-class="btn btn-link o_chatroom_attach_btn {{ state.quickButtonsOpen ? 'text-primary' : '' }}"
                                title="Botones de respuesta rápida" t-on-click="toggleQuickButtons">
                            <i class="fa fa-list-ul"/>
                        </button>
                        <button t-attf-class="btn btn-link o_chatroom_attach_btn o_chatroom_note_toggle {{ state.noteMode ? 'text-warning' : '' }}"
                                title="Nota interna (no se envía al cliente)" t-on-click="toggleNoteMode">
                            <i class="fa fa-sticky-note-o"/>
                        </button>
                        <button t-if="!state.noteMode"
                                t-attf-class="btn btn-link o_chatroom_attach_btn {{ state.scheduleOpen ? 'text-primary' : '' }}"
                                title="Programar envío" t-on-click="toggleSchedule">
                            <i class="fa fa-clock-o"/>
                        </button>
                        <textarea
                            class="o_chatroom_composer_textarea"
                            t-att-placeholder="state.noteMode ? 'Nota interna (no se envía al cliente)...' : 'Escribe un mensaje...'"
                            t-model="state.composerText"
                            t-on-input="onComposerInput"
                            t-on-keydown="onComposerKeydown"
                            t-att-disabled="state.sending"/>
                        <button t-if="!state.noteMode" class="btn btn-link o_chatroom_attach_btn" title="Grabar nota de voz"
                                t-on-click="toggleRecording">
                            <i class="fa fa-microphone"/>
                        </button>
                        <button t-attf-class="btn o_chatroom_send_btn {{ state.noteMode ? 'btn-warning' : 'btn-primary' }}"
                                t-att-disabled="state.sending"
                                t-on-click="send">
                            <i class="fa fa-paper-plane"/>
                        </button>
                    </div>
                </div>
            </div>

            <div class="o_chatroom_lightbox" t-if="state.lightboxUrl" t-on-click="closeLightbox">
                <img t-att-src="state.lightboxUrl"/>
                <a class="o_chatroom_lightbox_download" t-att-href="state.lightboxUrl + '?download=true'"
                   title="Descargar" t-on-click.stop="">
                    <i class="fa fa-download"/>
                </a>
                <button class="o_chatroom_lightbox_close" t-on-click.stop="closeLightbox">
                    <i class="fa fa-times"/>
                </button>
            </div>
        </div>
    </t>

</templates>
