<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="chatroom_whatsapp.ChatroomApp">
        <div t-attf-class="o_chatroom_app {{ state.selectedChannelId ? 'o_chatroom_app_chat_open' : '' }} {{ state.mobileSidebarOpen ? 'o_chatroom_mobile_sidebar_open' : '' }}">
            <div class="o_chatroom_app_sidebar">
                <div class="o_chatroom_app_sidebar_header">
                    <h4>
                        <img t-if="state.companyLogoUrl" class="o_chatroom_company_logo"
                             t-att-src="state.companyLogoUrl" alt="Logo de la empresa"/>
                        <i t-else="" class="fa fa-whatsapp"/>
                        Chatroom
                    </h4>
                    <div class="o_chatroom_app_header_actions">
                        <select t-if="state.numbers.length" class="form-select form-select-sm o_chatroom_number_select"
                                t-on-change="(ev) => this.setNumberFilter(ev.target.value)">
                            <option value="all" t-att-selected="state.numberFilter === 'all'">Todas las líneas</option>
                            <option value="mine" t-att-selected="state.numberFilter === 'mine'">Mi línea</option>
                            <t t-foreach="state.numbers" t-as="number" t-key="number.id">
                                <option t-att-value="number.id" t-att-selected="state.numberFilter == number.id">
                                    <t t-esc="number.name"/>
                                </option>
                            </t>
                        </select>
                        <button class="btn btn-sm btn-light o_chatroom_sound_btn"
                                t-att-title="state.soundEnabled ? 'Desactivar sonido' : 'Activar sonido'"
                                t-on-click="toggleNotificationSound">
                            <i t-attf-class="fa {{ state.soundEnabled ? 'fa-volume-up' : 'fa-volume-off' }}"/>
                        </button>
                        <button class="btn btn-sm btn-light o_chatroom_sound_btn"
                                t-att-title="state.desktopNotifications ? 'Desactivar notificaciones' : 'Activar notificaciones'"
                                t-on-click="toggleDesktopNotifications">
                            <i t-attf-class="fa {{ state.desktopNotifications ? 'fa-bell' : 'fa-bell-slash' }}"/>
                        </button>
                        <button class="btn btn-sm btn-light o_chatroom_new_conv_btn" title="Nueva conversación"
                                t-on-click="openNewConversation">
                            <i class="fa fa-plus"/>
                        </button>
                    </div>
                </div>
                <div class="o_chatroom_app_toolbar">
                    <button class="btn btn-link" t-if="state.channels.length"
                            t-att-title="this.allVisibleSelected() ? 'Quitar selección visible' : 'Seleccionar conversaciones visibles'"
                            t-on-click="toggleSelectAllVisible">
                        <i t-attf-class="fa {{ this.allVisibleSelected() ? 'fa-check-square-o' : 'fa-square-o' }}"/>
                        <t t-esc="this.allVisibleSelected() ? 'Quitar' : 'Seleccionar'"/>
                    </button>
                    <t t-if="state.selectedChannelIds.length">
                        <span class="o_chatroom_selection_count">
                            <t t-esc="state.selectedChannelIds.length"/> seleccionadas
                        </span>
                        <select t-if="state.stages.length"
                                class="form-select form-select-sm o_chatroom_bulk_stage_select"
                                title="Mover conversaciones a una etapa"
                                t-on-change="(ev) => this.runBulkStage(ev.target.value)">
                            <option value="">Mover a etapa...</option>
                            <t t-foreach="state.stages" t-as="stage" t-key="stage.id">
                                <option t-att-value="stage.id"><t t-esc="stage.name"/></option>
                            </t>
                        </select>
                        <button class="btn btn-link" title="Marcar seleccionadas como leídas"
                                t-on-click="() => this.runBulkAction('action_bulk_mark_read')">
                            <i class="fa fa-check-double"/> Leer
                        </button>
                        <button class="btn btn-link" title="Marcar seleccionadas como urgentes"
                                t-on-click="() => this.runBulkUrgency(true)">
                            <i class="fa fa-flag"/> Urgentes
                        </button>
                        <button class="btn btn-link" title="Quitar urgencia de las seleccionadas"
                                t-on-click="() => this.runBulkUrgency(false)">
                            <i class="fa fa-flag-o"/> Quitar urgencia
                        </button>
                        <button class="btn btn-link" title="Cerrar conversaciones seleccionadas"
                                t-on-click="() => this.runBulkAction('action_close')">
                            <i class="fa fa-archive"/> Cerrar
                        </button>
                    </t>
                    <button class="btn btn-link" title="Ir a la próxima conversación pendiente"
                            t-on-click="goToNextPending">
                        <i class="fa fa-forward"/> Siguiente
                    </button>
                    <button class="btn btn-link" title="Dashboard" t-on-click="openDashboard">
                        <i class="fa fa-bar-chart"/> Dashboard
                    </button>
                    <button class="btn btn-link" title="Plantillas de WhatsApp" t-on-click="openTemplates">
                        <i class="fa fa-file-text-o"/> Plantillas
                    </button>
                    <button class="btn btn-link" title="Sincronizar plantillas desde Meta"
                            t-on-click="syncTemplates">
                        <i class="fa fa-refresh"/> Sincronizar
                    </button>
                    <button class="btn btn-link" title="Respuestas rápidas" t-on-click="openCannedResponses">
                        <i class="fa fa-bolt"/> Respuestas
                    </button>
                    <button class="btn btn-link" title="Líneas de WhatsApp" t-on-click="openNumbers">
                        <i class="fa fa-sitemap"/> Líneas
                    </button>
                </div>
                <div class="o_chatroom_app_search">
                    <i class="fa fa-search"/>
                    <input type="text" placeholder="Buscar conversación..." t-on-input="onSearchInput"/>
                </div>
                <div class="o_chatroom_secondary_filters">
                    <select class="form-select form-select-sm o_chatroom_filter_select"
                            title="Filtrar por canal"
                            t-on-change="(ev) => this.setChannelTypeFilter(ev.target.value)">
                        <option value="all" t-att-selected="state.channelTypeFilter === 'all'">Todos los canales</option>
                        <option value="whatsapp" t-att-selected="state.channelTypeFilter === 'whatsapp'">WhatsApp</option>
                        <option value="messenger" t-att-selected="state.channelTypeFilter === 'messenger'">Messenger</option>
                        <option value="instagram" t-att-selected="state.channelTypeFilter === 'instagram'">Instagram</option>
                    </select>
                    <select class="form-select form-select-sm o_chatroom_filter_select"
                            title="Filtrar por etapa"
                            t-on-change="(ev) => this.setStageFilter(ev.target.value)">
                        <option value="all" t-att-selected="state.stageFilter === 'all'">Todas las etapas</option>
                        <t t-foreach="state.stages" t-as="stage" t-key="stage.id">
                            <option t-att-value="stage.id" t-att-selected="state.stageFilter == stage.id">
                                <t t-esc="stage.name"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div class="o_chatroom_filter_tools" t-if="this.hasActiveFilters()">
                    <span><i class="fa fa-filter"/> Filtros activos</span>
                    <button type="button" class="btn btn-link btn-sm"
                            t-on-click="clearInboxFilters">Limpiar</button>
                </div>
                <div class="o_chatroom_app_filters">
                    <button t-attf-class="btn btn-sm {{ state.filter === 'all' ? 'btn-primary' : 'btn-light' }}"
                            t-on-click="() => this.setFilter('all')">Todas</button>
                    <button t-attf-class="btn btn-sm {{ state.filter === 'unread' ? 'btn-primary' : 'btn-light' }}"
                            t-on-click="() => this.setFilter('unread')">No leídas</button>
                    <button t-attf-class="btn btn-sm {{ state.filter === 'mine' ? 'btn-primary' : 'btn-light' }}"
                            t-on-click="() => this.setFilter('mine')">Mías</button>
                    <button t-attf-class="btn btn-sm {{ state.filter === 'pending' ? 'btn-primary' : 'btn-light' }}"
                            t-on-click="() => this.setFilter('pending')">Pendientes</button>
                    <button t-attf-class="btn btn-sm {{ state.filter === 'urgent' ? 'btn-primary' : 'btn-light' }}"
                            t-on-click="() => this.setFilter('urgent')">Urgentes</button>
                    <button t-attf-class="btn btn-sm {{ state.filter === 'sla' ? 'btn-primary' : 'btn-light' }}"
                            t-on-click="() => this.setFilter('sla')">SLA</button>
                    <button t-attf-class="btn btn-sm {{ state.filter === 'pinned' ? 'btn-primary' : 'btn-light' }}"
                            t-on-click="() => this.setFilter('pinned')">Fijadas</button>
                    <button t-attf-class="btn btn-sm {{ state.filter === 'favorites' ? 'btn-primary' : 'btn-light' }}"
                            t-on-click="() => this.setFilter('favorites')">Favoritas</button>
                    <button t-attf-class="btn btn-sm {{ state.filter === 'unassigned' ? 'btn-primary' : 'btn-light' }}"
                            t-on-click="() => this.setFilter('unassigned')">Sin asignar</button>
                </div>
                <div class="o_chatroom_app_list">
                    <t t-if="state.loading">
                        <div class="o_chatroom_loading"><i class="fa fa-spin fa-circle-o-notch"/></div>
                    </t>
                    <t t-elif="!state.channels.length">
                        <div class="o_chatroom_empty text-muted">No hay conversaciones.</div>
                    </t>
                    <t t-else="">
                        <t t-foreach="state.channels" t-as="channel" t-key="channel.id">
                            <div t-attf-class="o_chatroom_app_list_item
                                    {{ channel.id === state.selectedChannelId ? 'o_active' : '' }}
                                    {{ channel.unread_count ? 'o_unread' : '' }}"
                                 t-on-click="() => this.selectChannel(channel.id)">
                                <button type="button" class="btn btn-link o_chatroom_select_btn"
                                        t-att-title="state.selectedChannelIds.includes(channel.id) ? 'Quitar selección' : 'Seleccionar conversación'"
                                        t-on-click.stop="() => this.toggleChannelSelection(channel.id)">
                                    <i t-attf-class="fa {{ state.selectedChannelIds.includes(channel.id) ? 'fa-check-square-o' : 'fa-square-o' }}"/>
                                </button>
                                <div class="o_chatroom_avatar">
                                    <t t-esc="channel.display_name ? channel.display_name.charAt(0).toUpperCase() : '?'"/>
                                    <i t-attf-class="fa {{ channelIcon(channel.channel_type) }} o_chatroom_app_list_channel_icon"/>
                                </div>
                                <div class="o_chatroom_app_list_body">
                                    <div class="o_chatroom_app_list_row">
                                        <span class="o_chatroom_app_list_name text-truncate" t-esc="channel.display_name"/>
                                        <span class="o_chatroom_app_list_flags">
                                            <button type="button"
                                                    t-att-title="channel.manual_urgent ? 'Quitar urgencia' : 'Marcar como urgente'"
                                                    t-attf-class="btn btn-link btn-sm o_chatroom_flag_btn o_chatroom_urgent_btn {{ channel.manual_urgent ? 'o_is_urgent' : '' }}"
                                                    t-on-click.stop="() => this.toggleUrgent(channel)">
                                                <i class="fa fa-flag"/>
                                            </button>
                                            <button type="button" class="btn btn-link btn-sm o_chatroom_flag_btn"
                                                    t-if="channel.is_pinned" title="Desfijar conversación"
                                                    t-on-click.stop="() => this.toggleChannelFlag(channel, 'is_pinned')">
                                                <i class="fa fa-thumb-tack"/>
                                            </button>
                                            <button type="button" class="btn btn-link btn-sm o_chatroom_flag_btn"
                                                    t-if="channel.is_favorite" title="Quitar de favoritas"
                                                    t-on-click.stop="() => this.toggleChannelFlag(channel, 'is_favorite')">
                                                <i class="fa fa-star"/>
                                            </button>
                                        </span>
                                        <span t-if="channel.manual_urgent"
                                              class="o_chatroom_manual_urgent_badge"
                                              title="Urgencia marcada manualmente">
                                            <i class="fa fa-flag"/> Urgente
                                        </span>
                                        <span class="o_chatroom_app_list_time" t-esc="formatListTime(channel.dateObj)"/>
                                    </div>
                                    <div class="o_chatroom_app_list_row">
                                        <span class="o_chatroom_app_list_preview text-truncate" t-esc="channel.last_message_preview"/>
                                        <span class="badge rounded-pill text-bg-success" t-if="channel.unread_count">
                                            <t t-esc="channel.unread_count"/>
                                        </span>
                                    </div>
                                    <div class="o_chatroom_app_assignment_line">
                                        <span t-if="channel.assigned_user_id"
                                              t-attf-style="--assignee-color: {{ channel.assigned_user_color }}">
                                            <span class="o_chatroom_app_assignment_initials">
                                                <t t-esc="channel.assigned_user_initials"/>
                                            </span>
                                            Atendido por: [<t t-esc="channel.assigned_user_initials"/>]
                                        </span>
                                        <span t-else="" class="o_chatroom_app_unassigned">Sin asignar</span>
                                        <span t-if="channel.stage_name"
                                              t-attf-class="o_chatroom_stage_badge {{ this.stageColorClass(channel.stage_color) }}"
                                              t-att-title="channel.stage_name">
                                            <i class="fa fa-circle"/> <t t-esc="channel.stage_name"/>
                                        </span>
                                    </div>
                                    <div t-if="channel.next_activity_id"
                                         t-attf-class="o_chatroom_app_activity_line {{ channel.next_activity_overdue ? 'o_overdue' : '' }}">
                                        <i t-attf-class="fa {{ channel.next_activity_overdue ? 'fa-exclamation-triangle' : 'fa-clock-o' }}"/>
                                        <span t-esc="activityLabel(channel)"/>
                                    </div>
                                    <div t-elif="channel.first_response_sla_state === 'yellow' or channel.first_response_sla_state === 'red'"
                                         t-attf-class="o_chatroom_app_activity_line o_sla_{{ channel.first_response_sla_state }}">
                                        <i class="fa fa-hourglass-half"/>
                                        <span t-if="channel.first_response_sla_state === 'red'">
                                            SLA vencido - <t t-esc="channel.pending_response_minutes"/> min
                                        </span>
                                        <span t-else="">
                                            Esperando <t t-esc="channel.pending_response_minutes"/> min
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
            <div class="o_chatroom_app_main">
                <button class="o_chatroom_app_back_btn" t-if="state.selectedChannelId" t-on-click="backToList">
                    <i class="fa fa-arrow-left"/>
                </button>
                <button t-if="state.selectedChannelId" title="Datos del contacto"
                        t-attf-class="o_chatroom_app_panel_toggle {{ state.contactPanelOpen ? 'o_active' : '' }}"
                        t-on-click="toggleContactPanel">
                    <i class="fa fa-id-card-o"/>
                </button>
                <ChatroomThreadCore
                    channelId="state.selectedChannelId"
                    emptyMessage="'Seleccioná una conversación de la izquierda para empezar.'"
                    onOpenMobileSidebar="() => this.toggleMobileSidebar()"
                    onMessagesLoaded="() => this.onThreadMessagesLoaded()"
                    onChannelPriorityChanged="() => this._loadChannels()"/>
            </div>
            <ContactPanel t-if="state.selectedChannelId and state.contactPanelOpen"
                          channelId="state.selectedChannelId"
                          onClose="() => this.toggleContactPanel()"/>
        </div>
    </t>

</templates>
