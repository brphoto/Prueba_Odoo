<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chatroom_scheduled_message_list" model="ir.ui.view">
        <field name="name">chatroom.scheduled.message.list</field>
        <field name="model">chatroom.scheduled.message</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('sent', 'cancelled')"
                  decoration-danger="state == 'failed'">
                <field name="channel_id" string="Conversación"/>
                <field name="message_type" string="Tipo"/>
                <field name="body" string="Mensaje"/>
                <field name="template_id" string="Plantilla"/>
                <field name="scheduled_date" string="Fecha programada"/>
                <field name="state" string="Estado" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="error_message" string="Mensaje de error" optional="hide"/>
                <button name="action_retry" type="object" string="Reintentar" icon="fa-refresh" invisible="state != 'failed'"/>
                <button name="action_cancel" type="object" string="Cancelar envío"
                        icon="fa-ban" invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_chatroom_scheduled_message_form" model="ir.ui.view">
        <field name="name">chatroom.scheduled.message.form</field>
        <field name="model">chatroom.scheduled.message</field>
        <field name="arch" type="xml">
            <form string="Mensaje programado" class="o_chatroom_scheduled_form">
                <header>
                    <button name="action_cancel" type="object" string="Cancelar envío"
                            class="btn-secondary" invisible="state != 'pending'"/>
                    <button name="action_retry" type="object" string="Reintentar envio" class="btn-primary" invisible="state != 'failed'"/>
                    <field name="state" string="Estado" widget="statusbar"
                           statusbar_visible="pending,sent,failed,cancelled"/>
                </header>
                <sheet class="o_chatroom_workflow_sheet">
                    <div class="o_chatroom_workflow_intro">
                        <strong>Programa el siguiente contacto con claridad</strong>
                        <span>El mensaje quedará pendiente y se enviará únicamente cuando llegue la fecha configurada.</span>
                    </div>
                    <group class="o_chatroom_workflow_step">
                        <field name="channel_id" string="Conversación" readonly="state != 'pending'"/>
                        <field name="message_type" string="Tipo" readonly="state != 'pending'"/>
                        <field name="scheduled_date" string="Fecha y hora de envío"
                               readonly="state != 'pending'"/>
                    </group>
                    <group string="Contenido del mensaje" class="o_chatroom_workflow_step" invisible="message_type != 'text'">
                        <field name="body" string="Texto" nolabel="1"
                               readonly="state != 'pending'"/>
                    </group>
                    <group string="Plantilla aprobada" class="o_chatroom_workflow_step" invisible="message_type != 'template'">
                        <field name="template_id" string="Plantilla" nolabel="1"
                               readonly="state != 'pending'"/>
                    </group>
                    <group string="Revisión antes de programar" class="o_chatroom_workflow_preview">
                        <field name="readiness_message" nolabel="1" readonly="1"/>
                        <field name="preview" string="Mensaje que se enviará" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Resultado del envío" invisible="not error_message">
                        <field name="error_message" string="Mensaje de error" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_chatroom_scheduled_message_search" model="ir.ui.view">
        <field name="name">chatroom.scheduled.message.search</field>
        <field name="model">chatroom.scheduled.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="channel_id"/>
                <field name="body"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <filter name="failed" string="Fallidos" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_chatroom_scheduled_message" model="ir.actions.act_window">
        <field name="name">Mensajes programados</field>
        <field name="res_model">chatroom.scheduled.message</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_chatroom_scheduled_message_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay mensajes programados todavía.
            </p>
            <p>
                Se programan desde el composer del chat (ícono de reloj) y
                un cron los va enviando cada 5 minutos cuando se cumple la
                fecha.
            </p>
        </field>
    </record>

</odoo>
