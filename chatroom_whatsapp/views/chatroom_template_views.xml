<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chatroom_template_list" model="ir.ui.view">
        <field name="name">chatroom.template.list</field>
        <field name="model">chatroom.template</field>
        <field name="arch" type="xml">
            <list>
                <button name="action_sync_templates" type="object"
                        string="Sincronizar con Meta" class="btn-primary"/>
                <field name="name"/>
                <field name="language"/>
                <field name="category"/>
                <field name="variable_count" string="Variables"/>
                <field name="last_synced_at" string="Última sincronización" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-warning="status == 'pending'"
                       decoration-info="status == 'draft'"
                       decoration-danger="status in ('rejected', 'disabled')"
                       decoration-muted="status == 'paused'"/>
            </list>
        </field>
    </record>

    <record id="view_chatroom_template_form" model="ir.ui.view">
        <field name="name">chatroom.template.form</field>
        <field name="model">chatroom.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de WhatsApp" class="o_chatroom_template_form">
                <header>
                    <button name="action_submit_to_meta" type="object"
                            string="Enviar a Meta" class="btn-primary"
                            invisible="not id or waba_template_id or status != 'draft'"/>
                    <button name="action_detect_variables" type="object"
                            string="Detectar variables" class="btn-secondary"
                            invisible="not body"/>
                    <button name="action_validate_template" type="object"
                            string="Validar plantilla" class="btn-secondary"
                            invisible="not body"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,pending,approved,rejected"/>
                </header>
                <sheet class="o_chatroom_template_sheet">
                    <div class="o_chatroom_template_banner alert alert-info" role="alert" invisible="waba_template_id">
                        Guarda el borrador y pulsa «Enviar a Meta» para solicitar su aprobación.
                    </div>
                    <field name="waba_template_id" invisible="1"/>
                    <div class="o_chatroom_template_hero oe_title">
                        <h1><field name="name" string="Nombre" readonly="waba_template_id"/></h1>
                    </div>
                    <group class="o_chatroom_template_meta">
                        <group class="o_chatroom_template_meta_card">
                            <field name="language" string="Idioma" readonly="waba_template_id"/>
                            <field name="category" string="Categoría" readonly="waba_template_id"/>
                        </group>
                        <group class="o_chatroom_template_meta_card">
                            <field name="header_type" string="Tipo de encabezado" readonly="waba_template_id"/>
                            <field name="header_text" string="Texto del encabezado" readonly="waba_template_id"/>
                            <field name="footer_text" string="Pie del mensaje" readonly="waba_template_id"/>
                            <field name="variable_count" string="Variables detectadas" readonly="1"/>
                            <field name="last_synced_at" string="Última sincronización" readonly="1"/>
                        </group>
                    </group>
                    <group string="Mensaje aprobado" class="o_chatroom_template_section o_chatroom_template_body_section">
                        <field name="body" string="Mensaje" nolabel="1" readonly="waba_template_id"/>
                    </group>
                    <group string="Variables del mensaje" class="o_chatroom_template_section o_chatroom_template_variables_section" invisible="not variable_count">
                        <field name="variable_mapping_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence"/>
                                <field name="placeholder" readonly="1"/>
                                <field name="label"/>
                                <field name="value_source"/>
                                <field name="format_type"/>
                                <field name="static_value" invisible="value_source != 'static'"/>
                            </list>
                        </field>
                        <div class="o_chatroom_template_helper text-muted">
                            Detecta las variables después de escribir el cuerpo. Al enviar desde un chat,
                            Odoo completará estos campos automáticamente.
                        </div>
                    </group>
                    <group string="Vista previa" class="o_chatroom_template_section o_chatroom_template_preview_section">
                        <group class="o_chatroom_template_preview_input">
                            <field name="example_values" placeholder="Un valor por línea, en el mismo orden de {{1}}, {{2}}..."/>
                        </group>
                        <group class="o_chatroom_template_preview_card">
                            <div class="o_form_label">Así recibirá el mensaje el cliente</div>
                            <field name="preview_body" readonly="1" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chatroom_template" model="ir.actions.act_window">
        <field name="name">Plantillas de WhatsApp</field>
        <field name="res_model">chatroom.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no hay plantillas sincronizadas.
            </p>
            <p>
                Usa "Sincronizar con Meta" para traer las plantillas
                aprobadas de tu cuenta de WhatsApp Business.
            </p>
        </field>
    </record>

    <record id="view_chatroom_send_template_wizard_form" model="ir.ui.view">
        <field name="name">chatroom.send.template.wizard.form</field>
        <field name="model">chatroom.send.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar plantilla de WhatsApp" class="o_chatroom_template_send_wizard">
                <group class="o_chatroom_workflow_step">
                    <field name="channel_id" invisible="1"/>
                    <field name="template_id"/>
                    <field name="variable_count" string="Cantidad de variables"/>
                    <field name="variables_text"
                           invisible="not variable_count"
                           placeholder="Un valor por línea, en orden"/>
                    <field name="mapping_preview" string="Campos detectados"
                           invisible="not variable_count" readonly="1"/>
                </group>
                <group string="Vista previa antes de enviar" class="o_chatroom_workflow_preview" invisible="not template_id">
                    <field name="preview" nolabel="1" readonly="1"/>
                    <field name="readiness_message" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Enviar"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_chatroom_send_template_wizard" model="ir.actions.act_window">
        <field name="name">Enviar plantilla</field>
        <field name="res_model">chatroom.send.template.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
