<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chatroom_message_list" model="ir.ui.view">
        <field name="name">chatroom.message.list</field>
        <field name="model">chatroom.message</field>
        <field name="arch" type="xml">
            <list default_order="date desc">
                <field name="date"/>
                <field name="channel_id"/>
                <field name="direction"/>
                <field name="message_type"/>
                <field name="display_name" string="Mensaje"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_chatroom_message_form" model="ir.ui.view">
        <field name="name">chatroom.message.form</field>
        <field name="model">chatroom.message</field>
        <field name="arch" type="xml">
            <form string="Mensaje">
                <sheet>
                    <group>
                        <group>
                            <field name="channel_id"/>
                            <field name="direction"/>
                            <field name="message_type"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="wa_message_id"/>
                            <field name="attachment_url" widget="url"/>
                        </group>
                    </group>
                    <group>
                        <field name="body"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chatroom_message" model="ir.actions.act_window">
        <field name="name">Mensajes (auditoría)</field>
        <field name="res_model">chatroom.message</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
