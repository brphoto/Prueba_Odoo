<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chatroom_channel_kanban" model="ir.ui.view">
        <field name="name">chatroom.channel.kanban</field>
        <field name="model">chatroom.channel</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="state">
                <field name="display_name"/>
                <field name="last_message_preview"/>
                <field name="last_message_date"/>
                <field name="unread_count"/>
                <field name="channel_type"/>
                <field name="assigned_user_id"/>
                <field name="ai_intent"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="d-flex align-items-center gap-1 text-truncate">
                                    <i t-if="record.channel_type.raw_value == 'whatsapp'" title="WhatsApp"
                                       class="fa fa-whatsapp o_chatroom_channel_icon o_chatroom_channel_icon_whatsapp"/>
                                    <i t-elif="record.channel_type.raw_value == 'messenger'" title="Messenger"
                                       class="fa fa-facebook o_chatroom_channel_icon o_chatroom_channel_icon_messenger"/>
                                    <i t-elif="record.channel_type.raw_value == 'instagram'" title="Instagram"
                                       class="fa fa-instagram o_chatroom_channel_icon o_chatroom_channel_icon_instagram"/>
                                    <strong class="text-truncate"><field name="display_name"/></strong>
                                </div>
                                <span class="badge text-bg-danger" t-if="record.unread_count.raw_value">
                                    <field name="unread_count"/>
                                </span>
                            </div>
                            <div class="text-muted text-truncate">
                                <field name="last_message_preview"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <span class="badge text-bg-info" t-if="record.ai_intent.raw_value">
                                    <field name="ai_intent"/>
                                </span>
                                <span class="text-muted o_chatroom_kanban_time"
                                      t-if="record.last_message_date.value"
                                      t-esc="record.last_message_date.value.toRelative()"/>
                                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_chatroom_channel_list" model="ir.ui.view">
        <field name="name">chatroom.channel.list</field>
        <field name="model">chatroom.channel</field>
        <field name="arch" type="xml">
            <list decoration-bf="unread_count &gt; 0">
                <field name="display_name" string="Conversación"/>
                <field name="channel_type"/>
                <field name="last_message_preview" string="Último mensaje"/>
                <field name="last_message_date"/>
                <field name="whatsapp_number_id" optional="show"/>
                <field name="assigned_user_id"/>
                <field name="ai_intent" widget="badge"/>
                <field name="unread_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'open'"
                       decoration-warning="state == 'pending'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_chatroom_channel_form" model="ir.ui.view">
        <field name="name">chatroom.channel.form</field>
        <field name="model">chatroom.channel</field>
        <field name="arch" type="xml">
            <form string="Conversación">
                <header>
                    <button name="action_send_ai_suggestion" type="object"
                            string="Enviar sugerencia IA" class="btn-primary"
                            invisible="not ai_suggested_reply"/>
                    <button name="action_ai_suggest_reply" type="object"
                            string="Sugerir respuesta con IA" class="btn-secondary"/>
                    <button name="action_ai_summarize" type="object"
                            string="Resumir con IA" class="btn-secondary"/>
                    <button name="%(action_chatroom_send_template_wizard)d" type="action"
                            string="Enviar plantilla" class="btn-secondary"
                            context="{'default_channel_id': id}"/>
                    <button name="action_create_lead" type="object"
                            string="Crear Oportunidad" class="btn-secondary"/>
                    <button name="action_create_quotation" type="object"
                            string="Crear Presupuesto" class="btn-secondary"/>
                    <button name="action_create_task" type="object"
                            string="Crear Tarea" class="btn-secondary"
                            invisible="not project_installed"/>
                    <button name="action_close" type="object"
                            string="Cerrar conversación"
                            invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_leads" type="object" class="oe_stat_button"
                                icon="fa-star" invisible="not crm_installed">
                            <field name="lead_count" widget="statinfo" string="Oportunidades"/>
                        </button>
                        <button name="action_view_sale_orders" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="not sale_installed">
                            <field name="sale_order_count" widget="statinfo" string="Presupuestos"/>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button"
                                icon="fa-usd" invisible="not account_installed">
                            <field name="invoice_count" widget="statinfo" string="Facturas"/>
                        </button>
                        <button name="action_view_tasks" type="object" class="oe_stat_button"
                                icon="fa-tasks" invisible="not project_installed">
                            <field name="task_count" widget="statinfo" string="Tareas"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                        <field name="ai_intent" widget="badge"
                               decoration-success="ai_intent == 'venta'"
                               decoration-danger="ai_intent == 'queja'"
                               decoration-info="ai_intent in ('consulta', 'soporte')"
                               invisible="not ai_intent"/>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="channel_type"/>
                            <field name="external_id"/>
                            <field name="whatsapp_number_id"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="last_message_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="mb-3" invisible="not pinned_lead_name">
                        <button name="action_open_pinned_lead" type="object" class="btn btn-link p-0">
                            <i class="fa fa-star text-warning"/>
                            Oportunidad anclada: <field name="pinned_lead_name" nolabel="1" readonly="1"/>
                        </button>
                    </div>
                    <group string="Resumen de IA" invisible="not ai_summary">
                        <field name="ai_summary" nolabel="1"/>
                    </group>
                    <group string="Sugerencia de IA" invisible="not ai_suggested_reply">
                        <field name="ai_suggested_reply" nolabel="1"/>
                    </group>
                    <field name="message_ids" widget="chatroom_thread" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_chatroom_channel_search" model="ir.ui.view">
        <field name="name">chatroom.channel.search</field>
        <field name="model">chatroom.channel</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name" string="Conversación"/>
                <field name="partner_id"/>
                <field name="external_id"/>
                <field name="whatsapp_number_id"/>
                <filter name="my_channels" string="Mis conversaciones"
                        domain="[('assigned_user_id', '=', uid)]"/>
                <filter name="my_line" string="Mi línea"
                        domain="[('whatsapp_number_id.member_ids', 'in', uid)]"/>
                <filter name="unread" string="No leídos"
                        domain="[('unread_count', '&gt;', 0)]"/>
                <separator/>
                <filter name="open" string="Abiertas" domain="[('state', '=', 'open')]"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <filter name="closed" string="Cerradas" domain="[('state', '=', 'closed')]"/>
                <group>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_channel_type" string="Canal" context="{'group_by': 'channel_type'}"/>
                    <filter name="group_number" string="Línea" context="{'group_by': 'whatsapp_number_id'}"/>
                    <filter name="group_assigned" string="Agente" context="{'group_by': 'assigned_user_id'}"/>
                    <filter name="group_ai_intent" string="Intención (IA)" context="{'group_by': 'ai_intent'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_chatroom_channel" model="ir.actions.act_window">
        <field name="name">Chatroom</field>
        <field name="res_model">chatroom.channel</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_chatroom_channel_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no hay conversaciones de WhatsApp o redes sociales.
            </p>
            <p>
                Las conversaciones se crean automáticamente cuando un
                contacto escribe por primera vez a tu número de WhatsApp
                Business.
            </p>
        </field>
    </record>

</odoo>
