<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chatroom_reassign_wizard_form" model="ir.ui.view">
        <field name="name">chatroom.reassign.wizard.form</field>
        <field name="model">chatroom.reassign.wizard</field>
        <field name="arch" type="xml">
            <form string="Reasignar conversaciones">
                <group>
                    <field name="assigned_user_id"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reasignar"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_chatroom_reassign_wizard" model="ir.actions.act_window">
        <field name="name">Reasignar conversaciones</field>
        <field name="res_model">chatroom.reassign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_chatroom_channel"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
