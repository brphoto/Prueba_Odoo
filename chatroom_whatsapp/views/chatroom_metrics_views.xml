<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chatroom_channel_pivot" model="ir.ui.view">
        <field name="name">chatroom.channel.pivot</field>
        <field name="model">chatroom.channel</field>
        <field name="arch" type="xml">
            <pivot string="Métricas de Chatroom">
                <field name="assigned_user_id" type="row"/>
                <field name="state" type="col"/>
                <field name="first_response_minutes" type="measure" widget="float_time" string="Primera respuesta"/>
                <field name="message_count" type="measure" string="Mensajes"/>
            </pivot>
        </field>
    </record>

    <record id="view_chatroom_channel_graph" model="ir.ui.view">
        <field name="name">chatroom.channel.graph</field>
        <field name="model">chatroom.channel</field>
        <field name="arch" type="xml">
            <graph string="Métricas de Chatroom" type="bar">
                <field name="assigned_user_id"/>
                <field name="first_response_minutes" type="measure" widget="float_time"/>
            </graph>
        </field>
    </record>

    <record id="action_chatroom_metrics" model="ir.actions.act_window">
        <field name="name">Métricas</field>
        <field name="res_model">chatroom.channel</field>
        <field name="view_mode">pivot,graph</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no hay conversaciones para medir.
            </p>
        </field>
    </record>

</odoo>
