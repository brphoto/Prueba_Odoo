<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chatroom_tag_list" model="ir.ui.view">
        <field name="name">chatroom.tag.list</field>
        <field name="model">chatroom.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="color" widget="color_picker"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_chatroom_tag" model="ir.actions.act_window">
        <field name="name">Etiquetas</field>
        <field name="res_model">chatroom.tag</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no hay etiquetas creadas.
            </p>
            <p>
                Se usan para categorizar conversaciones (ej. "Reclamo",
                "Venta caliente") y así poder filtrar y agrupar en la
                vista clásica y en reportes.
            </p>
        </field>
    </record>

</odoo>
