<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chatroom_bulk_whatsapp_wizard_form" model="ir.ui.view">
        <field name="name">chatroom.bulk.whatsapp.wizard.form</field>
        <field name="model">chatroom.bulk.whatsapp.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar WhatsApp masivo">
                <group>
                    <field name="template_id"/>
                    <field name="recipient_count" readonly="1"
                           string="Contactos únicos en la selección"/>
                </group>
                <p class="text-muted">
                    Se manda la plantilla a cada contacto único de la selección
                    (deduplicado por número de WhatsApp). Los contactos dados de
                    baja se omiten solos.
                </p>
                <footer>
                    <button name="action_send" type="object" string="Enviar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Un ir.actions.act_window por modelo (binding_model_id es
         Many2one, no admite varios modelos en el mismo registro):
         aparece en el menú de Acciones de la lista con los registros
         seleccionados como active_ids. -->
    <record id="action_chatroom_bulk_whatsapp_partner" model="ir.actions.act_window">
        <field name="name">Enviar WhatsApp masivo</field>
        <field name="res_model">chatroom.bulk.whatsapp.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_chatroom_bulk_whatsapp_lead" model="ir.actions.act_window">
        <field name="name">Enviar WhatsApp masivo</field>
        <field name="res_model">chatroom.bulk.whatsapp.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_chatroom_bulk_whatsapp_sale_order" model="ir.actions.act_window">
        <field name="name">Enviar WhatsApp masivo</field>
        <field name="res_model">chatroom.bulk.whatsapp.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_chatroom_bulk_whatsapp_invoice" model="ir.actions.act_window">
        <field name="name">Enviar WhatsApp masivo</field>
        <field name="res_model">chatroom.bulk.whatsapp.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
