<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_chatroom_channel" model="ir.actions.report">
        <field name="name">Historial de conversacion</field>
        <field name="model">chatroom.channel</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">chatroom_whatsapp.chatroom_channel_transcript_report</field>
        <field name="report_file">chatroom_whatsapp.chatroom_channel_transcript_report</field>
        <field name="print_report_name">'Conversacion - %s' % (object.display_name or object.id)</field>
        <field name="binding_model_id" ref="model_chatroom_channel"/>
        <field name="binding_type">report</field>
    </record>

    <template id="chatroom_channel_transcript_report">
        <!-- Layout liviano: el historial no necesita el encabezado completo del website. -->
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="channel">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 10pt; color: #263238;">
                    <style>
                        .chatroom-report-title { color: #155e75; margin: 0 0 12px; }
                        .chatroom-report-meta { width: 100%; margin-bottom: 18px; }
                        .chatroom-report-meta td { padding: 3px 8px 3px 0; vertical-align: top; }
                        .chatroom-report-meta .label { color: #546e7a; font-weight: bold; width: 24%; }
                        .chatroom-report-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
                        .chatroom-report-table th { background: #155e75; color: #fff; padding: 7px; text-align: left; }
                        .chatroom-report-table td { border: 1px solid #cfd8dc; padding: 6px; vertical-align: top; word-wrap: break-word; }
                        .chatroom-report-table tr:nth-child(even) td { background: #f5f8fa; }
                        .chatroom-report-table .date { width: 16%; }
                        .chatroom-report-table .direction { width: 13%; }
                        .chatroom-report-table .agent { width: 17%; }
                        .chatroom-report-table .message { width: 54%; white-space: pre-wrap; }
                    </style>
                    <h2 class="chatroom-report-title">Historial de conversacion</h2>
                    <table class="chatroom-report-meta">
                        <tr><td class="label">Contacto:</td><td t-esc="channel.display_name"/></tr>
                        <tr><td class="label">Canal:</td><td t-esc="dict(channel._fields['channel_type'].selection).get(channel.channel_type)"/></tr>
                        <tr><td class="label">Estado:</td><td t-esc="dict(channel._fields['state'].selection).get(channel.state)"/></tr>
                        <tr><td class="label">Agente asignado:</td><td t-esc="channel.assigned_user_id.name or '-'"/></tr>
                    </table>
                    <t t-set="report_data" t-value="channel.get_transcript_report_data()"/>
                    <p t-if="report_data['truncated']" class="text-muted">
                        Mostrando los <span t-esc="report_data['shown']"/> mensajes más recientes de
                        <span t-esc="report_data['total']"/>. El límite se puede cambiar en Ajustes de Chatroom.
                    </p>
                    <table class="chatroom-report-table">
                        <thead>
                            <tr>
                                <th class="date">Fecha</th>
                                <th class="direction">Direccion</th>
                                <th class="agent">Agente</th>
                                <th class="message">Mensaje</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="report_data['lines']" t-as="line">
                                <tr>
                                    <td class="date" t-esc="line['date']"/>
                                    <td class="direction" t-esc="line['direction']"/>
                                    <td class="agent" t-esc="line['sender']"/>
                                    <td class="message" t-esc="line['body']"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
