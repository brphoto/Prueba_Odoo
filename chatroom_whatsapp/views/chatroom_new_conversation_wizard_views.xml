<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chatroom_new_conversation_wizard_form" model="ir.ui.view">
        <field name="name">chatroom.new.conversation.wizard.form</field>
        <field name="model">chatroom.new.conversation.wizard</field>
        <field name="arch" type="xml">
            <form string="Nueva conversación">
                <group>
                    <field name="partner_id"
                           placeholder="Buscá un contacto o escribí uno nuevo..."/>
                    <field name="phone"/>
                    <field name="whatsapp_number_id"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Iniciar conversación"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_chatroom_new_conversation_wizard" model="ir.actions.act_window">
        <field name="name">Nueva conversación</field>
        <field name="res_model">chatroom.new.conversation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
