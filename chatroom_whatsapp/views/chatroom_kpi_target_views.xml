<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_kpi_target_list" model="ir.ui.view">
        <field name="name">chatroom.kpi.target.list</field>
        <field name="model">chatroom.kpi.target</field>
        <field name="arch" type="xml">
            <list>
                <field name="kpi_id" string="KPI"/>
                <field name="scope_type" string="Alcance"/>
                <field name="company_id" string="Compañía"/>
                <field name="user_id" string="Agente"/>
                <field name="whatsapp_number_id" string="Línea de WhatsApp"/>
                <field name="target_value" string="Valor objetivo"/>
                <field name="goal_direction" string="Cumplimiento"/>
                <field name="period_type" string="Período"/>
                <field name="date_from" string="Desde" optional="hide"/>
                <field name="date_to" string="Hasta" optional="hide"/>
                <field name="active" string="Activo"/>
            </list>
        </field>
    </record>

    <record id="view_chatroom_kpi_target_search" model="ir.ui.view">
        <field name="name">chatroom.kpi.target.search</field>
        <field name="model">chatroom.kpi.target</field>
        <field name="arch" type="xml">
            <search string="Buscar objetivos KPI">
                <field name="kpi_id" string="KPI"/>
                <field name="user_id" string="Agente"/>
                <field name="whatsapp_number_id" string="Línea"/>
                <filter name="active" string="Activos" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archivados" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="global" string="Globales" domain="[('scope_type', '=', 'global')]"/>
                <filter name="company" string="Por compañía" domain="[('scope_type', '=', 'company')]"/>
                <filter name="agent" string="Por agente" domain="[('scope_type', '=', 'agent')]"/>
                <filter name="line" string="Por línea" domain="[('scope_type', '=', 'line')]"/>
                <group>
                    <filter name="group_kpi" string="KPI" context="{'group_by': 'kpi_id'}"/>
                    <filter name="group_scope" string="Alcance" context="{'group_by': 'scope_type'}"/>
                    <filter name="group_period" string="Período" context="{'group_by': 'period_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_chatroom_kpi_target_form" model="ir.ui.view">
        <field name="name">chatroom.kpi.target.form</field>
        <field name="model">chatroom.kpi.target</field>
        <field name="arch" type="xml">
            <form string="Objetivo de KPI" class="o_chatroom_kpi_target_form">
                <header>
                    <field name="active" widget="boolean_toggle" string="Activo"/>
                </header>
                <sheet class="o_chatroom_kpi_target_sheet">
                    <div class="o_chatroom_kpi_target_banner alert alert-info" role="alert">
                        Define una meta medible para un KPI global, una compañía, un agente o una línea de WhatsApp.
                    </div>
                    <div class="o_chatroom_kpi_target_hero oe_title">
                        <h1><field name="kpi_id" string="KPI"/></h1>
                    </div>
                    <group class="o_chatroom_kpi_target_summary">
                        <group>
                            <field name="scope_type" string="Alcance"/>
                            <field name="company_id" string="Compañía"/>
                            <field name="user_id" string="Agente" invisible="scope_type != 'agent'"/>
                            <field name="whatsapp_number_id" string="Línea de WhatsApp" invisible="scope_type != 'line'"/>
                        </group>
                        <group>
                            <field name="target_value" string="Valor objetivo"/>
                            <field name="goal_direction" string="Regla de cumplimiento"/>
                            <field name="period_type" string="Período del objetivo"/>
                        </group>
                    </group>
                    <group string="Vigencia" class="o_chatroom_kpi_target_period" invisible="period_type != 'custom'">
                        <field name="date_from" string="Desde"/>
                        <field name="date_to" string="Hasta"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_chatroom_kpi_target" model="ir.actions.act_window">
        <field name="name">Objetivos por agente y línea</field>
        <field name="res_model">chatroom.kpi.target</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_chatroom_kpi_target_search"/>
        <field name="limit">40</field>
    </record>
    <menuitem id="menu_chatroom_config_kpi_targets" name="Objetivos por agente y línea"
              parent="menu_chatroom_config_analytics" action="action_chatroom_kpi_target"
              sequence="16" groups="chatroom_whatsapp.group_chatroom_manager"/>
</odoo>
