<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.chatroom.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Chatroom WhatsApp" string="Chatroom WhatsApp" name="chatroom_whatsapp">

                    <block title="WhatsApp Business Cloud API (Meta)">
                        <setting id="whatsapp_phone_number_id_setting"
                                 help="Obtenlo en Meta Business Suite &gt; WhatsApp &gt; API Setup">
                            <field name="whatsapp_phone_number_id"/>
                        </setting>
                        <setting id="whatsapp_business_account_id_setting">
                            <field name="whatsapp_business_account_id"/>
                        </setting>
                        <setting id="whatsapp_access_token_setting"
                                 help="Token de un System User de Meta Business. No pasa por ningún proveedor externo: se usa directo contra graph.facebook.com">
                            <field name="whatsapp_access_token" password="True"/>
                        </setting>
                        <setting id="whatsapp_graph_api_version_setting">
                            <field name="whatsapp_graph_api_version"/>
                        </setting>
                        <setting id="whatsapp_webhook_verify_token_setting">
                            <field name="whatsapp_webhook_verify_token"/>
                        </setting>
                        <setting id="whatsapp_app_secret_setting">
                            <field name="whatsapp_app_secret" password="True"/>
                        </setting>
                        <setting id="whatsapp_webhook_url_setting"
                                 help="Copia esta URL y el Verify Token en el panel de la App de Meta (WhatsApp &gt; Configuration &gt; Webhook)">
                            <field name="whatsapp_webhook_url" readonly="1"/>
                        </setting>
                        <setting id="whatsapp_last_webhook_setting"
                                 help="Última vez que Meta nos mandó un evento. Si dice 'Nunca', revisá que la URL de arriba esté bien registrada en Meta">
                            <field name="whatsapp_last_webhook_display" readonly="1"/>
                        </setting>
                        <setting id="whatsapp_test_connection_setting"
                                 help="Valida el token y el Phone Number ID contra Meta sin enviar ningún mensaje">
                            <button name="action_test_whatsapp_connection" type="object"
                                    string="Probar conexión" class="btn-secondary"/>
                        </setting>
                        <setting id="chatroom_auto_assign_setting"
                                 help="Reparte las conversaciones nuevas entre los agentes del grupo 'Chatroom / Agente', priorizando al que menos conversaciones abiertas tenga">
                            <field name="chatroom_auto_assign"/>
                        </setting>
                    </block>

                    <block title="Ubicación del negocio">
                        <setting id="chatroom_business_location_setting"
                                 help="Para el botón 'Enviar ubicación' del composer del chat">
                            <div class="content-group">
                                <div class="mt8">
                                    <label for="chatroom_business_location_name" string="Nombre"/>
                                    <field name="chatroom_business_location_name"/>
                                </div>
                                <div class="mt8">
                                    <label for="chatroom_business_location_address" string="Dirección"/>
                                    <field name="chatroom_business_location_address"/>
                                </div>
                                <div class="mt8">
                                    <label for="chatroom_business_location_lat" string="Latitud"/>
                                    <field name="chatroom_business_location_lat"/>
                                </div>
                                <div class="mt8">
                                    <label for="chatroom_business_location_lng" string="Longitud"/>
                                    <field name="chatroom_business_location_lng"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="SLA y reasignación automática">
                        <setting id="chatroom_sla_enabled_setting"
                                 help="Muestra el contador de primera respuesta y permite liberar conversaciones vencidas">
                            <field name="chatroom_sla_enabled"/>
                        </setting>
                        <setting id="chatroom_sla_thresholds_setting"
                                 invisible="not chatroom_sla_enabled">
                            <div class="content-group">
                                <div class="mt8">
                                    <label for="chatroom_sla_yellow_minutes" string="Alerta amarilla"/>
                                    <field name="chatroom_sla_yellow_minutes"/>
                                    <span class="text-muted"> minutos</span>
                                </div>
                                <div class="mt8">
                                    <label for="chatroom_sla_red_minutes" string="Vencimiento rojo"/>
                                    <field name="chatroom_sla_red_minutes"/>
                                    <span class="text-muted"> minutos</span>
                                </div>
                            </div>
                        </setting>
                        <setting id="chatroom_sla_auto_reassign_setting"
                                 invisible="not chatroom_sla_enabled"
                                 help="Quita el responsable vencido y asigna la conversación al siguiente agente disponible">
                            <field name="chatroom_sla_auto_reassign"/>
                        </setting>
                        <setting id="chatroom_waiting_response_setting"
                                 invisible="not chatroom_sla_enabled"
                                 help="Envía una alerta push y un correo al asesor cuando el cliente espera respuesta.">
                            <field name="chatroom_waiting_response_minutes"/>
                        </setting>
                        <setting id="chatroom_transcript_pdf_max_messages_setting"
                                 help="El PDF usa los mensajes más recientes hasta este límite para proteger el rendimiento del servidor.">
                            <field name="chatroom_transcript_pdf_max_messages"/>
                        </setting>
                    </block>

                    <block title="Messenger / Instagram">
                        <setting id="chatroom_meta_page_access_token_setting"
                                 help="Page Access Token de la Página conectada a tu App de Meta. Usa la misma App y el mismo webhook que WhatsApp, pero necesita su propio token para enviar mensajes">
                            <field name="chatroom_meta_page_access_token" password="True"/>
                        </setting>
                    </block>

                    <block title="Horario de atención">
                        <setting id="chatroom_business_hours_enabled_setting"
                                 help="Fuera de este horario se manda un aviso automático (una vez por día por conversación) en vez de dejar a alguien esperando toda la noche">
                            <field name="chatroom_business_hours_enabled"/>
                            <div class="content-group" invisible="not chatroom_business_hours_enabled">
                                <div class="mt8">
                                    <label for="chatroom_business_hours_start" string="Desde"/>
                                    <field name="chatroom_business_hours_start" widget="float_time"/>
                                </div>
                                <div class="mt8">
                                    <label for="chatroom_business_hours_end" string="Hasta"/>
                                    <field name="chatroom_business_hours_end" widget="float_time"/>
                                </div>
                                <div class="mt8">
                                    <label for="chatroom_business_hours_weekdays" string="Días"/>
                                    <field name="chatroom_business_hours_weekdays"/>
                                </div>
                                <div class="mt8">
                                    <label for="chatroom_business_hours_tz" string="Zona horaria"/>
                                    <field name="chatroom_business_hours_tz" placeholder="America/Guayaquil"/>
                                </div>
                                <div class="mt8">
                                    <label for="chatroom_business_hours_away_message" string="Mensaje"/>
                                    <field name="chatroom_business_hours_away_message"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Cumplimiento (opt-out)">
                        <setting id="chatroom_opt_out_keywords_setting"
                                 help="Separadas por comas. Escribir a quien pidió no recibir más es la causa más común de que Meta bloquee un número">
                            <field name="chatroom_opt_out_keywords"/>
                        </setting>
                        <setting id="chatroom_opt_in_keywords_setting">
                            <field name="chatroom_opt_in_keywords"/>
                        </setting>
                    </block>

                    <block title="Sugerencias de respuesta con IA">
                        <setting id="chatroom_ai_enabled_setting">
                            <field name="chatroom_ai_enabled"/>
                            <div class="content-group" invisible="not chatroom_ai_enabled">
                                <div class="mt8">
                                    <label for="chatroom_ai_provider_url" string="Endpoint API"/>
                                    <field name="chatroom_ai_provider_url"/>
                                </div>
                                <div class="mt8">
                                    <label for="chatroom_ai_api_key" string="API Key"/>
                                    <field name="chatroom_ai_api_key" password="True"/>
                                </div>
                                <div class="mt8">
                                    <label for="chatroom_ai_model" string="Modelo"/>
                                    <field name="chatroom_ai_model"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Automatización" invisible="not chatroom_ai_enabled">
                        <setting id="chatroom_ai_auto_classify_setting"
                                 help="Etiqueta cada conversación como Consulta, Venta, Soporte o Queja al recibir un mensaje">
                            <field name="chatroom_ai_auto_classify"/>
                        </setting>
                        <setting id="chatroom_ai_auto_lead_setting"
                                 help="Requiere la clasificación automática activa. Crea y ancla una Oportunidad cuando la IA detecta intención de compra">
                            <field name="chatroom_ai_auto_lead"/>
                        </setting>
                        <setting id="chatroom_ai_auto_reply_setting"
                                 help="Envía la respuesta generada sin revisión de un agente. Úsalo con precaución">
                            <field name="chatroom_ai_auto_reply"/>
                        </setting>
                        <setting id="chatroom_ai_require_approval_setting"
                                 help="Deja la respuesta preparada para revisión humana antes de enviarla. Recomendado">
                            <field name="chatroom_ai_require_approval"/>
                        </setting>
                        <setting id="chatroom_ai_auto_price_reply_setting"
                                 help="Contesta con el precio real de Odoo cuando el cliente menciona un producto por su nombre; no inventa precios">
                            <field name="chatroom_ai_auto_price_reply"/>
                        </setting>
                        <setting id="chatroom_ai_auto_order_reply_setting"
                                 help="Arma un carrito charlando con el cliente y crea una Cotización real en borrador cuando confirma; nunca la confirma sola">
                            <field name="chatroom_ai_auto_order_reply"/>
                        </setting>
                    </block>

                    <block title="Notificaciones automáticas por WhatsApp">
                        <setting id="chatroom_notify_order_confirmed_setting"
                                 help="Se manda sola al confirmar un presupuesto, solo a contactos que ya tienen una conversación de WhatsApp">
                            <field name="chatroom_notify_order_confirmed_template_id"/>
                        </setting>
                        <setting id="chatroom_notify_invoice_posted_setting"
                                 help="Se manda sola al publicar una factura de cliente, mismo criterio">
                            <field name="chatroom_notify_invoice_posted_template_id"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

</odoo>
