<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.chatroom.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Chatroom WhatsApp" string="Chatroom WhatsApp" name="chatroom_whatsapp">

                    <block title="WhatsApp Business Cloud API (Meta)">
                        <setting id="whatsapp_phone_number_id_setting"
                                 help="Obtenlo en Meta Business Suite &gt; WhatsApp &gt; API Setup">
                            <field name="whatsapp_phone_number_id"/>
                        </setting>
                        <setting id="whatsapp_business_account_id_setting">
                            <field name="whatsapp_business_account_id"/>
                        </setting>
                        <setting id="whatsapp_access_token_setting"
                                 help="Token de un System User de Meta Business. No pasa por ningún proveedor externo: se usa directo contra graph.facebook.com">
                            <field name="whatsapp_access_token" password="True"/>
                        </setting>
                        <setting id="whatsapp_graph_api_version_setting">
                            <field name="whatsapp_graph_api_version"/>
                        </setting>
                        <setting id="whatsapp_webhook_verify_token_setting">
                            <field name="whatsapp_webhook_verify_token"/>
                        </setting>
                        <setting id="whatsapp_app_secret_setting">
                            <field name="whatsapp_app_secret" password="True"/>
                        </setting>
                        <setting id="whatsapp_webhook_url_setting"
                                 help="Copia esta URL y el Verify Token en el panel de la App de Meta (WhatsApp &gt; Configuration &gt; Webhook)">
                            <field name="whatsapp_webhook_url" readonly="1"/>
                        </setting>
                        <setting id="chatroom_auto_assign_setting"
                                 help="Reparte las conversaciones nuevas entre los agentes del grupo 'Chatroom / Agente', priorizando al que menos conversaciones abiertas tenga">
                            <field name="chatroom_auto_assign"/>
                        </setting>
                    </block>

                    <block title="Messenger / Instagram">
                        <setting id="chatroom_meta_page_access_token_setting"
                                 help="Page Access Token de la Página conectada a tu App de Meta. Usa la misma App y el mismo webhook que WhatsApp, pero necesita su propio token para enviar mensajes">
                            <field name="chatroom_meta_page_access_token" password="True"/>
                        </setting>
                    </block>

                    <block title="Cumplimiento (opt-out)">
                        <setting id="chatroom_opt_out_keywords_setting"
                                 help="Separadas por comas. Escribir a quien pidió no recibir más es la causa más común de que Meta bloquee un número">
                            <field name="chatroom_opt_out_keywords"/>
                        </setting>
                        <setting id="chatroom_opt_in_keywords_setting">
                            <field name="chatroom_opt_in_keywords"/>
                        </setting>
                    </block>

                    <block title="Sugerencias de respuesta con IA">
                        <setting id="chatroom_ai_enabled_setting">
                            <field name="chatroom_ai_enabled"/>
                            <div class="content-group" invisible="not chatroom_ai_enabled">
                                <div class="mt8">
                                    <label for="chatroom_ai_provider_url" string="Endpoint API"/>
                                    <field name="chatroom_ai_provider_url"/>
                                </div>
                                <div class="mt8">
                                    <label for="chatroom_ai_api_key" string="API Key"/>
                                    <field name="chatroom_ai_api_key" password="True"/>
                                </div>
                                <div class="mt8">
                                    <label for="chatroom_ai_model" string="Modelo"/>
                                    <field name="chatroom_ai_model"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Automatización" invisible="not chatroom_ai_enabled">
                        <setting id="chatroom_ai_auto_classify_setting"
                                 help="Etiqueta cada conversación como Consulta, Venta, Soporte o Queja al recibir un mensaje">
                            <field name="chatroom_ai_auto_classify"/>
                        </setting>
                        <setting id="chatroom_ai_auto_lead_setting"
                                 help="Requiere la clasificación automática activa. Crea y ancla una Oportunidad cuando la IA detecta intención de compra">
                            <field name="chatroom_ai_auto_lead"/>
                        </setting>
                        <setting id="chatroom_ai_auto_reply_setting"
                                 help="Envía la respuesta generada sin revisión de un agente. Úsalo con precaución">
                            <field name="chatroom_ai_auto_reply"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

</odoo>
