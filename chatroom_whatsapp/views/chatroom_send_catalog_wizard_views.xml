<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chatroom_send_catalog_wizard_form" model="ir.ui.view">
        <field name="name">chatroom.send.catalog.wizard.form</field>
        <field name="model">chatroom.send.catalog.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar catálogo de productos" class="o_chatroom_workflow_sheet">
                <div class="o_chatroom_workflow_intro">
                    <strong>Comparte productos de forma clara</strong>
                    <span>El catalogo interactivo admite hasta 10 productos.</span>
                </div>
                <group class="o_chatroom_workflow_step">
                    <field name="channel_id" invisible="1"/>
                    <field name="product_ids" widget="many2many_tags"/>
                </group>
                <group string="Revision antes de enviar" class="o_chatroom_workflow_preview">
                    <field name="readiness_message" nolabel="1" readonly="1"/>
                    <field name="preview" string="Productos seleccionados" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Enviar"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_chatroom_send_catalog_wizard" model="ir.actions.act_window">
        <field name="name">Enviar catálogo</field>
        <field name="res_model">chatroom.send.catalog.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
