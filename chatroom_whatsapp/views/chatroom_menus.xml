<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_chatroom_root" name="Chatroom" sequence="30"/>

    <menuitem id="menu_chatroom_conversations" name="Conversaciones"
              parent="menu_chatroom_root" action="action_chatroom_channel"
              sequence="10"/>

    <menuitem id="menu_chatroom_messages" name="Mensajes (auditoría)"
              parent="menu_chatroom_root" action="action_chatroom_message"
              sequence="20" groups="chatroom_whatsapp.group_chatroom_manager"/>

    <menuitem id="menu_chatroom_config" name="Configuración"
              parent="menu_chatroom_root" sequence="90"
              groups="chatroom_whatsapp.group_chatroom_manager"/>

    <menuitem id="menu_chatroom_config_settings" name="Ajustes"
              parent="menu_chatroom_config" sequence="10"
              action="base_setup.action_general_configuration"/>

</odoo>
