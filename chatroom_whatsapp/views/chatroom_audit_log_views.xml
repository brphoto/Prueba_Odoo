<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_audit_log_list" model="ir.ui.view">
        <field name="name">chatroom.audit.log.list</field>
        <field name="model">chatroom.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="change_date"/><field name="channel_id"/>
                <field name="user_id"/><field name="change_type"/>
                <field name="old_value"/><field name="new_value"/><field name="note"/>
            </list>
        </field>
    </record>
    <record id="view_chatroom_audit_log_form" model="ir.ui.view">
        <field name="name">chatroom.audit.log.form</field>
        <field name="model">chatroom.audit.log</field>
        <field name="arch" type="xml">
            <form string="Auditoría de Chatroom"><header>
                <button name="action_open_channel" type="object" string="Abrir conversación" class="btn-primary"/>
            </header><sheet><group>
                <field name="change_date"/><field name="channel_id"/><field name="user_id"/>
                <field name="change_type"/><field name="old_value"/><field name="new_value"/><field name="note"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_chatroom_audit_log" model="ir.actions.act_window">
        <field name="name">Auditoría de conversaciones</field>
        <field name="res_model">chatroom.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_chatroom_audit_log" name="Auditoría de conversaciones"
              parent="menu_chatroom_operation" action="action_chatroom_audit_log"
              sequence="17" groups="chatroom_whatsapp.group_chatroom_supervisor"/>
</odoo>
