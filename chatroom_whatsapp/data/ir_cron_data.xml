<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_close_inactive_chatroom_channels" model="ir.cron">
        <field name="name">Chatroom: cerrar conversaciones inactivas</field>
        <field name="model_id" ref="model_chatroom_channel"/>
        <field name="state">code</field>
        <field name="code">model._cron_close_inactive_channels(days=7)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_retry_failed_chatroom_messages" model="ir.cron">
        <field name="name">Chatroom: reintentar mensajes fallidos</field>
        <field name="model_id" ref="model_chatroom_channel"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry_failed_messages()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_send_scheduled_chatroom_messages" model="ir.cron">
        <field name="name">Chatroom: enviar mensajes programados</field>
        <field name="model_id" ref="model_chatroom_scheduled_message"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_scheduled_messages()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

</odoo>
