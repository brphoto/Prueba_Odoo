<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="chatroom_stage_new" model="chatroom.channel.stage">
        <field name="name">Nueva</field>
        <field name="sequence">10</field>
        <field name="color">4</field>
        <field name="technical_state">open</field>
        <field name="default_for_new">True</field>
    </record>
    <record id="chatroom_stage_in_progress" model="chatroom.channel.stage">
        <field name="name">En atención</field>
        <field name="sequence">20</field>
        <field name="color">10</field>
        <field name="technical_state">open</field>
    </record>
    <record id="chatroom_stage_waiting_customer" model="chatroom.channel.stage">
        <field name="name">Esperando al cliente</field>
        <field name="sequence">30</field>
        <field name="color">3</field>
        <field name="technical_state">pending</field>
    </record>
    <record id="chatroom_stage_resolved" model="chatroom.channel.stage">
        <field name="name">Resuelta</field>
        <field name="sequence">40</field>
        <field name="color">2</field>
        <field name="technical_state">closed</field>
        <field name="is_final">True</field>
    </record>
    <record id="chatroom_stage_closed" model="chatroom.channel.stage">
        <field name="name">Cerrada</field>
        <field name="sequence">50</field>
        <field name="color">1</field>
        <field name="technical_state">closed</field>
        <field name="is_final">True</field>
        <field name="fold">True</field>
    </record>
</odoo>
