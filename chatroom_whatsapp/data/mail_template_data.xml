<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_waiting_response" model="mail.template">
        <field name="name">Chatroom: cliente esperando respuesta</field>
        <field name="model_id" ref="model_chatroom_channel"/>
        <field name="subject">Cliente esperando respuesta en el chat</field>
        <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
        <field name="email_to">{{ object.assigned_user_id.partner_id.email }}</field>
        <field name="body_html" type="html">
            <p>El cliente <strong><t t-out="object.partner_id.name or object.external_id"/></strong> está esperando respuesta en el chat.</p>
            <p><t t-out="object.last_message_preview or ''"/></p>
        </field>
    </record>
</odoo>
