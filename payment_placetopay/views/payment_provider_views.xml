<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">PlacetoPay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group name="placetopay_credentials" invisible="code != 'placetopay'">
                    <field name="placetopay_login"
                           required="code == 'placetopay' and state != 'disabled'"/>
                    <field name="placetopay_secret_key" password="True"
                           required="code == 'placetopay' and state != 'disabled'"/>
                    <field name="placetopay_base_url"
                           required="code == 'placetopay' and state != 'disabled'"/>
                    <field name="placetopay_locale"
                           required="code == 'placetopay' and state != 'disabled'"/>
                    <field name="placetopay_document_type"
                           required="code == 'placetopay' and state != 'disabled'"/>
                    <div class="alert alert-info mt-2" invisible="state != 'test'">
                        En modo de prueba, use la URL sandbox
                        <b>https://checkout-test.placetopay.com</b>
                        con las credenciales de pruebas entregadas por PlacetoPay.
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
