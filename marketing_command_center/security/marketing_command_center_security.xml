<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_marketing_command_center" model="ir.module.category">
        <field name="name">Marketing social</field>
        <field name="description">Permisos del centro de mando de marketing social.</field>
        <field name="sequence">35</field>
    </record>
    <record id="privilege_marketing_command_center" model="res.groups.privilege">
        <field name="name">Marketing social</field>
        <field name="category_id" ref="module_category_marketing_command_center"/>
    </record>
    <record id="group_marketing_user" model="res.groups">
        <field name="name">Usuario de marketing social</field>
        <field name="privilege_id" ref="privilege_marketing_command_center"/>
    </record>
    <record id="group_marketing_manager" model="res.groups">
        <field name="name">Administrador de marketing social</field>
        <field name="privilege_id" ref="privilege_marketing_command_center"/>
        <field name="implied_ids" eval="[(4, ref('group_marketing_user'))]"/>
    </record>

    <!-- Todos los registros de marketing están aislados por compañía. -->
    <record id="marketing_social_company_rule" model="ir.rule">
        <field name="name">Marketing social: compañías autorizadas</field>
        <field name="model_id" ref="model_marketing_social_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_marketing_user'))]"/>
    </record>
    <record id="marketing_social_campaign_company_rule" model="ir.rule">
        <field name="name">Marketing social: campañas por compañía</field>
