<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Sin esto, el centro de mando solo se actualizaba cuando alguien
            entraba y pulsaba el boton: los numeros envejecian en silencio y
            nadie podia distinguir un panel al dia de uno de la semana
            pasada. Cada hora es suficiente para metricas de redes sociales,
            que los proveedores publican con retraso de todos modos.
        -->
        <record id="ir_cron_marketing_refresh_dashboards" model="ir.cron">
            <field name="name">Marketing: actualizar centros de mando</field>
            <field name="model_id" ref="model_marketing_social_dashboard"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_dashboards()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
