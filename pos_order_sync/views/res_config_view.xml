<odoo>
    <record id="res_config_settings_view_form_pos_order_sync" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_order_sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="after">
                <block title="POS Order Sync" id="Order_sync" help="Select between the option to print quotation as browser based Pdf Reprot or Xml Receipt(POSBOX)">
                    <setting string="Quotation Print Type">
                        <field name="pos_quotation_print_type"/>
                    </setting>    
					<setting string="Seguimiento de transferencias" help="Registra el cajero que recibe un pedido desde otra caja y muestra el resumen en las sesiones.">
                        <field name="pos_enable_transfer_tracking"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
