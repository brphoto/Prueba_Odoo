<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_payroll" inherit_id="portal.portal_my_home" priority="30"><xpath expr="//div[hasclass('o_portal_docs')]" position="inside"><t t-call="portal.portal_docs_entry"><t t-set="title">Nómina</t><t t-set="url" t-value="'/my/payroll/payslips'"/><t t-set="text">Desprendibles y solicitudes</t><t t-set="placeholder_count">payroll_count</t></t></xpath></template>
    <template id="portal_payroll_payslips" name="Desprendibles del empleado"><t t-call="portal.portal_layout"><div class="container o_payroll_portal"><h2>Mis desprendibles</h2><t t-if="employee"><p class="text-muted"><t t-esc="employee.name"/></p></t><t t-if="payslips"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Referencia</th><th>Desde</th><th>Hasta</th><th>Estado</th><th></th></tr></thead><tbody><tr t-foreach="payslips" t-as="slip"><td><t t-esc="slip.name"/></td><td><t t-esc="slip.date_from"/></td><td><t t-esc="slip.date_to"/></td><td><t t-esc="slip.state"/></td><td><a t-att-href="'/my/payroll/payslip/%s' % slip.id" class="btn btn-sm btn-primary">Ver</a></td></tr></tbody></table></div></t><t t-else=""><div class="alert alert-info">No hay desprendibles publicados.</div></t><a href="/my/payroll/documents" class="btn btn-outline-secondary me-2">Mis documentos</a><a href="/my/payroll/requests" class="btn btn-outline-primary">Mis solicitudes</a></div></t></template>
    <template id="portal_payroll_payslip" name="Detalle del desprendible"><t t-call="portal.portal_layout"><div class="container o_payroll_portal"><a href="/my/payroll/payslips">← Volver</a><a t-att-href="'/my/payroll/payslip/%s/pdf' % payslip.id" class="btn btn-primary float-end">Descargar PDF</a><h2 class="mt-3"><t t-esc="payslip.name"/></h2><div class="row"><div class="col-md-6"><p><strong>Empleado:</strong> <t t-esc="payslip.employee_id.name"/></p><p><strong>Periodo:</strong> <t t-esc="payslip.date_from"/> - <t t-esc="payslip.date_to"/></p></div><div class="col-md-6"><p><strong>Devengado:</strong> <t t-esc="payslip.gross_wage"/></p><p><strong>Neto:</strong> <t t-esc="payslip.net_wage"/></p></div></div><table class="table table-sm"><thead><tr><th>Concepto</th><th class="text-end">Total</th></tr></thead><tbody><tr t-foreach="payslip.line_ids" t-as="line"><td><t t-esc="line.name"/></td><td class="text-end"><t t-esc="line.total"/></td></tr></tbody></table></div></t></template>
    <template id="portal_payroll_requests" name="Solicitudes del empleado"><t t-call="portal.portal_layout"><div class="container o_payroll_portal"><h2>Mis solicitudes</h2><form action="/my/payroll/request/create" method="post" class="card card-body mb-4"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="row"><div class="col-md-3"><label>Tipo</label><select name="request_type" class="form-select"><option value="vacation">Vacaciones</option><option value="permission">Permiso</option><option value="data_change">Cambio de datos</option><option value="bank_change">Cambio de cuenta bancaria</option><option value="certificate">Certificado</option><option value="other">Otra</option></select></div><div class="col-md-3"><label>Desde</label><input type="date" name="date_from" class="form-control"/></div><div class="col-md-3"><label>Hasta</label><input type="date" name="date_to" class="form-control"/></div><div class="col-md-3"><label>Detalle</label><input required="required" name="description" class="form-control"/></div></div><button class="btn btn-primary mt-3" type="submit">Enviar solicitud</button></form><table class="table table-hover"><thead><tr><th>Tipo</th><th>Detalle</th><th>Estado</th><th>Fecha</th></tr></thead><tbody><tr t-foreach="requests" t-as="item"><td><t t-esc="item.request_type"/></td><td><t t-esc="item.description"/></td><td><t t-esc="item.state"/></td><td><t t-esc="item.create_date"/></td></tr></tbody></table></div></t></template>
    <template id="portal_payroll_requests" name="Solicitudes del empleado"><t t-call="portal.portal_layout"><div class="container o_payroll_portal"><h2>Mis solicitudes</h2><form action="/my/payroll/request/create" method="post" class="card card-body mb-4"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="row"><div class="col-md-3"><label>Tipo</label><select name="request_type" class="form-select"><option value="vacation">Vacaciones</option><option value="permission">Permiso</option><option value="data_change">Cambio de datos</option><option value="bank_change">Cambio de cuenta bancaria</option><option value="certificate">Certificado</option><option value="other">Otra</option></select></div><div class="col-md-3"><label>Desde</label><input type="date" name="date_from" class="form-control"/></div><div class="col-md-3"><label>Hasta</label><input type="date" name="date_to" class="form-control"/></div><div class="col-md-3"><label>Detalle</label><input required="required" name="description" class="form-control"/></div></div><button class="btn btn-primary mt-3" type="submit">Enviar solicitud</button></form><table class="table table-hover"><thead><tr><th>Tipo</th><th>Detalle</th><th>Estado</th><th>Fecha</th></tr></thead><tbody><tr t-foreach="requests" t-as="item"><td><t t-esc="item.request_type"/></td><td><t t-esc="item.description"/></td><td><t t-esc="item.state"/></td><td><t t-esc="item.create_date"/></td></tr></tbody></table><a href="/my/payroll/payslips" class="btn btn-outline-secondary">Volver a nómina</a></div></t></template>
    <template id="portal_payroll_documents" name="Documentos laborales del empleado"><t t-call="portal.portal_layout"><div class="container o_payroll_portal"><h2>Mis documentos laborales</h2><t t-if="documents"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Documento</th><th>Tipo</th><th>Fecha</th><th>Vencimiento</th><th></th></tr></thead><tbody><tr t-foreach="documents" t-as="document"><td><t t-esc="document.name"/></td><td><t t-esc="document.document_type"/></td><td><t t-esc="document.document_date"/></td><td><t t-esc="document.expiry_date or 'Sin vencimiento'"/></td><td><a t-att-href="'/my/payroll/document/%s/download' % document.id" class="btn btn-sm btn-primary">Descargar</a></td></tr></tbody></table></div></t><t t-else=""><div class="alert alert-info">No hay documentos publicados para tu usuario.</div></t><a href="/my/payroll/payslips" class="btn btn-outline-secondary">Volver a nómina</a></div></t></template>
    <template id="portal_payroll_requests_bank_fields" inherit_id="l10n_co_payroll_portal.portal_payroll_requests">
        <xpath expr="//input[@name='description']" position="after">
            <div class="col-md-3"><label>Cuenta bancaria (si aplica)</label><input name="bank_account_number" class="form-control"/></div>
            <div class="col-md-3"><label>Banco</label><input name="bank_name" class="form-control"/></div>
        </xpath>
    </template>
</odoo>
