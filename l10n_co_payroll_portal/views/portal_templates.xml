<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_payroll" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Mi portal de nómina</t>
                <t t-set="url" t-value="'/my/payroll'"/>
                <t t-set="text">Desprendibles, documentos y solicitudes</t>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="portal_payroll_payslips" name="Desprendibles del colaborador">
        <t t-call="portal.portal_layout">
            <div class="container o_payroll_portal">
                <div class="o_payroll_portal_header">
                    <div><div class="o_payroll_portal_eyebrow">Portal de colaboradores</div><h2>Mis desprendibles</h2><p class="o_payroll_portal_subtitle"><t t-esc="employee.name if employee else 'Colaborador'"/> · Consulta y descarga tus comprobantes.</p></div>
                    <div class="o_payroll_portal_actions"><a href="/my/payroll/documents" class="btn btn-outline-secondary">Documentos</a><a href="/my/payroll/requests" class="btn btn-primary">Nueva solicitud</a></div>
                </div>
                <div class="o_payroll_metric_grid">
                    <div class="o_payroll_metric"><div class="o_payroll_metric_label">Desprendibles disponibles</div><div class="o_payroll_metric_value"><t t-esc="len(payslips)"/></div></div>
                    <div class="o_payroll_metric"><div class="o_payroll_metric_label">Estado del portal</div><div class="o_payroll_metric_value">Activo</div></div>
                    <div class="o_payroll_metric"><div class="o_payroll_metric_label">Acceso</div><div class="o_payroll_metric_value">Seguro</div></div>
                </div>
                <div class="o_payroll_panel">
                    <div class="o_payroll_panel_header"><h3>Historial de nómina</h3><span class="o_payroll_status">Información personal</span></div>
                    <t t-if="payslips">
                        <div class="table-responsive"><table class="table">
                            <thead><tr><th>Referencia</th><th>Desde</th><th>Hasta</th><th>Estado</th><th class="text-end">Acción</th></tr></thead>
                            <tbody><tr t-foreach="payslips" t-as="slip"><td><strong><t t-esc="slip.name"/></strong></td><td><t t-esc="slip.date_from"/></td><td><t t-esc="slip.date_to"/></td><td><span class="o_payroll_status"><t t-esc="slip.state"/></span></td><td class="text-end"><a t-att-href="'/my/payroll/payslip/%s' % slip.id" class="btn btn-sm btn-primary">Ver detalle</a></td></tr></tbody>
                        </table></div>
                    </t>
                    <t t-else=""><div class="o_payroll_empty"><strong>Aún no tienes desprendibles publicados.</strong><br/>Cuando nómina publique uno, aparecerá aquí automáticamente.</div></t>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_payroll_payslip" name="Detalle del desprendible">
        <t t-call="portal.portal_layout">
            <div class="container o_payroll_portal">
                <div class="o_payroll_portal_header"><div><div class="o_payroll_portal_eyebrow">Detalle de nómina</div><h2><t t-esc="payslip.name"/></h2><p class="o_payroll_portal_subtitle">Período: <t t-esc="payslip.date_from"/> - <t t-esc="payslip.date_to"/></p></div><div class="o_payroll_portal_actions"><a href="/my/payroll/payslips" class="btn btn-outline-secondary">Volver</a><a t-att-href="'/my/payroll/payslip/%s/pdf' % payslip.id" class="btn btn-primary">Descargar PDF</a></div></div>
                <div class="o_payroll_metric_grid">
                    <div class="o_payroll_metric"><div class="o_payroll_metric_label">Colaborador</div><div class="o_payroll_metric_value"><t t-esc="payslip.employee_id.name"/></div></div>
                    <div class="o_payroll_metric"><div class="o_payroll_metric_label">Devengado</div><div class="o_payroll_metric_value"><span t-field="payslip.gross_wage" t-options="{'widget': 'monetary', 'display_currency': payslip.currency_id}"/></div></div>
                    <div class="o_payroll_metric"><div class="o_payroll_metric_label">Neto a pagar</div><div class="o_payroll_metric_value"><span t-field="payslip.net_wage" t-options="{'widget': 'monetary', 'display_currency': payslip.currency_id}"/></div></div>
                </div>
                <div class="o_payroll_panel"><div class="o_payroll_panel_header"><h3>Conceptos del desprendible</h3><span class="o_payroll_status"><t t-esc="payslip.state"/></span></div><div class="table-responsive"><table class="table"><thead><tr><th>Concepto</th><th class="text-end">Total</th></tr></thead><tbody><tr t-foreach="payslip.line_ids" t-as="line"><td><t t-esc="line.name"/></td><td class="text-end"><span t-field="line.total" t-options="{'widget': 'monetary', 'display_currency': payslip.currency_id}"/></td></tr><tr t-if="not payslip.line_ids"><td colspan="2" class="text-center">No hay conceptos detallados publicados.</td></tr></tbody></table></div></div>
            </div>
        </t>
    </template>

    <template id="portal_payroll_requests" name="Solicitudes del colaborador">
        <t t-call="portal.portal_layout">
            <div class="container o_payroll_portal"><div class="o_payroll_portal_header"><div><div class="o_payroll_portal_eyebrow">Autoservicio</div><h2>Mis solicitudes</h2><p class="o_payroll_portal_subtitle">Envía novedades a gestión humana y consulta su estado.</p></div><div class="o_payroll_portal_actions"><a href="/my/payroll/payslips" class="btn btn-outline-secondary">Mis desprendibles</a><a href="/my/payroll/documents" class="btn btn-outline-secondary">Documentos</a></div></div>
                <form action="/my/payroll/request/create" method="post" class="card card-body mb-4 o_payroll_form_card"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="row g-3"><div class="col-md-3"><label>Tipo de solicitud</label><select name="request_type" class="form-select"><option value="vacation">Vacaciones</option><option value="permission">Permiso</option><option value="data_change">Cambio de datos</option><option value="bank_change">Cambio de cuenta bancaria</option><option value="certificate">Certificado</option><option value="other">Otra</option></select></div><div class="col-md-3"><label>Desde</label><input type="date" name="date_from" class="form-control"/></div><div class="col-md-3"><label>Hasta</label><input type="date" name="date_to" class="form-control"/></div><div class="col-md-3"><label>Detalle</label><input required="required" name="description" class="form-control" placeholder="Describe tu solicitud"/></div><div class="col-md-6"><label>Cuenta bancaria, si aplica</label><input name="bank_account_number" class="form-control"/></div><div class="col-md-6"><label>Banco, si aplica</label><input name="bank_name" class="form-control"/></div></div><button class="btn btn-primary mt-4" type="submit">Enviar solicitud</button></form>
                <div class="o_payroll_panel"><div class="o_payroll_panel_header"><h3>Historial de solicitudes</h3></div><div class="table-responsive"><table class="table"><thead><tr><th>Tipo</th><th>Detalle</th><th>Estado</th><th>Fecha</th></tr></thead><tbody><tr t-foreach="requests" t-as="item"><td><t t-esc="item.request_type"/></td><td><t t-esc="item.description"/></td><td><span class="o_payroll_status"><t t-esc="item.state"/></span></td><td><t t-esc="item.create_date"/></td></tr><tr t-if="not requests"><td colspan="4" class="text-center">Todavía no has enviado solicitudes.</td></tr></tbody></table></div></div>
            </div>
        </t>
    </template>

    <template id="portal_payroll_documents" name="Documentos laborales del colaborador">
        <t t-call="portal.portal_layout">
            <div class="container o_payroll_portal"><div class="o_payroll_portal_header"><div><div class="o_payroll_portal_eyebrow">Tus archivos</div><h2>Mis documentos laborales</h2><p class="o_payroll_portal_subtitle">Documentos publicados y disponibles para descarga.</p></div><div class="o_payroll_portal_actions"><a href="/my/payroll/payslips" class="btn btn-outline-secondary">Mis desprendibles</a><a href="/my/payroll/requests" class="btn btn-primary">Nueva solicitud</a></div></div>
                <div class="o_payroll_panel"><div class="o_payroll_panel_header"><h3>Documentos disponibles</h3><span class="o_payroll_status"><t t-esc="len(documents)"/> disponibles</span></div><t t-if="documents"><div class="table-responsive"><table class="table"><thead><tr><th>Documento</th><th>Tipo</th><th>Fecha</th><th>Vencimiento</th><th class="text-end">Acción</th></tr></thead><tbody><tr t-foreach="documents" t-as="document"><td><strong><t t-esc="document.name"/></strong></td><td><t t-esc="document.document_type"/></td><td><t t-esc="document.document_date"/></td><td><t t-esc="document.expiry_date or 'Sin vencimiento'"/></td><td class="text-end"><a t-att-href="'/my/payroll/document/%s/download' % document.id" class="btn btn-sm btn-primary">Descargar</a></td></tr></tbody></table></div></t><t t-else=""><div class="o_payroll_empty">No hay documentos publicados para tu usuario.</div></t></div>
            </div>
        </t>
    </template>
    <template id="portal_payroll_dashboard" name="Panel de nómina del colaborador">
        <t t-call="portal.portal_layout">
            <div class="container o_payroll_portal o_payroll_dashboard">
                <div class="o_payroll_dashboard_hero">
                    <div><div class="o_payroll_portal_eyebrow">Autoservicio del colaborador</div><h1>Hola, <t t-esc="employee.name if employee else 'colaborador'"/></h1><p>Gestiona tu información laboral y tus solicitudes desde un solo lugar.</p></div>
                    <div class="o_payroll_dashboard_hero_actions"><a href="/my/payroll/profile" class="btn btn-light">Actualizar información</a></div>
                </div>
                <div class="o_payroll_metric_grid o_payroll_dashboard_metrics"><div class="o_payroll_metric"><div class="o_payroll_metric_label">Desprendibles</div><div class="o_payroll_metric_value"><t t-esc="len(payslips)"/></div><a href="/my/payroll/payslips">Ver historial</a></div><div class="o_payroll_metric"><div class="o_payroll_metric_label">Documentos</div><div class="o_payroll_metric_value"><t t-esc="len(documents)"/></div><a href="/my/payroll/documents">Ver documentos</a></div><div class="o_payroll_metric"><div class="o_payroll_metric_label">Solicitudes activas</div><div class="o_payroll_metric_value"><t t-esc="len(requests.filtered(lambda item: item.state in ['draft', 'submitted']))"/></div><a href="/my/payroll/requests">Ver solicitudes</a></div></div>
                <div class="o_payroll_section_title"><div><div class="o_payroll_portal_eyebrow">Acciones rápidas</div><h2>¿Qué necesitas hacer?</h2></div></div>
                <div class="o_payroll_action_grid">
                    <a class="o_payroll_action_card" href="/my/payroll/payslips"><span class="o_payroll_action_icon">▣</span><span><strong>Mis desprendibles</strong><small>Consulta y descarga tus comprobantes de nómina.</small></span><span class="o_payroll_action_arrow">›</span></a>
                    <a class="o_payroll_action_card" href="/my/payroll/documents"><span class="o_payroll_action_icon">▤</span><span><strong>Mis documentos</strong><small>Descarga certificados y documentos laborales.</small></span><span class="o_payroll_action_arrow">›</span></a>
                    <a class="o_payroll_action_card" href="/my/payroll/profile"><span class="o_payroll_action_icon">◎</span><span><strong>Actualizar información</strong><small>Solicita cambios en tus datos personales y de contacto.</small></span><span class="o_payroll_action_arrow">›</span></a>
                    <a class="o_payroll_action_card" href="/my/payroll/advance"><span class="o_payroll_action_icon">＋</span><span><strong>Solicitar anticipo</strong><small>Registra una solicitud de anticipo de nómina.</small></span><span class="o_payroll_action_arrow">›</span></a>
                    <a class="o_payroll_action_card" href="/my/payroll/loan"><span class="o_payroll_action_icon">$</span><span><strong>Solicitar préstamo</strong><small>Solicita un préstamo indicando valor y cuotas.</small></span><span class="o_payroll_action_arrow">›</span></a>
                    <a class="o_payroll_action_card" href="/my/payroll/requests"><span class="o_payroll_action_icon">✓</span><span><strong>Mis solicitudes</strong><small>Consulta el estado de vacaciones, permisos y novedades.</small></span><span class="o_payroll_action_arrow">›</span></a>
                </div>
                <div class="o_payroll_dashboard_note"><strong>¿Necesitas ayuda?</strong><span>Tu equipo de gestión humana revisará cada solicitud y actualizará su estado desde el sistema.</span></div>
            </div>
        </t>
    </template>

    <template id="portal_payroll_profile" name="Actualizar información del colaborador">
        <t t-call="portal.portal_layout">
            <div class="container o_payroll_portal"><div class="o_payroll_portal_header"><div><div class="o_payroll_portal_eyebrow">Mi información</div><h2>Actualizar información</h2><p class="o_payroll_portal_subtitle">Envía una solicitud para que gestión humana revise tus datos.</p></div><div class="o_payroll_portal_actions"><a href="/my/payroll" class="btn btn-outline-secondary">Volver al inicio</a></div></div>
                <form action="/my/payroll/profile/update" method="post" class="card card-body o_payroll_form_card"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="o_payroll_form_intro">La información actual se muestra como referencia. Los cambios serán revisados antes de aplicarse.</div><div class="row g-3 mt-1"><div class="col-md-6"><label>Correo laboral</label><input name="work_email" type="email" class="form-control" t-att-value="employee.work_email or ''"/></div><div class="col-md-6"><label>Teléfono</label><input name="work_phone" class="form-control" t-att-value="employee.work_phone or ''"/></div><div class="col-md-6"><label>Celular</label><input name="mobile_phone" class="form-control" t-att-value="employee.mobile_phone or ''"/></div><div class="col-md-6"><label>Dirección</label><input name="address" class="form-control" t-att-value="employee.private_street or ''"/></div></div><button class="btn btn-primary mt-4" type="submit">Enviar actualización</button></form>
            </div>
        </t>
    </template>

    <template id="portal_payroll_financial_request" name="Solicitud financiera del colaborador">
        <t t-call="portal.portal_layout">
            <div class="container o_payroll_portal"><div class="o_payroll_portal_header"><div><div class="o_payroll_portal_eyebrow">Solicitud financiera</div><h2><t t-esc="title"/></h2><p class="o_payroll_portal_subtitle"><t t-esc="subtitle"/></p></div><div class="o_payroll_portal_actions"><a href="/my/payroll" class="btn btn-outline-secondary">Volver al inicio</a></div></div>
                <form action="/my/payroll/request/create" method="post" class="card card-body o_payroll_form_card"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="request_type" t-att-value="request_type"/><div class="row g-3"><div class="col-md-6"><label>Valor solicitado</label><div class="input-group"><span class="input-group-text">$</span><input name="requested_amount" type="number" min="1" step="1000" required="required" class="form-control" placeholder="0"/></div></div><div class="col-md-6" t-if="request_type == 'loan'"><label>Número de cuotas</label><input name="installment_count" type="number" min="1" max="60" required="required" class="form-control" placeholder="Ej. 6"/></div><div class="col-12"><label>Motivo y detalle</label><textarea name="description" required="required" class="form-control" rows="5" placeholder="Explica el motivo de tu solicitud"/></div></div><div class="o_payroll_form_help mt-3">La solicitud será enviada a gestión humana para revisión. El envío no implica aprobación automática.</div><button class="btn btn-primary mt-4" type="submit"><t t-esc="button"/></button></form>
            </div>
        </t>
    </template>
</odoo>
