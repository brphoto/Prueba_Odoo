<odoo>
    <record id="view_co_payroll_portal_request_list" model="ir.ui.view"><field name="name">l10n.co.payroll.portal.request.list</field><field name="model">l10n.co.payroll.portal.request</field><field name="arch" type="xml"><list string="Solicitudes de empleados" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"><field name="name"/><field name="employee_id"/><field name="request_type"/><field name="date_from"/><field name="date_to"/><field name="applied_record" optional="hide"/><field name="state" widget="badge"/></list></field></record>
