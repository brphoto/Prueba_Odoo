    <menuitem id="menu_co_payroll_portal_request" name="Solicitudes empleados" parent="l10n_co_payroll.menu_co_payroll_configuration" action="action_co_payroll_portal_request" sequence="45" groups="l10n_co_payroll.group_co_payroll_manager"/>
