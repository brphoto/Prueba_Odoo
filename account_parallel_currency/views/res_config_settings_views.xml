<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.parallel.currency</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='main_currency_setting_container']" position="inside">
                <setting id="parallel_currency_usd" string="Otra Moneda"
                         help="Valora los apuntes en una segunda moneda y compensa el redondeo cambiario al publicar">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="other_currency_id" string="Moneda" class="col-lg-5 o_light_label"/>
                            <field name="other_currency_id" options="{'no_create': True, 'no_open': True}"
                                   context="{'active_test': False}"/>
                        </div>
                        <div class="row mt8" invisible="not other_currency_id">
                            <label for="other_currency_rounding_tolerance" string="Tolerancia" class="col-lg-5 o_light_label"/>
                            <field name="other_currency_rounding_tolerance"/>
                        </div>
                        <div class="row mt8" invisible="not other_currency_id">
                            <label for="other_currency_loss_account_id" string="Pérdida" class="col-lg-5 o_light_label"/>
                            <field name="other_currency_loss_account_id" options="{'no_create': True}"/>
                        </div>
                        <div class="row mt8" invisible="not other_currency_id">
                            <label for="other_currency_gain_account_id" string="Ganancia" class="col-lg-5 o_light_label"/>
                            <field name="other_currency_gain_account_id" options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
