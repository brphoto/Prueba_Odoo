<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_notification_list" model="ir.ui.view">
        <field name="name">chatroom.notification.list</field><field name="model">chatroom.notification</field>
        <field name="arch" type="xml"><list string="Notificaciones">
            <header>
                <button name="action_mark_read" type="object" string="Marcar leídas"/>
                <button name="action_snooze" type="object" string="Posponer 1 hora"/>
                <button name="action_resolve" type="object" string="Resolver" class="btn-primary"/>
            </header>
            <field name="create_date"/><field name="company_id" optional="hide"/><field name="name"/><field name="notification_type" widget="badge"/>
            <field name="priority" widget="badge"/><field name="state" widget="badge"/><field name="user_id"/>
            <field name="channel_id" optional="hide"/><field name="delivery_mode" optional="hide"/><field name="delivery_state" widget="badge" optional="show"/><field name="snoozed_until" optional="hide"/>
        </list></field>
    </record>
    <record id="view_chatroom_notification_form" model="ir.ui.view">
        <field name="name">chatroom.notification.form</field><field name="model">chatroom.notification</field>
        <field name="arch" type="xml"><form string="Notificación" create="false">
            <header>
                <button name="action_mark_read" type="object" string="Marcar como leída" class="btn-secondary" invisible="state != 'unread'"/>
                <button name="action_snooze" type="object" string="Posponer 1 hora" class="btn-secondary" invisible="state in ('done', 'snoozed')"/>
                <button name="action_resolve" type="object" string="Resolver" class="btn-primary" invisible="state == 'done'"/>
                <button name="action_open_record" type="object" string="Abrir registro" class="btn-secondary" invisible="not res_model or not res_id"/>
                <button name="action_dispatch" type="object" string="Enviar aviso" class="btn-primary"
                        invisible="delivery_mode == 'internal' or delivery_state == 'sent'"/>
                <field name="state" widget="statusbar" statusbar_visible="unread,read,done"/>
            </header><sheet>
                <div class="oe_title"><h1><field name="name"/></h1></div>
                <notebook>
                    <page string="Aviso" name="notification_data">
                        <group><group><field name="company_id"/><field name="notification_type"/><field name="priority"/><field name="user_id"/></group>
                            <group><field name="channel_id"/><field name="partner_id"/><field name="escalation_level"/></group></group>
                        <group string="Detalle"><field name="message" nolabel="1"/></group>
                    </page>
                    <page string="Entrega" name="delivery">
                        <div class="alert alert-info" role="alert">El cron solo registra la alerta. Usa «Enviar aviso» cuando un usuario autorizado confirme que corresponde notificar.</div>
                        <group><group><field name="delivery_mode"/><field name="delivery_state" widget="badge"/></group>
                            <group><field name="email_sent_at"/><field name="whatsapp_sent_at"/></group></group>
                        <field name="delivery_error" readonly="1" nolabel="1"/>
                    </page>
                    <page string="Auditoría" name="audit">
                        <group><field name="dedupe_key"/><field name="read_at"/><field name="snoozed_until"/><field name="resolved_at"/></group>
                    </page>
                </notebook>
            </sheet>
        </form></field>
    </record>
    <record id="action_chatroom_notification" model="ir.actions.act_window">
        <field name="name">Notificaciones</field><field name="res_model">chatroom.notification</field>
        <field name="view_mode">list,form</field><field name="context">{'search_default_unread': 1}</field>
    </record>
    <record id="view_chatroom_notification_search" model="ir.ui.view">
        <field name="name">chatroom.notification.search</field><field name="model">chatroom.notification</field>
        <field name="arch" type="xml"><search string="Notificaciones"><field name="name"/><field name="channel_id"/><field name="user_id"/>
            <filter name="unread" string="No leídas" domain="[('state', '=', 'unread')]"/>
            <filter name="urgent" string="Urgentes" domain="[('priority', '=', '2')]"/>
            <filter name="sla" string="SLA" domain="[('notification_type', '=', 'sla')]"/>
            <group><filter name="group_type" string="Tipo" context="{'group_by': 'notification_type'}"/><filter name="group_state" string="Estado" context="{'group_by': 'state'}"/></group>
        </search></field>
    </record>
    <menuitem id="menu_chatroom_notification" name="Notificaciones" parent="chatroom_whatsapp.menu_chatroom_operation" action="action_chatroom_notification" sequence="25" groups="chatroom_notifications.group_chatroom_notifications_user"/>
    <record id="view_chatroom_notification_ui" model="ir.ui.view">
        <field name="name">chatroom.notification.form.ui</field>
        <field name="model">chatroom.notification</field>
        <field name="inherit_id" ref="view_chatroom_notification_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes"><attribute name="class" add="o_chatroom_notification_form" separator=" "/></xpath>
            <xpath expr="//form/sheet" position="after"><chatter/></xpath>
        </field>
    </record>
</odoo>
