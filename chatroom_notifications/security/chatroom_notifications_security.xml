<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_chatroom_notifications" model="ir.module.category">
        <field name="name">Chatroom Notificaciones</field><field name="sequence">25</field>
    </record>
    <record id="privilege_chatroom_notifications" model="res.groups.privilege">
        <field name="name">Chatroom Notificaciones</field><field name="category_id" ref="module_category_chatroom_notifications"/>
    </record>
    <record id="group_chatroom_notifications_user" model="res.groups">
        <field name="name">Agente de notificaciones</field><field name="privilege_id" ref="privilege_chatroom_notifications"/>
    </record>
    <record id="group_chatroom_notifications_manager" model="res.groups">
        <field name="name">Administrador de notificaciones</field><field name="privilege_id" ref="privilege_chatroom_notifications"/>
        <field name="implied_ids" eval="[(4, ref('group_chatroom_notifications_user'))]"/>
    </record>
    <record id="chatroom_notification_rule_user" model="ir.rule">
        <field name="name">Notificaciones propias o generales</field>
        <field name="model_id" ref="model_chatroom_notification"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('chatroom_notifications.group_chatroom_notifications_user'))]"/>
    </record>
    <record id="chatroom_notification_rule_manager" model="ir.rule">
        <field name="name">Administrador ve todas las notificaciones</field>
        <field name="model_id" ref="model_chatroom_notification"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('chatroom_notifications.group_chatroom_notifications_manager'))]"/>
    </record>
</odoo>
