<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_employee_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2><t t-esc="o.name"/></h2><p><strong>Empleado:</strong> <t t-esc="o.employee_id.name"/></p><p><strong>Tipo:</strong> <t t-esc="o.document_type"/></p><p><strong>Fecha:</strong> <t t-esc="o.document_date"/></p><p>Se deja constancia de la emisión y control de este documento laboral.</p><p class="mt-5"><strong>Responsable:</strong> <t t-esc="o.company_id.name"/></p></div></t></t></t></template>
    <record id="action_report_employee_document" model="ir.actions.report"><field name="name">Documento laboral</field><field name="model">l10n.co.payroll.employee.document</field><field name="report_type">qweb-pdf</field><field name="report_name">l10n_co_payroll_documents.report_employee_document</field><field name="report_file">l10n_co_payroll_documents.report_employee_document</field><field name="print_report_name">'Documento - %s' % (object.name)</field><field name="binding_model_id" ref="model_l10n_co_payroll_employee_document"/><field name="binding_type">report</field></record>
</odoo>
