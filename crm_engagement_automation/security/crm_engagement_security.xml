<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_crm_engagement" model="ir.module.category">
        <field name="name">Automatizaciones Comerciales</field>
        <field name="sequence">38</field>
    </record>
    <record id="privilege_crm_engagement" model="res.groups.privilege">
        <field name="name">Automatizaciones Comerciales</field>
        <field name="category_id" ref="module_category_crm_engagement"/>
    </record>
    <record id="group_crm_engagement_user" model="res.groups">
        <field name="name">Usuario de automatizaciones</field>
        <field name="privilege_id" ref="privilege_crm_engagement"/>
    </record>
    <record id="group_crm_engagement_manager" model="res.groups">
        <field name="name">Administrador de automatizaciones</field>
        <field name="privilege_id" ref="privilege_crm_engagement"/>
        <field name="implied_ids" eval="[(4, ref('crm_engagement_automation.group_crm_engagement_user'))]"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <!-- Sin esto el administrador no ve el modulo recien instalado. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Aislamiento por empresa.

         Son reglas GLOBALES (sin `groups`) a proposito: Odoo une con OR
         las reglas de los grupos del usuario y aplica las globales con
         AND sobre el resultado. Puesta en un grupo, una regla por empresa
         se uniria con OR a las que ya existen -alguna con dominio
         `[('id', '!=', False)]`- y no aislaria nada.

         `company_id = False` significa "de todas las empresas" y por eso
         se deja pasar. -->
    <record id="crm_engagement_event_rule_company" model="ir.rule">
        <field name="name">Eventos de automatizacion: solo las de la empresa activa</field>
        <field name="model_id" ref="model_crm_engagement_event"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
