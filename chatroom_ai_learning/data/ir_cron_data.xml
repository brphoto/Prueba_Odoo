<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_shadow" model="ir.cron">
        <field name="name">Chatroom IA: evaluar en modo sombra</field>
        <field name="model_id" ref="model_chatroom_ai_evaluation"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_shadow(limit=10)</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_autonomy_levels" model="ir.cron">
        <field name="name">Chatroom IA: actualizar niveles de autonomía</field>
        <field name="model_id" ref="model_chatroom_ai_autonomy_level"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_levels()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_resume_ai" model="ir.cron">
        <field name="name">Chatroom IA: reactivar conversaciones atendidas</field>
        <field name="model_id" ref="chatroom_whatsapp.model_chatroom_channel"/>
        <field name="state">code</field>
        <field name="code">model._cron_resume_ai()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_extract_memories" model="ir.cron">
        <field name="name">Chatroom IA: memoria automática de clientes</field>
        <field name="model_id" ref="chatroom_whatsapp.model_chatroom_channel"/>
        <field name="state">code</field>
        <field name="code">model._cron_extract_memories(limit=20)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_eval_run" model="ir.cron">
        <field name="name">Chatroom IA: pruebas de regresión semanales</field>
        <field name="model_id" ref="model_chatroom_ai_eval_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_run()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
