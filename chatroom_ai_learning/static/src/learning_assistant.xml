<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="chatroom_whatsapp.ContactPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_chatroom_ai_assistant_compact_bar')]" position="before">
            <div class="o_chatroom_ai_autonomy d-flex flex-wrap align-items-center gap-1 mb-2"
                 t-if="aiAssistant.autonomyLevel">
                <span t-attf-class="badge rounded-pill {{ aiAutonomyClass() }}"
                      t-att-title="aiAssistant.autonomyLevel.note">
                    <i class="fa fa-graduation-cap me-1"/>
                    <t t-esc="aiAssistant.autonomyLevel.category"/>: <t t-esc="aiAutonomyLabel()"/>
                </span>
            </div>
            <div role="status" class="o_chatroom_ai_handoff alert alert-warning py-1 px-2 mb-2"
                 t-if="aiAssistant.handoffReason">
                <i class="fa fa-user me-1"/> Traspasado a una persona: <t t-esc="aiAssistant.handoffReason"/>
            </div>
        </xpath>
    </t>
</templates>
