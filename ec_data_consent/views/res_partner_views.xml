<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_data_consent" model="ir.ui.view">
        <field name="name">res.partner.form.data.consent</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_data_consents" type="object"
                        class="oe_stat_button" icon="fa-shield"
                        invisible="data_consent_count == 0">
                    <field name="data_consent_count" widget="statinfo" string="Consentimientos"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
