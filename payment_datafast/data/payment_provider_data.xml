<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_method_datafast" model="payment.method">
        <field name="name">Datafast</field>
        <field name="code">datafast</field>
        <field name="sequence">15</field>
        <field name="image" type="base64" file="payment_datafast/static/img/datafast.svg"/>
        <field name="support_tokenization">True</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">partial</field>
    </record>

    <record id="payment_provider_datafast" model="payment.provider">
        <field name="name">Datafast</field>
        <field name="code">datafast</field>
        <field name="state">disabled</field>
        <field name="module_id" ref="base.module_payment_datafast"/>
        <field name="image_128" type="base64" file="payment_datafast/static/img/datafast.svg"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment_datafast.payment_method_datafast')])]"/>
    </record>

</odoo>
