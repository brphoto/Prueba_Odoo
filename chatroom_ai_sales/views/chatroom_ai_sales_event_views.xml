<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_ai_sales_event_list" model="ir.ui.view">
        <field name="name">chatroom.ai.sales.event.list</field>
        <field name="model">chatroom.ai.sales.event</field>
        <field name="arch" type="xml">
            <list string="Actividad de ventas autónomas">
                <field name="create_date"/>
                <field name="event"/>
                <field name="partner_id"/>
                <field name="channel_id"/>
                <field name="order_id"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="details" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_chatroom_ai_sales_event_form" model="ir.ui.view">
        <field name="name">chatroom.ai.sales.event.form</field>
        <field name="model">chatroom.ai.sales.event</field>
        <field name="arch" type="xml">
            <form string="Evento de venta autónoma" create="0" edit="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="event"/>
                        <field name="create_date"/>
                        <field name="channel_id"/>
                        <field name="partner_id"/>
                        <field name="order_id"/>
                        <field name="amount" widget="monetary"/>
                        <field name="currency_id"/>
                    </group>
                    <field name="details" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_chatroom_ai_sales_event" model="ir.actions.act_window">
        <field name="name">Actividad de ventas autónomas</field>
        <field name="res_model">chatroom.ai.sales.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p>Auditoría de carritos, pedidos, confirmaciones, pagos y bloqueos.</p></field>
    </record>
</odoo>
