<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Aislamiento por empresa.

         Son reglas GLOBALES (sin `groups`) a proposito: Odoo une con OR
         las reglas de los grupos del usuario y aplica las globales con
         AND sobre el resultado. Puesta en un grupo, una regla por empresa
         se uniria con OR a las que ya existen -alguna con dominio
         `[('id', '!=', False)]`- y no aislaria nada.

         `company_id = False` significa "de todas las empresas" y por eso
         se deja pasar. -->
    <record id="chatroom_ai_usage_event_rule_company" model="ir.rule">
        <field name="name">Consumo de IA: solo las de la empresa activa</field>
        <field name="model_id" ref="model_chatroom_ai_usage_event"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="chatroom_ai_usage_snapshot_rule_company" model="ir.rule">
        <field name="name">Resumenes de consumo de IA: solo las de la empresa activa</field>
        <field name="model_id" ref="model_chatroom_ai_usage_snapshot"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="chatroom_ai_funding_rule_company" model="ir.rule">
        <field name="name">Fondos de IA: solo las de la empresa activa</field>
        <field name="model_id" ref="model_chatroom_ai_funding"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
