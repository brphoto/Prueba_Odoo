<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chatroom_ai_quick_action_form_usage" model="ir.ui.view">
        <field name="name">chatroom.ai.quick.action.form.usage</field>
        <field name="model">chatroom.ai.quick.action</field>
        <field name="inherit_id" ref="chatroom_ai.view_chatroom_ai_quick_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='language']" position="after">
                <field name="model_id" placeholder="Modelo de Ajustes" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_chatroom_ai_quick_action_list_usage" model="ir.ui.view">
        <field name="name">chatroom.ai.quick.action.list.usage</field>
        <field name="model">chatroom.ai.quick.action</field>
        <field name="inherit_id" ref="chatroom_ai.view_chatroom_ai_quick_action_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='output_mode']" position="after">
                <field name="model_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
