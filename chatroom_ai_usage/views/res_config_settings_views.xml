<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.chatroom.ai.usage</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="chatroom_whatsapp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='chatroom_ai_model']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//block[.//field[@name='chatroom_ai_auto_classify']]" position="after">
                <block title="Modelos y consumo de IA">
                    <setting id="chatroom_ai_model_selector_setting"
                             help="Selecciona un modelo sincronizado y evita escribir identificadores manualmente.">
                        <field name="chatroom_ai_model_id" options="{'no_create': True}"/>
                        <button name="action_sync_ai_models" type="object" string="Actualizar modelos" class="btn-secondary ms-2"/>
                        <button name="action_test_ai_connection" type="object" string="Probar conexion" class="btn-secondary ms-2"/>
                    </setting>
                    <setting id="chatroom_ai_model_profiles_setting"
                             help="Permite usar un modelo economico para tareas rapidas y uno mas potente para el agente.">
                        <div class="row mt-2">
                            <label for="chatroom_ai_model_reply_id" class="col-lg-4 o_light_label"/>
                            <field name="chatroom_ai_model_reply_id" options="{'no_create': True}"/>
                        </div>
                        <div class="row mt-2">
                            <label for="chatroom_ai_model_summary_id" class="col-lg-4 o_light_label"/>
                            <field name="chatroom_ai_model_summary_id" options="{'no_create': True}"/>
                        </div>
                        <div class="row mt-2">
                            <label for="chatroom_ai_model_classification_id" class="col-lg-4 o_light_label"/>
                            <field name="chatroom_ai_model_classification_id" options="{'no_create': True}"/>
                        </div>
                        <div class="row mt-2">
                            <label for="chatroom_ai_model_next_action_id" class="col-lg-4 o_light_label"/>
                            <field name="chatroom_ai_model_next_action_id" options="{'no_create': True}"/>
                        </div>
                        <div class="row mt-2">
                            <label for="chatroom_ai_model_agent_id" class="col-lg-4 o_light_label"/>
                            <field name="chatroom_ai_model_agent_id" options="{'no_create': True}"/>
                        </div>
                        <div class="row mt-2">
                            <label for="chatroom_ai_fallback_model_id" class="col-lg-4 o_light_label"/>
                            <field name="chatroom_ai_fallback_model_id" options="{'no_create': True}"/>
                        </div>
                    </setting>
                    <setting id="chatroom_ai_admin_api_key_setting"
                             help="Clave administrativa separada para consultar uso y costos de la organizacion. Nunca se usa para responder mensajes.">
                        <field name="chatroom_ai_admin_api_key" password="True"/>
                    </setting>
                    <setting id="chatroom_ai_usage_days_setting">
                        <field name="chatroom_ai_usage_days"/>
                    </setting>
                    <setting id="chatroom_ai_context_efficiency_setting"
                             string="Contexto eficiente"
                             help="Controla cuánta información se envía en cada consulta. El contenido indexado permanece local y no se reenvía completo.">
                        <div class="row mt-2">
                            <label for="chatroom_ai_history_messages" class="col-lg-5 o_light_label"/>
                            <field name="chatroom_ai_history_messages"/>
                        </div>
                        <div class="row mt-2">
                            <label for="chatroom_ai_knowledge_context_max_chars" class="col-lg-5 o_light_label"/>
                            <field name="chatroom_ai_knowledge_context_max_chars"/>
                        </div>
                        <div class="row mt-2">
                            <label for="chatroom_ai_knowledge_context_max_chunks" class="col-lg-5 o_light_label"/>
                            <field name="chatroom_ai_knowledge_context_max_chunks"/>
                        </div>
                        <div class="row mt-2">
                            <label for="chatroom_ai_knowledge_product_limit" class="col-lg-5 o_light_label"/>
                            <field name="chatroom_ai_knowledge_product_limit"/>
                        </div>
                    </setting>
                    <setting id="chatroom_ai_monthly_budget_setting"
                             help="Referencia local para comparar el gasto; no cambia los limites de OpenAI.">
                        <field name="chatroom_ai_monthly_budget"/>
                    </setting>
                    <setting id="chatroom_ai_daily_limits_setting"
                             string="Protección diaria de consumo"
                             help="Detiene llamadas externas al alcanzar los límites configurados. Las respuestas locales siguen funcionando.">
                        <div class="row mt-2">
                            <label for="chatroom_ai_daily_token_limit" class="col-lg-5 o_light_label"/>
                            <field name="chatroom_ai_daily_token_limit"/>
                        </div>
                        <div class="row mt-2">
                            <label for="chatroom_ai_daily_request_limit" class="col-lg-5 o_light_label"/>
                            <field name="chatroom_ai_daily_request_limit"/>
                        </div>
                    </setting>
                    <setting id="chatroom_ai_refresh_usage_setting"
                             help="Consulta el costo oficial si hay Admin API Key; si no, muestra el consumo registrado localmente.">
                        <button name="action_refresh_ai_usage" type="object" string="Actualizar consumo" class="btn-primary"/>
                    </setting>
                    <setting id="chatroom_ai_open_sandbox_setting"
                             help="Prueba respuestas y resumenes con el contexto de una conversacion sin enviarlos.">
                        <button name="action_open_ai_sandbox" type="object" string="Abrir simulador IA" class="btn-secondary"/>
                    </setting>
                    <setting id="chatroom_ai_usage_auto_refresh_setting"
                             help="El resumen diario genera una actividad para los administradores cuando el presupuesto entra en alerta.">
                        <field name="chatroom_ai_usage_auto_refresh"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
