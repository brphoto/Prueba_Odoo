<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_ai_setup_wizard_form" model="ir.ui.view">
        <field name="name">chatroom.ai.setup.wizard.form</field>
        <field name="model">chatroom.ai.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Asistente inicial de IA" class="o_chatroom_ai_setup_wizard_form">
                <header>
                    <button name="action_sync_models" type="object" string="Guardar y sincronizar modelos" icon="fa-refresh" class="btn-secondary"/>
                    <button name="action_test_official_costs" type="object" string="Probar costos oficiales" icon="fa-money" class="btn-secondary"/>
                    <button name="action_finish" type="object" string="Finalizar configuración" icon="fa-check" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1>Configurar IA y conocimiento</h1></div>
                    <div class="alert alert-info" role="status">
                        Asistente opcional de primera configuración. Sincronizar modelos e indexar documentos no genera respuestas ni consume tokens.
                    </div>
                    <notebook>
                        <page string="1. Conexión y modelos">
                            <group col="2">
                                <group string="Conexión de respuestas">
                                    <field name="provider_url" placeholder="https://api.openai.com/v1"/>
                                    <field name="api_key" password="True" placeholder="Pega la API Key o déjala vacía si ya está guardada"/>
                                    <field name="enable_ai"/>
                                </group>
                                <group string="Control financiero (opcional)">
                                <field name="admin_api_key" password="True" placeholder="Admin API Key con acceso a uso y costos"/>
                                <div class="text-muted">La Admin API Key es distinta de la clave usada para responder chats. Solo consulta uso y costos.</div>
                                <field name="initial_funding"/>
                                <div class="text-muted">No es el saldo oficial de OpenAI: sirve como control interno de tus recargas.</div>
                                </group>
                            </group>
                            <separator string="Selección de modelos"/>
                            <group col="2">
                                <field name="selected_model_id" options="{'no_create': True}"/>
                                <field name="fallback_model_id" options="{'no_create': True}"/>
                            </group>
                            <field name="result_message" nolabel="1" readonly="1" invisible="not result_message"/>
                        </page>
                        <page string="2. Cargar conocimiento">
                            <div class="alert alert-success" role="status">
                                Los PDFs se guardan e indexan en Odoo. Quedan como borrador para que los revises y publiques; el catálogo de productos se consulta en vivo.
                            </div>
                            <group>
                                <field name="attachment_ids" widget="many2many_binary" string="Archivos PDF"/>
                                <field name="create_company_knowledge"/>
                                <field name="company_knowledge_text" widget="text" nolabel="1" placeholder="Describe la empresa, productos, horarios, políticas y reglas comerciales..."/>
                            </group>
                        </page>
                        <page string="3. Qué ocurrirá">
                            <div class="o_chatroom_ai_setup_steps">
                                <div><b>1</b><strong>Conectar</strong><span>Se guardan las credenciales en parámetros de Odoo.</span></div>
                                <div><b>2</b><strong>Sincronizar</strong><span>Se cargan los modelos disponibles sin consumir tokens.</span></div>
                                <div><b>3</b><strong>Indexar</strong><span>Los PDFs y la guía se convierten en conocimiento local revisable.</span></div>
                                <div><b>4</b><strong>Publicar</strong><span>Solo tú decides qué conocimiento puede usar la IA.</span></div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_chatroom_ai_setup_wizard" model="ir.actions.act_window">
        <field name="name">Asistente inicial de IA</field>
        <field name="res_model">chatroom.ai.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_chatroom_ai_setup_wizard" name="Asistente inicial" parent="chatroom_ai_usage.menu_chatroom_ai_usage" action="action_chatroom_ai_setup_wizard" sequence="1" groups="chatroom_ai.group_chatroom_ai_user"/>
</odoo>
