<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_ai_provider_model_list" model="ir.ui.view">
        <field name="name">chatroom.ai.provider.model.list</field>
        <field name="model">chatroom.ai.provider.model</field>
        <field name="arch" type="xml">
            <list string="Modelos disponibles" decoration-success="recommended" decoration-muted="not active">
                <field name="recommended" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="provider" widget="badge"/>
                <field name="owned_by" optional="hide"/>
                <field name="supports_chat"/>
                <field name="usage_roles" string="Asignado para" optional="show"/>
                <field name="last_synced"/>
                <field name="active"/><field name="health_state" widget="badge"/><field name="last_tested" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_chatroom_ai_provider_model_form" model="ir.ui.view">
        <field name="name">chatroom.ai.provider.model.form</field>
        <field name="model">chatroom.ai.provider.model</field>
        <field name="arch" type="xml">
                <form string="Modelo de IA" class="o_chatroom_ai_provider_model_form">
                    <header><button name="action_test_connection" type="object" string="Probar disponibilidad" class="btn-primary" icon="fa-heartbeat"/></header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="model_id"/>
                            <field name="provider"/>
                            <field name="owned_by"/>
                        </group>
                        <group>
                            <field name="supports_chat"/>
                            <field name="recommended"/>
                            <field name="active"/>
                            <field name="last_synced" readonly="1"/>
                            <field name="health_state" widget="badge" readonly="1"/>
                            <field name="last_tested" readonly="1"/>
                            <field name="usage_roles" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Los modelos se sincronizan desde el proveedor configurado. Chatroom solo muestra como compatibles los modelos de texto detectados.
                    </div>
                    <field name="health_message" readonly="1" placeholder="Aún no se ha probado este modelo."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_chatroom_ai_usage_snapshot_list" model="ir.ui.view">
        <field name="name">chatroom.ai.usage.snapshot.list</field>
        <field name="model">chatroom.ai.usage.snapshot</field>
        <field name="arch" type="xml">
            <list string="Consumo de IA" decoration-danger="state == 'error'" decoration-warning="state == 'partial'">
                <field name="company_id" optional="hide"/>
                <field name="fetched_at"/>
                <field name="period_start" optional="hide"/>
                <field name="period_end" optional="hide"/>
                 <field name="state" widget="badge"/>
                 <field name="source" widget="badge"/>
                 <field name="official_sync_at" optional="hide"/>
                <field name="request_count"/>
                <field name="input_tokens" optional="hide"/>
                <field name="output_tokens" optional="hide"/>
                <field name="total_tokens"/>
                <field name="cost"/>
                <field name="cost_breakdown" optional="hide"/>
                <field name="currency"/>
                <field name="funding_net" optional="hide"/>
                <field name="estimated_balance" optional="hide"/>
                <field name="financial_state" widget="badge" optional="hide"/>
                <field name="budget_remaining" optional="hide"/>
                <field name="budget_state" widget="badge" optional="hide"/>
                <field name="local_request_count" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_chatroom_ai_usage_snapshot_form" model="ir.ui.view">
        <field name="name">chatroom.ai.usage.snapshot.form</field>
        <field name="model">chatroom.ai.usage.snapshot</field>
        <field name="arch" type="xml">
            <form string="Resumen de consumo de IA">
                <header>
                    <button name="action_refresh" type="object" string="Actualizar desde OpenAI" class="btn-primary" icon="fa-cloud-download"/>
                    <button name="action_test_platform_connection" type="object" string="Probar conexión" class="btn-secondary" icon="fa-plug"/>
                    <button name="action_refresh_local_ui" type="object" string="Actualizar resumen local" class="btn-primary" icon="fa-refresh"/>
                    <button name="action_open_platform_usage" type="object" string="Abrir panel oficial" class="btn-secondary"/>
                    <button name="action_open_platform_billing" type="object" string="Ver facturación" class="btn-secondary" icon="fa-credit-card"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'partial'">
                        Este resumen contiene unicamente registros locales de Odoo. Configura una Admin API Key y pulsa "Actualizar uso y costos" para consultar OpenAI Platform.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'"><field name="error_message"/></div>
                    <group>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="fetched_at" readonly="1"/>
                            <field name="period_start" readonly="1"/>
                            <field name="period_end" readonly="1"/>
                            <field name="state" widget="badge" readonly="1"/>
                            <field name="source" widget="badge" readonly="1"/>
                            <field name="official_sync_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="request_count" readonly="1"/>
                            <field name="total_tokens" readonly="1"/>
                            <field name="cost" readonly="1"/>
                            <field name="currency" readonly="1"/>
                        </group>
                    </group>
                    <group string="Presupuesto de referencia">
                        <field name="budget_limit" readonly="1"/>
                        <field name="budget_remaining" readonly="1"/>
                        <field name="budget_percent" readonly="1"/>
                        <field name="budget_state" widget="badge" readonly="1"/>
                    </group>
                    <group string="Fondos y conciliación">
                        <field name="funding_total" readonly="1"/>
                        <field name="funding_debits" readonly="1"/>
                        <field name="funding_net" readonly="1"/>
                        <field name="funding_entry_count" readonly="1"/>
                        <field name="funding_currency" readonly="1"/>
                        <field name="estimated_balance" readonly="1"/>
                        <field name="financial_state" widget="badge" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Importante:</strong> el costo oficial proviene de OpenAI y se reconcilia con la factura. El saldo de control es una estimación interna basada en los fondos registrados; confirma el saldo prepago real en “Ver facturación”.
                    </div>
                    <field name="billing_reconciliation_note" readonly="1" nolabel="1"/>
                    <group string="Control local">
                        <field name="local_request_count" readonly="1"/>
                        <field name="local_total_tokens" readonly="1"/>
                    </group>
                    <group string="Solicitudes por modelo"><field name="model_breakdown" nolabel="1" readonly="1" widget="text"/></group>
                    <group string="Costos oficiales por concepto"><field name="cost_breakdown" nolabel="1" readonly="1" widget="text"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_chatroom_ai_funding_list" model="ir.ui.view">
        <field name="name">chatroom.ai.funding.list</field>
        <field name="model">chatroom.ai.funding</field>
        <field name="arch" type="xml">
            <list string="Fondos y conciliación" decoration-success="movement_type == 'credit'" decoration-warning="movement_type == 'debit'">
                <field name="movement_date"/>
                <field name="name"/>
                <field name="movement_type" widget="badge"/>
                <field name="amount"/>
                <field name="currency"/>
                <field name="signed_amount"/>
                <field name="reference" optional="hide"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_chatroom_ai_funding_form" model="ir.ui.view">
        <field name="name">chatroom.ai.funding.form</field>
        <field name="model">chatroom.ai.funding</field>
        <field name="arch" type="xml">
            <form string="Fondo o ajuste de IA" class="o_chatroom_ai_funding_form">
                <header>
                    <button name="action_open_platform_billing" type="object" string="Abrir facturacion oficial" class="btn-secondary" icon="fa-credit-card"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Registra aquí las recargas, devoluciones o ajustes que ves en la facturación de OpenAI. Esto alimenta el saldo de control de Chatroom; no realiza pagos ni modifica tu cuenta de OpenAI.
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="movement_date"/><field name="movement_type"/><field name="amount"/><field name="currency"/></group>
                        <group><field name="company_id"/><field name="reference"/><field name="signed_amount" readonly="1"/></group>
                    </group>
                    <field name="note" placeholder="Ejemplo: Recarga prepaga de USD 10 confirmada en Billing history."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_chatroom_ai_usage_snapshot_graph" model="ir.ui.view">
        <field name="name">chatroom.ai.usage.snapshot.graph</field>
        <field name="model">chatroom.ai.usage.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Consumo de IA por día" type="bar">
                <field name="fetched_at" interval="day" type="row"/>
                <field name="total_tokens" type="measure"/>
                <field name="request_count" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_chatroom_ai_usage_snapshot_pivot" model="ir.ui.view">
        <field name="name">chatroom.ai.usage.snapshot.pivot</field>
        <field name="model">chatroom.ai.usage.snapshot</field>
        <field name="arch" type="xml">
            <pivot string="Resumen de consumo">
                <field name="fetched_at" type="row" interval="day"/>
                <field name="state" type="col"/>
                <field name="request_count" type="measure"/>
                <field name="total_tokens" type="measure"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_chatroom_ai_usage_event_list" model="ir.ui.view">
        <field name="name">chatroom.ai.usage.event.list</field>
        <field name="model">chatroom.ai.usage.event</field>
        <field name="arch" type="xml"><list string="Solicitudes IA">
            <field name="company_id" optional="hide"/>
            <field name="request_date"/><field name="model"/><field name="task_type"/>
            <field name="channel_id" optional="hide"/><field name="input_tokens" optional="hide"/>
            <field name="output_tokens" optional="hide"/><field name="total_tokens"/><field name="success"/>
        </list></field>
    </record>
    <record id="view_chatroom_ai_usage_event_graph" model="ir.ui.view">
        <field name="name">chatroom.ai.usage.event.graph</field>
        <field name="model">chatroom.ai.usage.event</field>
        <field name="arch" type="xml"><graph string="Actividad de IA" type="bar">
            <field name="request_date" interval="day" type="row"/>
            <field name="total_tokens" type="measure"/>
        </graph></field>
    </record>
    <record id="view_chatroom_ai_quality_test_list" model="ir.ui.view">
        <field name="name">chatroom.ai.quality.test.list</field>
        <field name="model">chatroom.ai.quality.test</field>
        <field name="arch" type="xml">
            <list string="Pruebas de calidad" decoration-success="last_state == 'passed'" decoration-warning="last_state == 'warning'" decoration-danger="last_state == 'error'">
                <header><button name="action_run_selected" type="object" string="Ejecutar seleccionadas" class="btn-primary"/></header>
                <button name="action_run" type="object" icon="fa-play" title="Ejecutar"/>
                <field name="name" string="Prueba"/>
                <field name="task_type" string="Tipo"/>
                <field name="channel_id" string="Conversación" optional="hide"/>
                <field name="last_run" string="Última ejecución" optional="hide"/>
                <field name="last_score" string="Puntaje"/>
                <field name="last_state" string="Resultado" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_chatroom_ai_quality_test_search" model="ir.ui.view">
        <field name="name">chatroom.ai.quality.test.search</field>
        <field name="model">chatroom.ai.quality.test</field>
        <field name="arch" type="xml">
            <search string="Pruebas de calidad">
                <field name="name" string="Prueba"/>
                <field name="task_type" string="Tipo"/>
                <field name="channel_id" string="Conversación"/>
                <filter name="pending" string="Pendientes" domain="[('last_state', '=', 'pending')]"/>
                <filter name="passed" string="Aprobadas" domain="[('last_state', '=', 'passed')]"/>
                <filter name="review" string="Para revisar" domain="[('last_state', '=', 'warning')]"/>
                <filter name="errors" string="Con error" domain="[('last_state', '=', 'error')]"/>
                <filter name="active" string="Activas" domain="[('active', '=', True)]"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'task_type'}"/>
                    <filter name="group_result" string="Resultado" context="{'group_by': 'last_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_chatroom_ai_quality_test_form" model="ir.ui.view">
        <field name="name">chatroom.ai.quality.test.form</field>
        <field name="model">chatroom.ai.quality.test</field>
        <field name="arch" type="xml">
            <form string="Prueba de calidad IA" class="o_chatroom_ai_quality_test_form">
                <header>
                    <button name="action_run" type="object" string="Ejecutar prueba" class="oe_highlight" icon="fa-play"/>
                    <field name="last_state" widget="statusbar" statusbar_visible="pending,passed,warning,error"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="o_chatroom_ai_quality_intro">
                        Ejecuta una respuesta controlada, mide si contiene las palabras esperadas y conserva cada resultado para comparar la calidad en el tiempo.
                    </div>
                    <group col="2">
                        <group string="Escenario">
                            <field name="channel_id" string="Conversación de prueba"/>
                            <field name="task_type" string="Tipo de prueba"/>
                            <field name="active" string="Activa"/>
                        </group>
                        <group string="Criterio de evaluación">
                            <field name="expected_keywords" string="Palabras esperadas"/>
                            <field name="last_run" string="Última ejecución" readonly="1"/>
                            <field name="last_score" string="Último puntaje" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuración">
                            <separator string="Instrucción adicional"/>
                            <div class="o_chatroom_ai_quality_text">
                                <field name="prompt" nolabel="1" widget="text" placeholder="Criterios que debe seguir la respuesta..."/>
                            </div>
                            <div class="text-muted">Las palabras esperadas se separan por coma. Si no defines palabras, la prueba se considera válida cuando la ejecución termina correctamente.</div>
                        </page>
                        <page string="Último resultado">
                            <separator string="Respuesta generada"/>
                            <div class="o_chatroom_ai_quality_output">
                                <field name="last_output" readonly="1" nolabel="1" widget="text" placeholder="Todavía no se ha ejecutado esta prueba."/>
                            </div>
                        </page>
                        <page string="Historial">
                            <field name="result_ids" readonly="1">
                                <list string="Ejecuciones anteriores">
                                    <field name="run_date" string="Fecha"/>
                                    <field name="score" string="Puntaje"/>
                                    <field name="state" string="Resultado" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_chatroom_ai_quality_result_list" model="ir.ui.view">
        <field name="name">chatroom.ai.quality.result.list</field><field name="model">chatroom.ai.quality.result</field>
        <field name="arch" type="xml"><list string="Historial de calidad"><field name="run_date" string="Fecha"/><field name="test_id" string="Prueba"/><field name="score" string="Puntaje"/><field name="state" string="Resultado" widget="badge"/></list></field>
    </record>
    <record id="view_chatroom_ai_sandbox_list" model="ir.ui.view">
        <field name="name">chatroom.ai.sandbox.list</field><field name="model">chatroom.ai.sandbox</field>
        <field name="arch" type="xml">
            <list string="Laboratorio de conversación IA" decoration-success="state == 'done'" decoration-danger="state == 'error'">
                <button name="action_run" type="object" icon="fa-play" title="Ejecutar sin enviar"/>
                <field name="name" string="Prueba"/>
                <field name="channel_id" string="Conversación"/>
                <field name="scenario" string="Escenario"/>
                <field name="execution_mode" string="Modo" widget="badge"/>
                <field name="task_type" string="Tipo"/>
                <field name="state" string="Estado" widget="badge"/>
                <field name="evaluation_state" string="Evaluación" widget="badge"/>
                <field name="test_quote_id" string="Cotización de prueba" optional="hide"/>
                <field name="test_activity_ids" string="Actividades" optional="hide"/>
                <field name="model_used" string="Modelo" optional="hide"/>
                <field name="write_date" string="Actualizado"/>
            </list>
        </field>
    </record>
    <record id="view_chatroom_ai_sandbox_search" model="ir.ui.view">
        <field name="name">chatroom.ai.sandbox.search</field>
        <field name="model">chatroom.ai.sandbox</field>
        <field name="arch" type="xml">
            <search string="Laboratorio de conversación IA">
                <field name="name" string="Prueba"/>
                <field name="channel_id" string="Conversación"/>
                <field name="scenario" string="Escenario"/>
                <field name="task_type" string="Tipo"/>
                <filter name="completed" string="Completadas" domain="[('state', '=', 'done')]"/>
                <filter name="errors" string="Con error" domain="[('state', '=', 'error')]"/>
                <filter name="approved" string="Aprobadas" domain="[('evaluation_state', '=', 'passed')]"/>
                <filter name="review" string="Para revisar" domain="[('evaluation_state', '=', 'warning')]"/>
                <group>
                    <filter name="group_scenario" string="Escenario" context="{'group_by': 'scenario'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_evaluation" string="Evaluación" context="{'group_by': 'evaluation_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_chatroom_ai_sandbox_form" model="ir.ui.view">
        <field name="name">chatroom.ai.sandbox.form</field><field name="model">chatroom.ai.sandbox</field>
        <field name="arch" type="xml">
            <form string="Laboratorio de conversación IA" class="o_chatroom_ai_sandbox_form">
                <header>
                    <button name="action_load_scenario" type="object" string="Cargar escenario" class="btn-secondary" icon="fa-lightbulb-o"/>
                    <button name="action_run" type="object" string="Probar IA (no enviar)" class="oe_highlight" icon="fa-play"/>
                    <button name="action_send_test_message" type="object" string="Enviar mensaje de prueba" class="oe_highlight" icon="fa-comment"/>
                    <button name="action_generate_test_quote_pdf" type="object" string="Generar cotización + PDF" class="btn-secondary" icon="fa-file-pdf-o"/>
                    <button name="action_create_test_activity" type="object" string="Crear actividad Odoo" class="btn-secondary" icon="fa-check-square-o"/>
                    <button name="action_create_test_meeting" type="object" string="Crear reunión Odoo" class="btn-secondary" icon="fa-calendar"/>
                    <button name="action_prepare_operational_task" type="object" string="Preparar acción comercial" class="btn-secondary" icon="fa-cogs" invisible="message_count == 0"/>
                    <button name="action_simulate_delivery" type="object" string="Simular entrega" class="btn-secondary" icon="fa-paper-plane" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,error"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="o_chatroom_ai_sandbox_intro" role="status">
                        Escribe varios mensajes como cliente y recibe respuestas dentro de este chat. Nada se envía por WhatsApp.
                    </div>
                    <group col="2">
                        <group string="Escenario">
                            <field name="channel_id" string="Conversación"/>
                            <field name="scenario" string="Escenario"/>
                            <field name="task_type" string="Tipo de tarea"/>
                            <field name="execution_mode" string="Modo de prueba"/>
                            <field name="ai_engine" string="Motor IA"/>
                            <field name="native_engine_status" string="Estado IA nativa" readonly="1"
                                   invisible="ai_engine == 'chatroom'"/>
                            <field name="provider_model_id" string="Modelo" invisible="execution_mode != 'provider'"/>
                            <field name="expected_keywords" string="Debe incluir"/>
                        </group>
                        <group string="Medición">
                            <field name="message_count" string="Mensajes" readonly="1"/>
                            <field name="model_used" string="Modelo utilizado" readonly="1"/>
                            <field name="engine_used" string="Motor ejecutado" readonly="1"/>
                            <field name="input_tokens" string="Tokens de entrada" readonly="1"/>
                            <field name="output_tokens" string="Tokens de salida" readonly="1"/>
                            <field name="evaluation_state" string="Evaluación" widget="badge" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chat de prueba">
                            <div class="o_chatroom_ai_sandbox_chat_help">
                                <strong>Prueba como cliente:</strong> escribe «Hola», «¿Cuál es la tarifa?» o «¿Qué productos tienen?».
                                Usa <strong>Modo local</strong> para practicar sin tokens o <strong>Proveedor IA</strong> para consultar el modelo configurado.
                                Si escribes «necesito una cotización en PDF» se crea un presupuesto nativo independiente.
                                Para sumar líneas al último borrador escribe «agrega también ... a la cotización»; para otra propuesta escribe «hazme otra cotización».
                                Las dos opciones generan el PDF estándar de Ventas y lo dejan en el historial, sin enviar a WhatsApp.
                            </div>
                            <div class="o_chatroom_ai_sandbox_chat_input">
                                <field name="draft_message" nolabel="1" widget="text" placeholder="Escribe aquí el mensaje del cliente..."/>
                                <button name="action_send_test_message" type="object" string="Enviar mensaje de prueba" class="oe_highlight" icon="fa-paper-plane"/>
                            </div>
                            <field name="conversation_line_ids" nolabel="1" readonly="1">
                                <list string="Mensajes de la conversación" decoration-info="speaker == 'customer'" decoration-success="speaker == 'assistant'">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="speaker" string="Interlocutor" widget="badge"/>
                                    <field name="body" string="Mensaje"/>
                                    <field name="attachment_ids" string="Adjuntos" widget="many2many_tags" optional="show"/>
                                    <field name="message_date" string="Fecha"/>
                                </list>
                            </field>
                        </page>
                        <page string="Instrucción">
                            <separator string="Instrucción para la prueba"/>
                            <div class="o_chatroom_ai_sandbox_text">
                                <field name="prompt" nolabel="1" widget="text" placeholder="Ejemplo: responde con tono profesional y ofrece el siguiente paso..."/>
                            </div>
                        </page>
                        <page string="Resultado">
                            <separator string="Respuesta generada"/>
                            <div class="o_chatroom_ai_sandbox_output">
                                <field name="output" nolabel="1" readonly="1" widget="text" placeholder="Ejecuta la prueba para ver la respuesta."/>
                            </div>
                            <group col="2">
                                <field name="evaluation_note" string="Evaluación automática" readonly="1"/>
                                <field name="delivery_state" string="Entrega" widget="badge" readonly="1"/>
                                <field name="delivery_note" string="Detalle de entrega" readonly="1"/>
                            </group>
                            <separator string="Resultados operativos en Odoo"/>
                            <div class="alert alert-info" role="alert">
                                Las operaciones de esta sección son de prueba: crean registros nativos para que puedas revisarlos, pero no confirman ventas ni envían mensajes externos.
                            </div>
                            <group col="2">
                                <field name="test_quote_id" string="Cotización creada" readonly="1"/>
                                <field name="quote_count" string="Cotizaciones generadas" readonly="1"/>
                                <field name="test_chat_message_id" string="Mensaje en Chatroom" readonly="1"/>
                                <field name="test_activity_ids" string="Actividades creadas" readonly="1" widget="many2many_tags"/>
                                <field name="test_meeting_name" string="Reunión en Calendario" readonly="1"/>
                                <field name="test_meeting_link" string="Videollamada nativa" readonly="1" widget="url"/>
                                <field name="test_meeting_id" string="ID evento" readonly="1"/>
                            </group>
                            <separator string="Historial de cotizaciones"/>
                            <div class="alert alert-info" role="alert">
                                Cada solicitud nueva conserva su propio presupuesto nativo y PDF. Una ampliación mantiene el mismo presupuesto en borrador y agrega nuevas líneas.
                            </div>
                            <field name="quote_history_ids" nolabel="1" readonly="1">
                                <list string="Historial de cotizaciones" create="0" delete="0">
                                    <field name="created_at" string="Generada el"/>
                                    <field name="operation" string="Operación" widget="badge"/>
                                    <field name="sale_order_id" string="Presupuesto Odoo"/>
                                    <field name="sale_order_state" string="Estado" widget="badge"/>
                                    <field name="amount_total" string="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="attachment_id" string="PDF estándar"/>
                                    <field name="chat_message_id" string="Mensaje simulado" optional="hide"/>
                                    <field name="product_summary" string="Líneas" optional="hide"/>
                                </list>
                            </field>
                            <group string="Cerebro utilizado por esta prueba" col="2">
                                <field name="knowledge_sources" readonly="1"/>
                                <field name="knowledge_live_sources" readonly="1"/>
                                <field name="knowledge_context_chars" readonly="1"/>
                                <field name="knowledge_estimated_input_tokens" readonly="1"/>
                                <field name="knowledge_context" nolabel="1" readonly="1" widget="text"/>
                            </group>
                            <group string="Configuración de la actividad nativa" col="3">
                                <field name="test_activity_type_id"/>
                                <field name="test_activity_user_id"/>
                                <field name="test_activity_deadline"/>
                            </group>
                            <field name="test_attachment_ids" string="PDF adjunto" readonly="1" widget="many2many_binary"/>
                            <div class="o_chatroom_ai_sandbox_output">
                                <field name="operational_result" nolabel="1" readonly="1" widget="text" placeholder="Todavía no hay documentos ni actividades creados."/>
                            </div>
                        </page>
                        <page string="Diagnóstico">
                            <separator string="Último error"/>
                            <div class="o_chatroom_ai_sandbox_error">
                                <field name="error_message" nolabel="1" readonly="1" widget="text" placeholder="Sin errores registrados."/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
