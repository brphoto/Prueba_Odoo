<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_ai_provider_model_list" model="ir.ui.view">
        <field name="name">chatroom.ai.provider.model.list</field>
        <field name="model">chatroom.ai.provider.model</field>
        <field name="arch" type="xml">
            <list string="Modelos disponibles" decoration-success="recommended" decoration-muted="not active">
                <field name="recommended" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="provider" widget="badge"/>
                <field name="owned_by" optional="hide"/>
                <field name="supports_chat"/>
                <field name="last_synced"/>
                <field name="active"/><field name="health_state" widget="badge"/><field name="last_tested" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_chatroom_ai_provider_model_form" model="ir.ui.view">
        <field name="name">chatroom.ai.provider.model.form</field>
        <field name="model">chatroom.ai.provider.model</field>
        <field name="arch" type="xml">
                <form string="Modelo de IA">
                    <header><button name="action_test_connection" type="object" string="Probar disponibilidad" class="btn-primary" icon="fa-heartbeat"/></header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="model_id"/>
                            <field name="provider"/>
                            <field name="owned_by"/>
                        </group>
                        <group>
                            <field name="supports_chat"/>
                            <field name="recommended"/>
                            <field name="active"/>
                            <field name="last_synced" readonly="1"/>
                            <field name="health_state" widget="badge" readonly="1"/>
                            <field name="last_tested" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Los modelos se sincronizan desde el proveedor configurado. Chatroom solo muestra como compatibles los modelos de texto detectados.
                    </div>
                    <field name="health_message" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_chatroom_ai_usage_snapshot_list" model="ir.ui.view">
        <field name="name">chatroom.ai.usage.snapshot.list</field>
        <field name="model">chatroom.ai.usage.snapshot</field>
        <field name="arch" type="xml">
            <list string="Consumo de IA" decoration-danger="state == 'error'" decoration-warning="state == 'partial'">
                <field name="company_id" optional="hide"/>
                <field name="fetched_at"/>
                <field name="period_start" optional="hide"/>
                <field name="period_end" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="request_count"/>
                <field name="input_tokens" optional="hide"/>
                <field name="output_tokens" optional="hide"/>
                <field name="total_tokens"/>
                <field name="cost"/>
                <field name="currency"/>
                <field name="budget_remaining" optional="hide"/>
                <field name="budget_state" widget="badge" optional="hide"/>
                <field name="local_request_count" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_chatroom_ai_usage_snapshot_form" model="ir.ui.view">
        <field name="name">chatroom.ai.usage.snapshot.form</field>
        <field name="model">chatroom.ai.usage.snapshot</field>
        <field name="arch" type="xml">
            <form string="Resumen de consumo de IA">
                <header>
                    <button name="action_refresh_local_ui" type="object" string="Actualizar resumen local" class="btn-primary" icon="fa-refresh"/>
                    <button name="action_open_platform_usage" type="object" string="Abrir panel oficial" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'partial'">
                        Este resumen contiene consumo local. Configura una Admin API Key para consultar los costos oficiales de la organizacion.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'"><field name="error_message"/></div>
                    <group>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="fetched_at" readonly="1"/>
                            <field name="period_start" readonly="1"/>
                            <field name="period_end" readonly="1"/>
                            <field name="state" widget="badge" readonly="1"/>
                        </group>
                        <group>
                            <field name="request_count" readonly="1"/>
                            <field name="total_tokens" readonly="1"/>
                            <field name="cost" readonly="1"/>
                            <field name="currency" readonly="1"/>
                        </group>
                    </group>
                    <group string="Presupuesto de referencia">
                        <field name="budget_limit" readonly="1"/>
                        <field name="budget_remaining" readonly="1"/>
                        <field name="budget_percent" readonly="1"/>
                        <field name="budget_state" widget="badge" readonly="1"/>
                    </group>
                    <group string="Control local">
                        <field name="local_request_count" readonly="1"/>
                        <field name="local_total_tokens" readonly="1"/>
                    </group>
                    <group string="Solicitudes por modelo"><field name="model_breakdown" nolabel="1" readonly="1" widget="text"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_chatroom_ai_usage_snapshot_graph" model="ir.ui.view">
        <field name="name">chatroom.ai.usage.snapshot.graph</field>
        <field name="model">chatroom.ai.usage.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Consumo de IA por día" type="bar">
                <field name="fetched_at" interval="day" type="row"/>
                <field name="total_tokens" type="measure"/>
                <field name="request_count" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_chatroom_ai_usage_snapshot_pivot" model="ir.ui.view">
        <field name="name">chatroom.ai.usage.snapshot.pivot</field>
        <field name="model">chatroom.ai.usage.snapshot</field>
        <field name="arch" type="xml">
            <pivot string="Resumen de consumo">
                <field name="fetched_at" type="row" interval="day"/>
                <field name="state" type="col"/>
                <field name="request_count" type="measure"/>
                <field name="total_tokens" type="measure"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_chatroom_ai_usage_event_list" model="ir.ui.view">
        <field name="name">chatroom.ai.usage.event.list</field>
        <field name="model">chatroom.ai.usage.event</field>
        <field name="arch" type="xml"><list string="Solicitudes IA">
            <field name="company_id" optional="hide"/>
            <field name="request_date"/><field name="model"/><field name="task_type"/>
            <field name="channel_id" optional="hide"/><field name="input_tokens" optional="hide"/>
            <field name="output_tokens" optional="hide"/><field name="total_tokens"/><field name="success"/>
        </list></field>
    </record>
    <record id="view_chatroom_ai_usage_event_graph" model="ir.ui.view">
        <field name="name">chatroom.ai.usage.event.graph</field>
        <field name="model">chatroom.ai.usage.event</field>
        <field name="arch" type="xml"><graph string="Actividad de IA" type="bar">
            <field name="request_date" interval="day" type="row"/>
            <field name="total_tokens" type="measure"/>
        </graph></field>
    </record>
    <record id="view_chatroom_ai_quality_test_list" model="ir.ui.view">
        <field name="name">chatroom.ai.quality.test.list</field>
        <field name="model">chatroom.ai.quality.test</field>
        <field name="arch" type="xml"><list string="Pruebas de calidad" decoration-success="last_state == 'passed'" decoration-warning="last_state == 'warning'" decoration-danger="last_state == 'error'">
            <header><button name="action_run_selected" type="object" string="Ejecutar seleccionadas" class="btn-primary"/></header>
            <button name="action_run" type="object" icon="fa-play" title="Ejecutar"/>
            <field name="name"/><field name="task_type"/><field name="channel_id" optional="hide"/>
            <field name="last_run" optional="hide"/><field name="last_score"/><field name="last_state" widget="badge"/>
        </list></field>
    </record>
    <record id="view_chatroom_ai_quality_test_form" model="ir.ui.view">
        <field name="name">chatroom.ai.quality.test.form</field>
        <field name="model">chatroom.ai.quality.test</field>
        <field name="arch" type="xml"><form string="Prueba de calidad IA">
            <header><button name="action_run" type="object" string="Ejecutar prueba" class="oe_highlight"/><field name="last_state" widget="statusbar"/></header>
            <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
                <group><group><field name="channel_id"/><field name="task_type"/><field name="active"/></group>
                    <group><field name="expected_keywords"/><field name="last_run" readonly="1"/><field name="last_score" readonly="1"/></group></group>
                <field name="prompt" placeholder="Criterios que debe seguir la respuesta..."/>
                <group string="Ultima respuesta"><field name="last_output" readonly="1" nolabel="1" widget="text"/></group>
                <field name="result_ids" readonly="1"><list><field name="run_date"/><field name="score"/><field name="state" widget="badge"/></list></field>
            </sheet>
        </form></field>
    </record>
    <record id="view_chatroom_ai_quality_result_list" model="ir.ui.view">
        <field name="name">chatroom.ai.quality.result.list</field><field name="model">chatroom.ai.quality.result</field>
        <field name="arch" type="xml"><list string="Historial de calidad"><field name="run_date"/><field name="test_id"/><field name="score"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_chatroom_ai_sandbox_list" model="ir.ui.view">
        <field name="name">chatroom.ai.sandbox.list</field><field name="model">chatroom.ai.sandbox</field>
        <field name="arch" type="xml"><list string="Simulador IA" decoration-success="state == 'done'" decoration-danger="state == 'error'">
            <button name="action_run" type="object" icon="fa-play" title="Ejecutar sin enviar"/>
            <field name="name"/><field name="channel_id"/><field name="scenario"/><field name="task_type"/><field name="state" widget="badge"/><field name="evaluation_state" widget="badge"/>
            <field name="model_used" optional="hide"/><field name="write_date"/>
        </list></field>
    </record>
    <record id="view_chatroom_ai_sandbox_form" model="ir.ui.view">
        <field name="name">chatroom.ai.sandbox.form</field><field name="model">chatroom.ai.sandbox</field>
        <field name="arch" type="xml"><form string="Simulador seguro de IA">
            <header><button name="action_load_scenario" type="object" string="Cargar escenario" class="btn-secondary"/><button name="action_run" type="object" string="Probar IA (no enviar)" class="oe_highlight"/><button name="action_simulate_delivery" type="object" string="Simular entrega" class="btn-secondary" invisible="state != 'done'"/><field name="state" widget="statusbar"/></header>
            <sheet><div class="alert alert-info" role="alert">Esta prueba solo consulta el modelo. No aprueba ni envia mensajes al cliente.</div>
                <div class="oe_title"><h1><field name="name"/></h1></div>
                <group><group><field name="channel_id"/><field name="scenario"/><field name="task_type"/><field name="expected_keywords"/></group>
                    <group><field name="model_used" readonly="1"/><field name="input_tokens" readonly="1"/><field name="output_tokens" readonly="1"/></group></group>
                <group string="Instruccion"><field name="prompt" nolabel="1" placeholder="Ejemplo: responde con tono profesional y ofrece el siguiente paso..."/></group>
                <group string="Resultado"><field name="output" nolabel="1" readonly="1" widget="text"/><field name="evaluation_state" widget="badge"/><field name="evaluation_note" readonly="1" nolabel="1"/><field name="delivery_state" widget="badge"/><field name="delivery_note" readonly="1" nolabel="1"/></group>
                <group string="Error"><field name="error_message" nolabel="1" readonly="1"/></group>
            </sheet>
        </form></field>
    </record>
    <record id="action_chatroom_ai_provider_model" model="ir.actions.act_window">
        <field name="name">Modelos disponibles</field>
        <field name="res_model">chatroom.ai.provider.model</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_chatroom_ai_usage_snapshot" model="ir.actions.act_window">
        <field name="name">Consumo de IA</field>
        <field name="res_model">chatroom.ai.usage.snapshot</field>
        <field name="view_mode">graph,pivot,list,form</field>
    </record>
    <record id="action_chatroom_ai_usage_event" model="ir.actions.act_window">
        <field name="name">Solicitudes de IA</field><field name="res_model">chatroom.ai.usage.event</field>
        <field name="view_mode">graph,list</field>
    </record>
    <record id="action_chatroom_ai_quality_test" model="ir.actions.act_window">
        <field name="name">Pruebas de calidad</field><field name="res_model">chatroom.ai.quality.test</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_chatroom_ai_quality_result" model="ir.actions.act_window">
        <field name="name">Historial de calidad</field><field name="res_model">chatroom.ai.quality.result</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_chatroom_ai_sandbox" model="ir.actions.act_window">
        <field name="name">Simulador IA</field><field name="res_model">chatroom.ai.sandbox</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
