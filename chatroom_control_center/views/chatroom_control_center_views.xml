<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_control_center_form" model="ir.ui.view">
        <field name="name">chatroom.control.center.form</field>
        <field name="model">chatroom.control.center</field>
        <field name="arch" type="xml">
            <form string="Centro de control" create="false" edit="false" delete="false" class="o_chatroom_control_center">
                <header>
                    <button name="action_refresh" type="object" string="Actualizar" class="btn-secondary" icon="fa-refresh"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Centro de control</h1>
                        <p class="text-muted">Revisa las integraciones de Chatroom desde un solo lugar.</p>
                    </div>
                    <div class="alert alert-info" role="alert">
                        <field name="status_summary" nolabel="1" class="fw-bold"/>
                    </div>
                    <separator string="Actividad comercial"/>
                    <group col="4" class="o_chatroom_control_metrics">
                        <button name="action_open_opportunities" type="object" class="oe_stat_button" icon="fa-star">
                            <field name="opportunity_count" widget="statinfo" string="Oportunidades"/>
                        </button>
                        <button name="action_open_sales_orders" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="sales_order_count" widget="statinfo" string="Ventas"/>
                        </button>
                        <button name="action_open_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="purchase_order_count" widget="statinfo" string="Compras"/>
                        </button>
                        <button name="action_open_invoices" type="object" class="oe_stat_button" icon="fa-dollar">
                            <field name="invoice_count" widget="statinfo" string="Facturas"/>
                        </button>
                    </group>
                    <separator string="Indicadores operativos"/>
                    <group col="5" class="o_chatroom_control_metrics">
                        <button name="action_open_open_conversations" type="object" class="oe_stat_button" icon="fa-comments">
                            <field name="open_conversation_count" widget="statinfo" string="Conversaciones"/>
                        </button>
                        <button name="action_open_sla_conversations" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="sla_attention_count" widget="statinfo" string="SLA"/>
                        </button>
                        <button name="action_open_pending_payments" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <field name="pending_payment_count" widget="statinfo" string="Pagos pendientes"/>
                        </button>
                        <button name="action_open_rfm_rules" type="object" class="oe_stat_button" icon="fa-filter">
                            <field name="rfm_rule_count" widget="statinfo" string="Reglas RFM"/>
                        </button>
                        <button name="action_open_reactivation_customers" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="rfm_reactivation_count" widget="statinfo" string="Para reactivar"/>
                        </button>
                    </group>
                    <separator string="Equipo y permisos"/>
                    <group col="3" class="o_chatroom_control_metrics">
                        <field name="chatroom_agent_count"/>
                        <field name="chatroom_supervisor_count"/>
                        <field name="chatroom_manager_count"/>
                    </group>
                    <group col="2">
                        <group string="Canales y operación">
                            <field name="whatsapp_status" widget="badge"
                                   decoration-success="whatsapp_status == 'ready'"
                                   decoration-warning="whatsapp_status == 'attention'"
                                   decoration-muted="whatsapp_status == 'not_installed'"/>
                            <field name="calendar_status" widget="badge"
                                   decoration-success="calendar_status == 'ready'"
                                   decoration-muted="calendar_status == 'not_installed'"/>
                        </group>
                        <group string="Comercio y experiencia">
                            <field name="payment_status" widget="badge"
                                   decoration-success="payment_status == 'ready'"
                                   decoration-muted="payment_status == 'not_installed'"/>
                            <field name="payphone_status" widget="badge"
                                   decoration-success="payphone_status == 'ready'"
                                   decoration-warning="payphone_status == 'attention'"
                                   decoration-muted="payphone_status == 'not_installed'"/>
                            <field name="ui_status" widget="badge"
                                   decoration-success="ui_status == 'ready'"
                                   decoration-muted="ui_status == 'not_installed'"/>
                        </group>
                    </group>
                    <separator string="Accesos rápidos"/>
                    <div class="d-flex flex-wrap gap-2">
                        <button name="action_open_chatroom" type="object" string="Abrir Chatroom" class="btn-primary" icon="fa-comments"/>
                        <button name="action_open_settings" type="object" string="Ajustes generales" class="btn-secondary" icon="fa-sliders"/>
                        <button name="action_open_payments" type="object" string="Configurar PayPhone" class="btn-secondary" icon="fa-credit-card"/>
                        <button name="action_open_calendar" type="object" string="Abrir calendario" class="btn-secondary" icon="fa-calendar"/>
                        <button name="action_open_rfm_dashboard" type="object" string="Dashboard RFM" class="btn-secondary" icon="fa-line-chart"/>
                        <button name="action_open_users" type="object" string="Usuarios y roles" class="btn-secondary" icon="fa-users" groups="base.group_system"/>
                        <button name="action_open_groups" type="object" string="Grupos y permisos" class="btn-secondary" icon="fa-shield" groups="base.group_system"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chatroom_control_center" model="ir.actions.act_window">
        <field name="name">Centro de control</field>
        <field name="res_model">chatroom.control.center</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="action_server_chatroom_control_center" model="ir.actions.server">
        <field name="name">Abrir centro de control</field>
        <field name="model_id" ref="model_chatroom_control_center"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_center()</field>
    </record>

    <menuitem id="menu_chatroom_control_center" name="Centro de control"
              parent="chatroom_whatsapp.menu_chatroom_operation"
              action="action_server_chatroom_control_center" sequence="1"
              groups="chatroom_whatsapp.group_chatroom_manager"/>
</odoo>
