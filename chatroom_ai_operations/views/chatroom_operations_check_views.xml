<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_operations_check_list" model="ir.ui.view">
        <field name="name">chatroom.operations.check.list</field>
        <field name="model">chatroom.operations.check</field>
        <field name="arch" type="xml">
            <list string="Salud y preparación" default_order="sequence,category,id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="required"/>
                <field name="state" widget="badge" decoration-success="state == 'ok'" decoration-warning="state == 'warning'" decoration-danger="state == 'error'"/>
                <field name="detail" optional="show"/>
                <field name="checked_at"/>
            </list>
        </field>
    </record>
    <record id="view_chatroom_operations_check_form" model="ir.ui.view">
        <field name="name">chatroom.operations.check.form</field>
        <field name="model">chatroom.operations.check</field>
        <field name="arch" type="xml">
            <form string="Comprobación de preparación" class="chatroom_operations_check_form">
                <header>
                    <button name="action_check" type="object" string="Volver a comprobar" class="btn-primary" icon="fa-refresh"/>
                    <button name="action_run_all_ui" type="object" string="Comprobar todo" icon="fa-check-circle"/>
                    <field name="state" widget="statusbar" statusbar_visible="ok,warning,error"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1><field name="code" class="text-muted"/></div>
                    <div class="alert alert-info" role="alert">Esta pantalla verifica la preparación local. No envía WhatsApp, no modifica ventas y no consume tokens.</div>
                    <group col="2">
                        <group string="Clasificación"><field name="category"/><field name="company_id"/><field name="required"/><field name="active"/></group>
                        <group string="Resultado"><field name="state" widget="badge"/><field name="checked_at"/></group>
                    </group>
                    <notebook>
                        <page string="Detalle"><field name="detail" nolabel="1" class="chatroom_operations_readonly_text"/></page>
                        <page string="Qué hacer"><field name="recommendation" nolabel="1" class="chatroom_operations_readonly_text"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_chatroom_operations_check" model="ir.actions.act_window">
        <field name="name">Salud y preparación</field>
        <field name="res_model">chatroom.operations.check</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
