<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatroom_operations_playbook_run_list" model="ir.ui.view">
        <field name="name">chatroom.operations.playbook.run.list</field>
        <field name="model">chatroom.operations.playbook.run</field>
        <field name="arch" type="xml">
            <list string="Historial de playbooks" create="0" delete="0">
                <field name="execution_date" string="Ejecutada el"/>
                <field name="playbook_id" string="Playbook"/>
                <field name="execution_type" string="Origen" widget="badge"/>
                <field name="state" string="Estado" widget="badge"/>
                <field name="channels_processed" string="Procesados"/>
                <field name="notified_count" string="Avisos"/>
                <field name="sent_count" string="Enviados"/>
                <field name="blocked_count" string="Bloqueados" optional="hide"/>
                <field name="error_count" string="Errores" optional="hide"/>
                <field name="summary" string="Resumen"/>
            </list>
        </field>
    </record>

    <record id="view_chatroom_operations_playbook_run_form" model="ir.ui.view">
        <field name="name">chatroom.operations.playbook.run.form</field>
        <field name="model">chatroom.operations.playbook.run</field>
        <field name="arch" type="xml">
            <form string="Ejecución de playbook" create="0" edit="0" class="o_chatroom_operations_run_form">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-info" role="status">
                        Este registro es una auditoría de ejecución. No almacena secretos ni sustituye el historial de mensajes de Chatroom.
                    </div>
                    <group col="2">
                        <group string="Ejecución">
                            <field name="playbook_id"/>
                            <field name="execution_date"/>
                            <field name="execution_type" widget="badge"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group string="Resultado">
                            <field name="company_id"/>
                            <field name="channels_processed"/>
                            <field name="notified_count"/>
                            <field name="sent_count"/>
                            <field name="blocked_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <separator string="Resumen"/>
                    <field name="summary" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_chatroom_operations_playbook_run" model="ir.actions.act_window">
        <field name="name">Historial de playbooks</field>
        <field name="res_model">chatroom.operations.playbook.run</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
