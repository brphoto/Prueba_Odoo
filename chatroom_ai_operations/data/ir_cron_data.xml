<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_chatroom_operations_playbooks" model="ir.cron">
        <field name="name">Chatroom: ejecutar playbooks</field>
        <field name="model_id" ref="model_chatroom_operations_playbook"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_playbooks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_chatroom_operations_metrics" model="ir.cron">
        <field name="name">Chatroom: actualizar métricas comerciales</field>
        <field name="model_id" ref="model_chatroom_operations_metric"/>
        <field name="state">code</field>
        <field name="code">model._cron_collect_today()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
