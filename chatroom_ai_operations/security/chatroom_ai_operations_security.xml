<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_chatroom_operations" model="ir.module.category">
        <field name="name">Chatroom Operaciones</field>
        <field name="sequence">27</field>
    </record>
    <record id="privilege_chatroom_operations" model="res.groups.privilege">
        <field name="name">Chatroom Operaciones</field>
        <field name="category_id" ref="module_category_chatroom_operations"/>
    </record>
    <record id="group_chatroom_operations_user" model="res.groups">
        <field name="name">Usuario de operaciones Chatroom</field>
        <field name="privilege_id" ref="privilege_chatroom_operations"/>
    </record>
    <record id="group_chatroom_operations_manager" model="res.groups">
        <field name="name">Administrador de operaciones Chatroom</field>
        <field name="privilege_id" ref="privilege_chatroom_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_chatroom_operations_user'))]"/>
        <!-- Sin esto el administrador no ve el modulo recien instalado. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Aislamiento por empresa.

         Son reglas GLOBALES (sin `groups`) a proposito: Odoo une con OR
         las reglas de los grupos del usuario y aplica las globales con
         AND sobre el resultado. Puesta en un grupo, una regla por empresa
         se uniria con OR a las que ya existen -alguna con dominio
         `[('id', '!=', False)]`- y no aislaria nada.

         `company_id = False` significa "de todas las empresas" y por eso
         se deja pasar. -->
    <record id="chatroom_operations_metric_rule_company" model="ir.rule">
        <field name="name">Metricas de operacion: solo las de la empresa activa</field>
        <field name="model_id" ref="model_chatroom_operations_metric"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="chatroom_operations_playbook_run_rule_company" model="ir.rule">
        <field name="name">Ejecuciones de playbook: solo las de la empresa activa</field>
        <field name="model_id" ref="model_chatroom_operations_playbook_run"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
