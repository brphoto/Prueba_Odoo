<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_crm_customer_history" model="ir.module.category">
        <field name="name">Históricos comerciales</field>
        <field name="sequence">24</field>
    </record>

    <record id="privilege_crm_customer_history" model="res.groups.privilege">
        <field name="name">Históricos comerciales</field>
        <field name="category_id" ref="module_category_crm_customer_history"/>
    </record>

    <record id="group_crm_customer_history_user" model="res.groups">
        <field name="name">Agente de históricos</field>
        <field name="privilege_id" ref="privilege_crm_customer_history"/>
    </record>

    <record id="group_crm_customer_history_manager" model="res.groups">
        <field name="name">Administrador de históricos</field>
        <field name="privilege_id" ref="privilege_crm_customer_history"/>
        <field name="implied_ids" eval="[(4, ref('group_crm_customer_history_user'))]"/>
    </record>

    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_crm_customer_history_manager'))]"/>
    </record>

    <record id="crm_customer_history_rule_user_batch" model="ir.rule">
        <field name="name">Históricos: empresas del usuario</field>
        <field name="model_id" ref="model_crm_customer_history_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_crm_customer_history_user'))]"/>
    </record>
    <record id="crm_customer_history_rule_user_line" model="ir.rule">
        <field name="name">Detalle histórico: empresas del usuario</field>
        <field name="model_id" ref="model_crm_customer_history_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_crm_customer_history_user'))]"/>
    </record>

    <record id="crm_customer_history_rule_manager_batch" model="ir.rule">
        <field name="name">Históricos: administrador ve todas sus empresas</field>
        <field name="model_id" ref="model_crm_customer_history_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_crm_customer_history_manager'))]"/>
    </record>

    <record id="crm_customer_history_rule_manager_line" model="ir.rule">
        <field name="name">Detalle histórico: administrador ve todas sus empresas</field>
        <field name="model_id" ref="model_crm_customer_history_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_crm_customer_history_manager'))]"/>
    </record>
</odoo>
