<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_customer_history" model="ir.ui.view">
        <field name="name">res.partner.form.customer.history</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="crm_customer_intelligence.view_partner_form_sales_intelligence"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='commercial_intelligence']/group[1]/group[2]" position="after">
                <group string="Histórico cargado">
                    <field name="history_total_amount"/>
                    <field name="history_average_ticket"/>
                    <field name="history_invoice_count"/>
                    <field name="history_last_purchase_date"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='commercial_intelligence']/group[1]" position="after">
                <group string="Clasificación manual">
                    <group>
                        <field name="history_manual_category_id"/>
                        <field name="history_category_source"/>
                        <field name="history_manual_category_date"/>
                        <field name="history_manual_category_changed_by"/>
                        <field name="history_manual_category_previous"/>
                    </group>
                    <field name="history_manual_category_reason" placeholder="Por qué se fijó manualmente esta categoría..."/>
                </group>
            </xpath>
            <xpath expr="//page[@name='commercial_intelligence']" position="inside">
                <button name="action_open_history_lines" type="object" string="Ver detalle del histórico"
                        class="btn-secondary" invisible="not history_invoice_count"/>
            </xpath>
        </field>
    </record>
</odoo>
