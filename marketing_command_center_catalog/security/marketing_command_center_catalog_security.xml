<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_marketing_catalog" model="ir.module.category">
        <field name="name">Catálogo externo</field>
        <field name="sequence">36</field>
    </record>
    <record id="privilege_marketing_catalog" model="res.groups.privilege">
        <field name="name">Catálogo externo</field>
        <field name="category_id" ref="module_category_marketing_catalog"/>
    </record>
    <record id="group_catalog_user" model="res.groups">
        <field name="name">Usuario de catálogo externo</field>
        <field name="privilege_id" ref="privilege_marketing_catalog"/>
    </record>
    <record id="group_catalog_manager" model="res.groups">
        <field name="name">Administrador de catálogo externo</field>
        <field name="privilege_id" ref="privilege_marketing_catalog"/>
        <field name="implied_ids" eval="[(4, ref('group_catalog_user'))]"/>
        <!-- Sin esto el administrador no ve el modulo recien instalado. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="catalog_connection_company_rule" model="ir.rule">
        <field name="name">Catálogo: conexiones por compañía</field>
        <field name="model_id" ref="model_marketing_catalog_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_catalog_user'))]"/>
    </record>
    <record id="catalog_listing_company_rule" model="ir.rule">
        <field name="name">Catálogo: vehículos por compañía</field>
        <field name="model_id" ref="model_marketing_vehicle_listing"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_catalog_user'))]"/>
    </record>
</odoo>
