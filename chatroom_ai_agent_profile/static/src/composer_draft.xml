<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="chatroom_whatsapp.ChatroomThreadCore" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_chatroom_quick_buttons_panel')]" position="before">
            <div t-if="aiDraftInComposer" class="o_ai_composer_draft">
                <i class="fa fa-magic me-1"/>
                <span class="o_ai_composer_draft_label">
                    <t t-if="aiDraftEdited">Editaste la propuesta de la IA: al enviarla, aprende tu versión.</t>
                    <t t-else="">La IA dejó escrita una respuesta. Revísala y pulsa Enter para enviarla.</t>
                </span>
                <span t-if="state.aiDraft.reason" class="o_ai_composer_draft_reason text-muted"
                      t-att-title="state.aiDraft.reason">
                    <i class="fa fa-info-circle"/>
                </span>
                <button t-if="aiDraftEdited" class="btn btn-link btn-sm o_ai_composer_draft_restore"
                        t-on-click="useAiDraft">Volver a la propuesta</button>
                <button class="btn btn-link btn-sm text-danger o_ai_composer_draft_discard"
                        t-on-click="discardAiDraft">Descartar</button>
            </div>
        </xpath>
    </t>
</templates>
