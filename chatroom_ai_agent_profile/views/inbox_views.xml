<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bandeja «Para aprobar»: todos los borradores de la IA en una lista. -->
    <record id="view_ai_inbox_list" model="ir.ui.view">
        <field name="name">chatroom.ai.suggestion.inbox.list</field>
        <field name="model">chatroom.ai.suggestion</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Para aprobar" create="0" editable="bottom" class="o_ai_inbox"
                  decoration-danger="waiting_minutes &gt; 30" decoration-warning="waiting_minutes &gt; 10">
                <field name="create_date" string="Desde" widget="remaining_days" optional="hide"/>
                <field name="waiting_minutes" string="Espera (min)" readonly="1"/>
                <field name="partner_id" string="Cliente" readonly="1"/>
                <field name="customer_question" string="El cliente escribió" readonly="1"/>
                <field name="suggested_text" string="Respuesta de la IA (puedes editarla)"/>
                <field name="safety_reason" string="Por qué espera" readonly="1" optional="show"/>
                <field name="assigned_user_id" string="Responsable" readonly="1" optional="show"
                       widget="many2one_avatar_user"/>
                <field name="state" column_invisible="1"/>
                <button name="action_approve_and_send" type="object" string="Aprobar y enviar"
                        icon="fa-paper-plane" class="btn-primary"/>
                <button name="action_open_chat" type="object" string="Abrir chat" icon="fa-comments"/>
                <button name="action_discard" type="object" string="Descartar" icon="fa-times"/>
            </list>
        </field>
    </record>

    <record id="view_ai_inbox_search" model="ir.ui.view">
        <field name="name">chatroom.ai.suggestion.inbox.search</field>
        <field name="model">chatroom.ai.suggestion</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" string="Cliente"/>
                <field name="suggested_text"/>
                <filter name="mine" string="Mis conversaciones" domain="[('channel_id.assigned_user_id', '=', uid)]"/>
                <filter name="unassigned" string="Sin responsable" domain="[('channel_id.assigned_user_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_ai_inbox" model="ir.actions.act_window">
        <field name="name">Para aprobar</field>
        <field name="res_model">chatroom.ai.suggestion</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state', 'in', ('draft', 'approved')), ('quick_action_id', '=', False)]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_ai_inbox_list')})]"/>
        <field name="search_view_id" ref="view_ai_inbox_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nada por aprobar</p>
            <p>Aquí aparecen las respuestas que la IA preparó y esperan a una persona. Revisa, edita si hace
               falta y pulsa «Aprobar y enviar». Si editas el texto, la IA aprende la corrección.</p>
        </field>
    </record>

    <!-- Puesta en marcha -->
    <record id="view_agent_setup_form" model="ir.ui.view">
        <field name="name">chatroom.ai.agent.setup.form</field>
        <field name="model">chatroom.ai.agent.setup</field>
        <field name="arch" type="xml">
            <form string="Puesta en marcha del agente">
                <header>
                    <field name="step" widget="statusbar"/>
                </header>
                <field name="profile_id" invisible="1"/>
                <div invisible="step != 'company'">
                    <p class="text-muted">Con esto el agente se presenta y entiende qué ofrece la empresa.</p>
                    <group>
                        <field name="company_name"/>
                        <field name="agent_name" placeholder="Ej.: Sofía"/>
                        <field name="business_template"/>
                        <field name="tone" widget="radio" options="{'horizontal': true}"/>
                        <field name="business_description"
                               placeholder="Ej.: Somos una tienda de ... en ...; vendemos ...; atendemos a ...; enviamos a ..."/>
                    </group>
                </div>
                <div invisible="step != 'knowledge'">
                    <p class="text-muted">
                        Todo lo que el agente puede responder: horarios, precios, envíos, pagos, políticas,
                        preguntas frecuentes. Los productos y precios de Odoo ya los consulta solo.
                        Información publicada hasta ahora: <field name="knowledge_count" readonly="1" class="fw-bold"/>.
                    </p>
                    <group>
                        <field name="knowledge_text" placeholder="Horario: lunes a viernes de 9:00 a 18:00.&#10;&#10;Envíos: ..."/>
                        <field name="knowledge_file" filename="knowledge_filename"/>
                        <field name="knowledge_filename" invisible="1"/>
                    </group>
                </div>
                <div invisible="step != 'playbooks'">
                    <p class="text-muted">Qué datos pide el agente antes de pasar el caso al equipo. Se editan luego en el perfil.</p>
                    <div invisible="not business_template">
                        <p>Guiones de la plantilla (con botones para elegir):</p>
                        <field name="template_playbooks" nolabel="1" readonly="1" class="text-break"/>
                    </div>
                    <group invisible="business_template">
                        <field name="use_quote"/>
                        <field name="quote_action" widget="radio" invisible="not use_quote"/>
                        <field name="use_support"/>
                    </group>
                </div>
                <div invisible="step != 'launch'">
                    <field name="readiness_html" nolabel="1"/>
                    <p class="text-muted mt-2">
                        Prueba el agente como si fueras un cliente. Cuando te guste, actívalo: responderá solo lo que
                        está en tu información y dejará lo demás para aprobar.
                    </p>
                    <group>
                        <field name="autonomy_mode" widget="radio"/>
                    </group>
                    <field name="auto_reply_on" invisible="1"/>
                </div>
                <footer>
                    <button name="action_back" type="object" string="Atrás" invisible="step == 'company'"/>
                    <button name="action_next" type="object" string="Siguiente" class="btn-primary"
                            invisible="step == 'launch'"/>
                    <button name="action_test" type="object" string="Probar agente" icon="fa-comments"
                            invisible="step != 'launch'"/>
                    <button name="action_activate" type="object" string="Activar respuesta automática"
                            class="btn-primary" icon="fa-bolt" invisible="step != 'launch' or auto_reply_on"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_agent_setup" model="ir.actions.act_window">
        <field name="name">Puesta en marcha del agente</field>
        <field name="res_model">chatroom.ai.agent.setup</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
