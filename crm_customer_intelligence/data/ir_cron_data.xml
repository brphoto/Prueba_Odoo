<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_compute_rfm_scores" model="ir.cron">
        <field name="name">Chatroom: recalcular clasificación RFM de clientes</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_compute_rfm_scores()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_notify_stagnant_leads" model="ir.cron">
        <field name="name">CRM: avisar al vendedor de oportunidades estancadas (rojo)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_stagnant_leads()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_snapshot_crm_kpis" model="ir.cron">
        <field name="name">Inteligencia comercial: guardar históricos de KPIs</field>
        <field name="model_id" ref="model_crm_kpi_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_compute_snapshots()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_notify_crm_kpis" model="ir.cron">
        <field name="name">Inteligencia comercial: alertar KPIs fuera de objetivo</field>
        <field name="model_id" ref="model_crm_kpi_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_red_kpis()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_apply_rfm_segment_actions" model="ir.cron">
        <field name="name">Inteligencia comercial: automatizaciones de segmentos</field>
        <field name="model_id" ref="model_crm_rfm_segment"/>
        <field name="state">code</field>
        <field name="code">model._cron_apply_segment_actions()</field>
        <field name="interval_number">1</field><field name="interval_type">days</field><field name="active">True</field>
    </record>
    <record id="ir_cron_generate_management_alerts" model="ir.cron">
        <field name="name">Inteligencia comercial: generar alertas gerenciales</field>
        <field name="model_id" ref="model_crm_management_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_alerts()</field>
        <field name="interval_number">1</field><field name="interval_type">hours</field><field name="active">True</field>
    </record>
    <record id="ir_cron_rfm_reactivation" model="ir.cron">
        <field name="name">Inteligencia comercial: oportunidades de reactivación RFM</field>
        <field name="model_id" ref="model_rfm_reactivation_rule"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_reactivation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_snapshot_rfm" model="ir.cron">
        <field name="name">Inteligencia comercial: foto mensual de clasificación RFM</field>
        <field name="model_id" ref="model_crm_rfm_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_snapshot_rfm()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active">True</field>
    </record>
</odoo>
