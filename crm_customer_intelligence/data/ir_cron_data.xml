<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_compute_rfm_scores" model="ir.cron">
        <field name="name">Chatroom: recalcular clasificación RFM de clientes</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_compute_rfm_scores()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_notify_stagnant_leads" model="ir.cron">
        <field name="name">CRM: avisar al vendedor de oportunidades estancadas (rojo)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_stagnant_leads()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
