<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_sales_intelligence" model="ir.ui.view">
        <field name="name">res.partner.form.chatroom.sales.intelligence</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_top_products" type="object"
                        class="oe_stat_button" icon="fa-trophy"
                        invisible="not commercial_invoice_count">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Top Productos</span>
                    </div>
                </button>
            </div>
            <notebook position="inside">
                <page name="commercial_intelligence" string="Inteligencia Comercial">
                    <group>
                        <group string="Clasificación RFM / ABC">
                            <field name="rfm_category" widget="badge"
                                   decoration-success="rfm_category == 'a'"
                                   decoration-warning="rfm_category == 'b'"
                                   decoration-muted="rfm_category in ('c', 'none')"/>
                            <field name="rfm_score"/>
                        </group>
                        <group string="Cómo se calculó">
                            <field name="rfm_recency_days"/>
                            <field name="rfm_frequency"/>
                            <field name="rfm_monetary_value"/>
                            <field name="rfm_last_purchase_date"/>
                            <field name="rfm_last_computed_at"/>
                        </group>
                        <group string="Histórico de ventas">
                            <field name="commercial_total_sales"/>
                            <field name="commercial_avg_ticket"/>
                            <field name="commercial_invoice_count"/>
                            <field name="commercial_last_sale_date"/>
                        </group>
                    </group>
                    <group string="Explicación de la clasificación"
                           invisible="not rfm_explanation">
                        <field name="rfm_explanation" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Análisis Pareto (80/20)" invisible="not commercial_top_product_summary">
                        <field name="commercial_top_product_summary" nolabel="1" readonly="1"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_res_partner_filter_rfm" model="ir.ui.view">
        <field name="name">res.partner.select.rfm</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="salesperson" position="after">
                <filter name="group_rfm_category" string="Categoría RFM"
                        context="{'group_by': 'rfm_category'}"/>
            </filter>
            <filter name="type_company" position="after">
                <separator/>
                <filter name="rfm_category_a" string="RFM: Categoría A"
                        domain="[('rfm_category', '=', 'a')]"/>
                <filter name="rfm_category_b" string="RFM: Categoría B"
                        domain="[('rfm_category', '=', 'b')]"/>
                <filter name="rfm_category_c" string="RFM: Categoría C"
                        domain="[('rfm_category', '=', 'c')]"/>
            </filter>
        </field>
    </record>

    <record id="action_create_rfm_marketing_list" model="ir.actions.server">
        <field name="name">Crear lista de marketing (RFM)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_create_rfm_marketing_list()</field>
    </record>

    <record id="action_schedule_rfm_followup" model="ir.actions.server">
        <field name="name">Programar seguimiento RFM</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_schedule_rfm_followup()</field>
    </record>

    <record id="action_customer_intelligence_dashboard" model="ir.actions.client">
        <field name="name">Dashboard de Inteligencia Comercial</field>
        <field name="tag">crm_customer_intelligence.rfm_dashboard</field>
    </record>

    <menuitem id="menu_customer_intelligence_dashboard"
              name="Dashboard"
              parent="menu_crm_intelligence_root"
              action="action_customer_intelligence_dashboard"
              sequence="10"/>

    <record id="view_res_partner_kanban_rfm_category" model="ir.ui.view">
        <field name="name">res.partner.kanban.rfm.category</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="rfm_category" records_draggable="0">
                <field name="name"/>
                <field name="rfm_category"/>
                <field name="rfm_score"/>
                <field name="commercial_total_sales"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="image_128" widget="image" class="o_kanban_image rounded-circle me-2"
                                   options="{'size': [32, 32]}" alt="Avatar"/>
                            <div>
                                <strong><field name="name"/></strong>
                                <div class="text-muted small">
                                    Score <field name="rfm_score"/> ·
                                    <field name="commercial_total_sales" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_res_partner_by_rfm_category" model="ir.actions.act_window">
        <field name="name">Clientes por Categoría RFM</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('rfm_category', '!=', 'none')]</field>
        <field name="search_view_id" ref="view_res_partner_filter_rfm"/>
        <field name="context">{'search_default_group_rfm_category': 1}</field>
        <field name="view_ids" eval="[
            Command.clear(),
            Command.create({'view_mode': 'kanban', 'view_id': ref('view_res_partner_kanban_rfm_category')}),
            Command.create({'view_mode': 'list', 'view_id': False}),
            Command.create({'view_mode': 'form', 'view_id': False}),
        ]"/>
    </record>
    <menuitem id="menu_res_partner_by_rfm_category" name="Clientes por Categoría"
              parent="menu_crm_intelligence_root" action="action_res_partner_by_rfm_category" sequence="15"/>

</odoo>
