<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_kpi_definition_list" model="ir.ui.view">
        <field name="name">crm.kpi.definition.list</field>
        <field name="model">crm.kpi.definition</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_name"/>
                <field name="aggregation"/>
                <field name="measure_field"/>
                <field name="date_field"/>
                <field name="format_type"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_crm_kpi_definition_form" model="ir.ui.view">
        <field name="name">crm.kpi.definition.form</field>
        <field name="model">crm.kpi.definition</field>
        <field name="arch" type="xml">
            <form string="KPI configurable" class="o_crm_kpi_definition_form">
                <header>
                    <button name="action_test_kpi" type="object" string="Probar KPI" class="btn-primary"/>
                    <button name="action_view_snapshots" type="object" string="Ver histórico" class="btn-secondary"/>
                    <field name="active" widget="boolean_button"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Conversión de oportunidades"/></h1></div>
                    <group>
                        <group string="Qué medir">
                            <field name="model_name"/>
                            <field name="aggregation"/>
                            <field name="measure_field" invisible="aggregation == 'count'"/>
                            <field name="format_type"/>
                        </group>
                        <group string="Período y segmento">
                            <field name="date_field"/>
                            <field name="rfm_category" invisible="model_name != 'res.partner'"/>
                            <field name="target_value"/>
                            <field name="goal_direction"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Filtros adicionales">
                        <field name="domain_filter" placeholder="[('state', '=', 'sale')]" nolabel="1"/>
                        <div class="text-muted">Ejemplo: [('state', '=', 'sale')] para pedidos confirmados.</div>
                    </group>
                    <group string="KPI avanzado">
                        <field name="formula" placeholder="value * 100 / 500"/>
                        <field name="compare_previous"/>
                        <div class="text-muted">La fórmula recibe value y record_count. Ejemplo: value / record_count para un promedio personalizado.</div>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_crm_kpi_definition" model="ir.actions.act_window">
        <field name="name">KPIs configurables</field>
        <field name="res_model">crm.kpi.definition</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_crm_kpi_definition" name="KPIs configurables"
              parent="menu_crm_intelligence_config" action="action_crm_kpi_definition" sequence="10"/>
</odoo>
