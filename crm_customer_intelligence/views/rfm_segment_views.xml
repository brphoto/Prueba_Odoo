<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_rfm_segment_list" model="ir.ui.view">
        <field name="name">crm.rfm.segment.list</field>
        <field name="model">crm.rfm.segment</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/><field name="name"/>
                <field name="category"/><field name="score_min"/><field name="score_max"/>
                <field name="max_days_since_sale"/><field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_crm_rfm_segment_form" model="ir.ui.view">
        <field name="name">crm.rfm.segment.form</field>
        <field name="model">crm.rfm.segment</field>
        <field name="arch" type="xml">
            <form string="Segmento RFM"><header>
                <button name="action_open_contacts" type="object" string="Ver contactos" class="btn-primary"/>
                <field name="active" widget="boolean_button"/>
            </header><sheet><div class="oe_title"><h1><field name="name"/></h1></div>
                    <group><group><field name="category_id"/><field name="category"/><field name="description"/></group>
                    <group><field name="score_min"/><field name="score_max"/><field name="max_days_since_sale"/><field name="sequence"/></group>
                </group>
            </sheet></form>
        </field>
    </record>
    <record id="action_crm_rfm_segment" model="ir.actions.act_window">
        <field name="name">Segmentos RFM</field><field name="res_model">crm.rfm.segment</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_crm_rfm_segment" name="Segmentos RFM"
              parent="menu_crm_intelligence_config" action="action_crm_rfm_segment" sequence="30"/>
</odoo>
