<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Limpia de forma reversible el menú huérfano de una instalación
         antigua que ya no está disponible en addons. La solución actual
         vive en esta aplicación y no debe mostrar dos RFM distintos. -->
    <record id="novocentro_rfm_analysis.rfm_menu_root" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <menuitem id="menu_crm_intelligence_root" name="Inteligencia Comercial"
              sequence="25"
              web_icon="crm_customer_intelligence,static/description/icon.png"/>
    <menuitem id="menu_crm_intelligence_reports" name="Reportes"
              parent="menu_crm_intelligence_root" sequence="20"/>
    <menuitem id="menu_crm_intelligence_clients" name="Clientes"
              parent="menu_crm_intelligence_root"
              action="base.action_partner_form" sequence="14"/>
    <menuitem id="menu_crm_intelligence_config" name="Configuración"
              parent="menu_crm_intelligence_root" sequence="30"
              groups="crm_customer_intelligence.group_crm_intelligence_manager,base.group_system"/>
</odoo>
