<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_order_filter_rfm_category" model="ir.ui.view">
        <field name="name">sale.order.search.rfm.category</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="customer" position="after">
                <filter name="rfm_category" string="Categoría RFM" context="{'group_by': 'rfm_category'}"/>
            </filter>
        </field>
    </record>

    <record id="view_crm_case_opportunities_filter_rfm_category" model="ir.ui.view">
        <field name="name">crm.lead.search.opportunity.rfm.category</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <filter name="salesperson" position="after">
                <filter name="rfm_category" string="Categoría RFM" context="{'group_by': 'rfm_category'}"/>
            </filter>
        </field>
    </record>

</odoo>
