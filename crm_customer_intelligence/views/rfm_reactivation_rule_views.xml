<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rfm_reactivation_rule_list" model="ir.ui.view">
        <field name="name">rfm.reactivation.rule.list</field>
        <field name="model">rfm.reactivation.rule</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="name"/>
                <field name="category_code"/><field name="days_allowed"/>
                <field name="user_id"/><field name="active" widget="boolean_toggle"/></list>
        </field>
    </record>
    <record id="view_rfm_reactivation_rule_form" model="ir.ui.view">
        <field name="name">rfm.reactivation.rule.form</field>
        <field name="model">rfm.reactivation.rule</field>
        <field name="arch" type="xml">
            <form string="Regla de reactivación RFM"><sheet>
                <group><field name="name"/><field name="active"/><field name="sequence"/></group>
                <group string="Condición"><field name="category_code"/><field name="days_allowed"/></group>
                <group string="Nueva oportunidad"><field name="user_id"/><field name="team_id"/>
                    <field name="lead_description"/></group>
            </sheet></form>
        </field>
    </record>
    <record id="action_rfm_reactivation_rule" model="ir.actions.act_window">
        <field name="name">Reglas de reactivación RFM</field>
        <field name="res_model">rfm.reactivation.rule</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_rfm_reactivation_rule" name="Reactivación RFM"
              parent="menu_crm_intelligence_config" action="action_rfm_reactivation_rule" sequence="35"/>
</odoo>
