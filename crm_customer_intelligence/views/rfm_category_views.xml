<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_crm_rfm_catalog" model="ir.actions.act_window">
        <field name="name">Catálogo RFM</field>
        <field name="res_model">crm.rfm.segment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="crm_customer_intelligence.view_crm_rfm_segment_list"/>
        <field name="search_view_id" ref="crm_customer_intelligence.view_crm_rfm_catalog_search"/>
    </record>
    <menuitem id="menu_crm_rfm_catalog" name="Catálogo RFM"
              parent="menu_crm_intelligence_config" action="action_crm_rfm_catalog" sequence="30"/>

    <!-- Compatibility records: the unified catalog replaces both menus. -->
    <record id="action_crm_rfm_category" model="ir.actions.act_window">
        <field name="name">Categorias RFM</field>
        <field name="res_model">crm.rfm.segment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('definition_type', '=', 'category')]</field>
    </record>
    <menuitem id="menu_crm_rfm_category" name="Categorias RFM"
              parent="menu_crm_intelligence_config" action="action_crm_rfm_category"
              sequence="31" active="False"/>
</odoo>
