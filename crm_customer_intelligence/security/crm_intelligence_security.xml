<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_crm_intelligence" model="ir.module.category">
        <field name="name">Inteligencia comercial</field>
        <field name="sequence">22</field>
    </record>

    <record id="privilege_crm_intelligence" model="res.groups.privilege">
        <field name="name">Inteligencia comercial</field>
        <field name="category_id" ref="module_category_crm_intelligence"/>
    </record>

    <record id="group_crm_intelligence_user" model="res.groups">
        <field name="name">Analista comercial</field>
        <field name="privilege_id" ref="privilege_crm_intelligence"/>
    </record>

    <record id="group_crm_intelligence_manager" model="res.groups">
        <field name="name">Administrador de inteligencia</field>
        <field name="privilege_id" ref="privilege_crm_intelligence"/>
        <field name="implied_ids" eval="[(4, ref('group_crm_intelligence_user'))]"/>
        <!-- Sin esto el administrador no ve el modulo recien instalado. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="crm_management_alert_rule_user" model="ir.rule">
        <field name="name">Alertas comerciales: propias y sin responsable</field>
        <field name="model_id" ref="model_crm_management_alert"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="crm_management_alert_rule_manager" model="ir.rule">
        <field name="name">Alertas comerciales: gerente ve todas</field>
        <field name="model_id" ref="model_crm_management_alert"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('base.group_system'))]"/>
    </record>

    <!-- Aislamiento por empresa.

         Son reglas GLOBALES (sin `groups`) a proposito: Odoo une con OR
         las reglas de los grupos del usuario y aplica las globales con
         AND sobre el resultado. Puesta en un grupo, una regla por empresa
         se uniria con OR a las que ya existen -alguna con dominio
         `[('id', '!=', False)]`- y no aislaria nada.

         `company_id = False` significa "de todas las empresas" y por eso
         se deja pasar. -->
    <record id="crm_kpi_snapshot_rule_company" model="ir.rule">
        <field name="name">Indicadores comerciales: solo las de la empresa activa</field>
        <field name="model_id" ref="model_crm_kpi_snapshot"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="crm_rfm_snapshot_rule_company" model="ir.rule">
        <field name="name">Resumenes RFM: solo las de la empresa activa</field>
        <field name="model_id" ref="model_crm_rfm_snapshot"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
